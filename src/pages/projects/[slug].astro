---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projectCases, type ProjectCase } from '../../data/projectCases';

export const prerender = true;

export function getStaticPaths() {
	return projectCases.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: ProjectCase;
}

const { project } = Astro.props;
const related = projectCases.filter((item) => item.slug !== project.slug).slice(0, 3);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const absoluteImage = new URL(project.image, pageUrl).toString();

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			name: project.metaTitle,
			description: project.metaDescription,
			url: pageUrl,
			image: absoluteImage,
			inLanguage: 'ru-RU',
			isPartOf: {
				'@type': 'WebSite',
				name: 'Bridge Consult',
				url: 'https://www.bridgeconsult.uz/',
			},
			mainEntity: {
				'@id': `${pageUrl}#case`,
			},
		},
		{
			'@type': 'CreativeWork',
			'@id': `${pageUrl}#case`,
			name: project.title,
			description: project.summary,
			about: [project.category, project.contract, project.institution],
			image: absoluteImage,
			provider: {
				'@type': 'ProfessionalService',
				name: 'Bridge Consult',
				url: 'https://www.bridgeconsult.uz/',
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Главная',
					item: 'https://www.bridgeconsult.uz/',
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Проекты',
					item: 'https://www.bridgeconsult.uz/projects.html',
				},
				{
					'@type': 'ListItem',
					position: 3,
					name: project.title,
					item: pageUrl,
				},
			],
		},
	],
};
---

<Layout title={project.metaTitle} description={project.metaDescription} image={project.image} lang="ru">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	</Fragment>

	<SiteHeader active="projects" lang="ru" langUrls={{ ru: '/projects.html', en: '/EN/projects.html', uz: '/UZ/projects.html' }} />

	<main class="bg-bridge-light font-sans text-bridge-dark">
		<section class="relative min-h-[92svh] overflow-hidden bg-bridge-dark text-white">
			<div class="absolute inset-0">
				<img src={project.image} alt={project.title} class="h-full w-full object-cover opacity-45" />
				<div class="absolute inset-0 bg-gradient-to-b from-bridge-dark/90 via-bridge-dark/72 to-bridge-dark"></div>
			</div>

			<div class="relative z-10 mx-auto flex min-h-[92svh] max-w-7xl flex-col justify-end px-6 pb-14 pt-32 md:pb-20">
				<a href="/projects.html" class="mb-8 inline-flex w-max items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-bridge-taupe transition-colors hover:text-white">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path></svg>
					Все проекты
				</a>

				<div class="max-w-5xl">
					<div class="mb-5 flex flex-wrap items-center gap-3 text-[10px] font-bold uppercase tracking-[0.22em] text-white/70">
						<span class="border border-white/20 bg-white/10 px-3 py-2 backdrop-blur">{project.number}</span>
						<span class="border border-white/20 bg-white/10 px-3 py-2 backdrop-blur">{project.category}</span>
						<span class="border border-bridge-taupe/50 bg-bridge-taupe/25 px-3 py-2 text-bridge-taupe backdrop-blur">{project.contract}</span>
					</div>
					<h1 class="max-w-4xl text-4xl font-bold leading-[1.04] tracking-tight md:text-6xl lg:text-7xl">
						{project.title}
					</h1>
					<p class="mt-6 max-w-3xl text-lg font-light leading-relaxed text-white/72 md:text-xl">
						{project.summary}
					</p>
					<div class="mt-9 flex flex-col gap-3 sm:flex-row">
						<a href="/index.html#contact-form" class="inline-flex items-center justify-center gap-3 bg-bridge-taupe px-7 py-4 text-xs font-bold uppercase tracking-widest text-white transition-transform duration-200 hover:-translate-y-0.5 hover:bg-[#9c8d76]">
							Обсудить похожий проект
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
						</a>
						<a href="/projects.html#reference-list" class="inline-flex items-center justify-center gap-3 border border-white/25 px-7 py-4 text-xs font-bold uppercase tracking-widest text-white transition-colors duration-200 hover:border-bridge-taupe hover:bg-white/10">
							Референс-лист
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="border-y border-gray-200 bg-white">
			<div class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-gray-200 px-0 md:grid-cols-4">
				<div class="bg-white px-6 py-7">
					<span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Период</span>
					<strong class="mt-2 block text-xl text-bridge-dark">{project.period}</strong>
				</div>
				<div class="bg-white px-6 py-7">
					<span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Модель</span>
					<strong class="mt-2 block text-xl text-bridge-dark">{project.contract}</strong>
				</div>
				<div class="bg-white px-6 py-7">
					<span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Заказчик</span>
					<strong class="mt-2 block text-base leading-snug text-bridge-dark">{project.client}</strong>
				</div>
				<div class="bg-white px-6 py-7">
					<span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">Институт</span>
					<strong class="mt-2 block text-base leading-snug text-bridge-dark">{project.institution}</strong>
				</div>
			</div>
		</section>

		<section class="relative overflow-hidden py-16 md:py-24">
			<div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-16">
				<article class="max-w-3xl">
					<div class="mb-12">
						<span class="mb-4 block text-xs font-bold uppercase tracking-[0.22em] text-bridge-taupe">Контекст</span>
						<h2 class="text-3xl font-bold leading-tight md:text-5xl">Почему этот проект важен</h2>
						<p class="mt-6 text-lg font-light leading-9 text-gray-600">{project.context}</p>
					</div>

					<div class="mb-12">
						<h2 class="mb-6 text-2xl font-bold">Ключевые параметры</h2>
						<ul class="space-y-4">
							{project.scope.map((item) => (
								<li class="flex gap-4 border-b border-gray-200 pb-4 text-gray-600">
									<span class="mt-2 h-2 w-2 shrink-0 bg-bridge-taupe"></span>
									<span class="font-light leading-7">{item}</span>
								</li>
							))}
						</ul>
					</div>

					<div>
						<h2 class="mb-6 text-2xl font-bold">Фокус экспертизы Bridge Consult</h2>
						<ul class="grid gap-4 md:grid-cols-3">
							{project.focus.map((item) => (
								<li class="border border-gray-200 bg-white p-5 text-sm font-light leading-7 text-gray-600 shadow-sm">
									{item}
								</li>
							))}
						</ul>
					</div>
				</article>

				<aside class="lg:sticky lg:top-28 lg:self-start">
					<div class="border border-gray-200 bg-white p-6 shadow-sm">
						{project.video ? (
							<video controls playsinline preload="metadata" poster={project.image} class="mb-6 aspect-video w-full bg-bridge-dark object-cover">
								<source src={project.video} type="video/mp4" />
							</video>
						) : (
							<img src={project.image} alt={project.title} class="mb-6 aspect-video w-full object-cover" loading="lazy" />
						)}
						<span class="mb-3 block text-[10px] font-bold uppercase tracking-[0.22em] text-bridge-taupe">Итог</span>
						<p class="text-sm font-light leading-7 text-gray-600">{project.outcome}</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="bg-bridge-dark py-16 text-white md:py-20">
			<div class="mx-auto max-w-7xl px-6">
				<div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
					<div>
						<span class="mb-4 block text-xs font-bold uppercase tracking-[0.22em] text-bridge-taupe">Другие кейсы</span>
						<h2 class="text-3xl font-bold md:text-4xl">Еще проекты Bridge Consult</h2>
					</div>
					<a href="/projects.html" class="inline-flex w-max items-center gap-3 text-xs font-bold uppercase tracking-widest text-bridge-taupe transition-colors hover:text-white">
						Все проекты
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
					</a>
				</div>
				<div class="grid gap-4 md:grid-cols-3">
					{related.map((item) => (
						<a href={`/projects/${item.slug}/`} class="group border border-white/10 bg-white/[0.04] p-5 transition-colors hover:border-bridge-taupe/70 hover:bg-white/[0.07]">
							<span class="mb-4 block text-[10px] font-bold uppercase tracking-[0.22em] text-bridge-taupe">{item.number} / {item.category}</span>
							<strong class="block text-xl leading-snug text-white transition-colors group-hover:text-bridge-taupe">{item.title}</strong>
							<span class="mt-5 inline-flex items-center gap-3 text-[11px] font-bold uppercase tracking-widest text-white/55 transition-colors group-hover:text-bridge-taupe">
								Открыть кейс
								<span class="h-px w-8 bg-bridge-taupe transition-all group-hover:w-12"></span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter lang="ru" />
</Layout>
