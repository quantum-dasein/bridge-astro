---
/**
 * Превью нового лендинга Academy на Astro + Tailwind.
 *
 * Живёт на отдельном роуте: боевая страница /academy/ это статика в public/,
 * и пока новая вёрстка не утверждена, трогать её нельзя. Когда утвердим —
 * статику удаляем, эту страницу переносим на /academy/.
 *
 * Контент целиком в src/data/academy.ru.ts: компоненты презентационные,
 * EN и UZ добавятся такими же файлами данных.
 */
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import Header from '../../../components/academy/Header.astro';
import Hero from '../../../components/academy/Hero.astro';
import Programme from '../../../components/academy/Programme.astro';
import Method from '../../../components/academy/Method.astro';
import Modules from '../../../components/academy/Modules.astro';
import CaseStudy from '../../../components/academy/CaseStudy.astro';
import Audience from '../../../components/academy/Audience.astro';
import Format from '../../../components/academy/Format.astro';
import Trainer from '../../../components/academy/Trainer.astro';
import Apply from '../../../components/academy/Apply.astro';
import Footer from '../../../components/academy/Footer.astro';
import { academyRu as c } from '../../../data/academy.ru';
---

<AcademyLayout title={c.meta.title} description={c.meta.description} lang={c.lang}>
	<Header nav={c.nav} cta={c.cta} current="ru" langLinks={c.langLinks} />

	<main>
		<Hero {...c.hero} />
		<Programme {...c.programme} />
		<Method {...c.method} />
		<Modules {...c.modules} />
		<CaseStudy {...c.caseStudy} />
		<Audience {...c.audience} />
		<Format {...c.format} />
		<Trainer {...c.trainer} />
		<Apply {...c.apply} />
	</main>

	<Footer {...c.footer} />
</AcademyLayout>
