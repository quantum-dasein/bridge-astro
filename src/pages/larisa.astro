            <span><small data-lang="ru">Телефон / WhatsApp</small><small data-lang="en">Call / WhatsApp</small><strong>+998 33 000 15 30</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="mailto:mail@lkbelousova.ru">
            <span class="contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3V6Zm1 1 8 6 8-6" /></svg></span>
            <span><small>Email</small><strong>mail@lkbelousova.ru</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/larissalk" target="_blank" rel="noopener">
            <span class="contact-icon linkedin-icon" aria-hidden="true">in</span>
            <span><small>LinkedIn</small><strong>Larisa Belousova</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
