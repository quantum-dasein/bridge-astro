  .mobile-contact-dock { display: none; }
  .has-js .reveal { transform: translateY(38px); filter: none; transition: opacity .8s ease, transform .9s cubic-bezier(.16,1,.3,1); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @keyframes manifesto-breathe { from { transform: scale(1.01); } to { transform: scale(1.065); } }

  @media (max-width: 1080px) {
