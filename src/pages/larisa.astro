  .stats { gap: 8px; padding: 8px; border: 1px solid rgba(216,189,150,.16); border-radius: 24px; background: rgba(255,255,255,.022); backdrop-filter: blur(10px); }
  .stats > div { min-height: 116px; padding: 17px 15px; border-radius: 16px; background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.012)); transition: background .25s ease, transform .25s ease; }
