---
import '../styles/global.css';

const pageUrl = 'https://bridgeconsult.uz/larisa/';
const pageTitle = 'Лариса Белоусова — Founder & Director, BRIDGE Consult';
const pageDescription = 'Лариса Белоусова — международный эксперт по инфраструктурным контрактам, FIDIC, EPC/EPC+F, закупкам, claims и предотвращению споров.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0c0b" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://bridgeconsult.uz/larisa-belousova.jpg" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
  </head>
  <body data-language="ru">
    <div class="page-progress" aria-hidden="true"><span></span></div>

    <header class="site-nav" aria-label="Основная навигация">
      <a class="brand" href="/" aria-label="Bridge Consult — главная">
        <img src="/bridge 2.svg" alt="Bridge Consult" width="160" height="60" />
      </a>
      <nav class="nav-links" aria-label="Разделы страницы">
        <a href="#about"><span data-lang="ru">Обо мне</span><span data-lang="en">About</span></a>
        <a href="#expertise"><span data-lang="ru">Экспертиза</span><span data-lang="en">Expertise</span></a>
        <a href="#credentials"><span data-lang="ru">Квалификации</span><span data-lang="en">Credentials</span></a>
      </nav>
      <div class="nav-actions">
        <div class="language-switcher" role="group" aria-label="Language">
          <button type="button" data-language-button="ru" aria-pressed="true">RU</button>
          <span aria-hidden="true"></span>
          <button type="button" data-language-button="en" aria-pressed="false">EN</button>
        </div>
        <a class="nav-contact" href="#connect">
          <span data-lang="ru">Связаться</span><span data-lang="en">Connect</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </header>

    <main>
      <section class="hero" id="about">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>

        <div class="portrait-stage hero-enter">
          <div class="portrait-frame" data-parallax-frame>
            <img src="/larisa-belousova.jpg" alt="Лариса Константиновна Белоусова" width="854" height="1280" fetchpriority="high" />
            <div class="portrait-wash"></div>
            <div class="portrait-caption">
              <span>BRIDGE Consult LLC</span>
              <span>Tashkent · Uzbekistan</span>
            </div>
          </div>
          <div class="orbit orbit-one" aria-hidden="true"></div>
          <div class="orbit orbit-two" aria-hidden="true"></div>
          <span class="coordinates" aria-hidden="true">41.2995° N&nbsp;&nbsp; 69.2401° E</span>
        </div>

        <div class="hero-copy">
          <div class="eyebrow hero-enter" style="--delay: .1s">
            <span class="eyebrow-line"></span>
            <span data-lang="ru">Основатель и директор</span>
            <span data-lang="en">Founder &amp; Director</span>
          </div>
          <h1 class="hero-title hero-enter" style="--delay: .18s">
            <span>Larisa K.</span>
            <em>Belousova</em>
          </h1>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="ru">
            Международный эксперт по инфраструктурным контрактам с 27-летним управленческим опытом — от стратегии контракта до предотвращения и разрешения споров.
          </p>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="en">
            An international infrastructure contracts specialist with 27 years of management experience — from contract strategy to dispute avoidance and resolution.
          </p>

          <div class="hero-actions hero-enter" style="--delay: .36s">
            <a class="primary-action magnetic" href="/larisa-contact.vcf" download>
              <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
              </span>
              <span><strong data-lang="ru">Сохранить контакт</strong><strong data-lang="en">Save contact</strong><small>VCARD · .VCF</small></span>
              <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="round-action magnetic" href="tel:+998330001530" aria-label="Позвонить Ларисе Белоусовой">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5 9 3l2 5-2.2 1.5a14 14 0 0 0 5.7 5.7L16 13l5 2-.5 2.5a4 4 0 0 1-4.4 3.1C9.4 19.7 4.3 14.6 3.4 7.9A4 4 0 0 1 6.5 3.5Z" /></svg>
            </a>
          </div>

          <div class="stats hero-enter" style="--delay: .44s" aria-label="Опыт и охват">
            <div><strong><span data-count="27">27</span>+</strong><span data-lang="ru">лет опыта</span><span data-lang="en">years of experience</span></div>
            <div><strong><span data-count="15">15</span>+</strong><span data-lang="ru">лет в международных проектах</span><span data-lang="en">years in international projects</span></div>
            <div><strong><span data-count="600">600</span>+</strong><span data-lang="ru">обученных специалистов</span><span data-lang="en">specialists trained</span></div>
            <div><strong><span data-count="10">10</span>+</strong><span data-lang="ru">стран</span><span data-lang="en">countries</span></div>
          </div>
        </div>

        <a class="scroll-cue" href="#expertise" aria-label="Листать к разделу Экспертиза">
          <span data-lang="ru">Смотреть профиль</span><span data-lang="en">Explore profile</span>
          <i aria-hidden="true"></i>
        </a>
      </section>

      <section class="profile-section" id="expertise">
        <div class="section-intro reveal">
          <div class="section-number">01</div>
          <div>
            <p class="section-kicker" data-lang="ru">Ключевая экспертиза</p>
            <p class="section-kicker" data-lang="en">Key expertise</p>
            <h2 data-lang="ru">Контракты, которые<br /><em>работают</em> на проект.</h2>
            <h2 data-lang="en">Contracts that<br /><em>work</em> for the project.</h2>
          </div>
          <p class="section-summary" data-lang="ru">Консультационная поддержка заказчиков, подрядчиков, инженеров и государственных органов на всём жизненном цикле крупных инфраструктурных проектов.</p>
          <p class="section-summary" data-lang="en">Advising employers, contractors, engineers and public authorities throughout the full lifecycle of major infrastructure projects.</p>
        </div>

        <div class="expertise-grid">
          <article class="expertise-card reveal" style="--i: 0">
            <span class="card-index">01</span>
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 38V10h32v28H8Zm7-20h18M15 25h18M15 32h10" /></svg>
            <h3 data-lang="ru">Стратегия и подготовка контрактов</h3>
            <h3 data-lang="en">Contract strategy &amp; drafting</h3>
            <p>FIDIC · EPC / EPC+F · MDB Harmonised</p>
          </article>
          <article class="expertise-card reveal" style="--i: 1">
            <span class="card-index">02</span>
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 39 24 8l15 31H9Zm15-20v9m0 5v.5" /></svg>
            <h3 data-lang="ru">Claims и предотвращение споров</h3>
            <h3 data-lang="en">Claims &amp; dispute avoidance</h3>
            <p>DAB / DAAB · Mediation · Arbitration</p>
          </article>
          <article class="expertise-card reveal" style="--i: 2">
            <span class="card-index">03</span>
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38h28M14 38V20h20v18M19 20v-6h10v6M20 27h8" /></svg>
            <h3 data-lang="ru">Закупки и управление рисками</h3>
            <h3 data-lang="en">Procurement &amp; risk management</h3>
            <p>Tendering · Variations · Commercial risk</p>
          </article>
          <article class="expertise-card reveal" style="--i: 3">
            <span class="card-index">04</span>
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 34c5-8 9-12 14-12s9 4 14 12M24 22V9m-6 5 6-5 6 5M12 39h24" /></svg>
            <h3 data-lang="ru">Обучение и развитие потенциала</h3>
            <h3 data-lang="en">Training &amp; capacity building</h3>
            <p>FIDIC training · Workshops · Mentoring</p>
          </article>
        </div>
      </section>

      <section class="credentials-section" id="credentials">
        <div class="credentials-visual reveal">
          <div class="credentials-photo">
            <img src="/larisa-belousova.jpg" alt="Лариса Белоусова, основатель BRIDGE Consult" width="854" height="1280" loading="lazy" />
          </div>
          <p class="vertical-word" aria-hidden="true">INTEGRITY</p>
          <div class="quote-card">
            <span class="quote-mark">“</span>
            <blockquote data-lang="ru">Сильный контракт создаёт не барьеры, а ясность, доверие и общий путь к результату.</blockquote>
            <blockquote data-lang="en">A strong contract creates not barriers, but clarity, trust and a shared path to results.</blockquote>
          </div>
        </div>

        <div class="credentials-copy reveal">
          <div class="section-number">02</div>
          <p class="section-kicker" data-lang="ru">Профессиональный уровень</p>
          <p class="section-kicker" data-lang="en">Selected credentials</p>
          <h2 data-lang="ru">Международные<br /><em>квалификации.</em></h2>
          <h2 data-lang="en">International<br /><em>credentials.</em></h2>
          <ul class="credential-list">
            <li><span>FCCE</span><p>FIDIC Certified Consulting Engineer</p></li>
            <li><span>FCCP</span><p>FIDIC Certified Consulting Professional</p></li>
            <li><span>ADB</span><p>Accredited Contract Management &amp; Dispute Avoidance Specialist</p></li>
            <li><span>MCIArb</span><p data-lang="ru">Член Королевского института арбитров</p><p data-lang="en">Member, Chartered Institute of Arbitrators</p></li>
            <li><span>DRBF</span><p>Dispute Board Practitioner</p></li>
            <li><span>IMC</span><p data-lang="ru">Член Комитета FIDIC по управлению добросовестностью</p><p data-lang="en">Member, FIDIC Integrity Management Committee</p></li>
          </ul>
          <a class="text-link" href="https://hyperstack.id/arisaelousova" target="_blank" rel="noopener">
            <span data-lang="ru">Все квалификации и членства</span><span data-lang="en">All credentials &amp; memberships</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </section>

      <section class="connect-section" id="connect">
        <div class="connect-lines" aria-hidden="true"></div>
        <div class="connect-copy reveal">
          <p class="section-kicker" data-lang="ru">На связи</p>
          <p class="section-kicker" data-lang="en">Let’s connect</p>
          <h2 data-lang="ru">Начнём с<br /><em>разговора.</em></h2>
          <h2 data-lang="en">Let’s start with<br /><em>a conversation.</em></h2>
          <p data-lang="ru">По вопросам консультаций, проектов, выступлений и обучения.</p>
          <p data-lang="en">For consulting, projects, speaking engagements and training.</p>
        </div>

        <div class="contact-list reveal">
          <a href="tel:+998330001530">
            <span class="contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5 9 3l2 5-2.2 1.5a14 14 0 0 0 5.7 5.7L16 13l5 2-.5 2.5a4 4 0 0 1-4.4 3.1C9.4 19.7 4.3 14.6 3.4 7.9A4 4 0 0 1 6.5 3.5Z" /></svg></span>
            <span><small data-lang="ru">Телефон / WhatsApp</small><small data-lang="en">Call / WhatsApp</small><strong>+998 33 000 15 30</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="mailto:mail@lkbelousova.ru">
            <span class="contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3V6Zm1 1 8 6 8-6" /></svg></span>
            <span><small>Email</small><strong>mail@lkbelousova.ru</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/larissalk" target="_blank" rel="noopener">
            <span class="contact-icon linkedin-icon" aria-hidden="true">in</span>
            <span><small>LinkedIn</small><strong>Larisa Belousova</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/larisa-belousova-cv.pdf" target="_blank">
            <span class="contact-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6V3Zm8 0v5h5M9 13h6M9 17h4" /></svg></span>
            <span><small>Curriculum vitae</small><strong data-lang="ru">Скачать CV</strong><strong data-lang="en">Download CV</strong></span>
            <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        <div class="qr-card reveal">
          <div class="qr-shell"><img src="/larisa-qr.svg" alt="QR-код страницы bridgeconsult.uz/larisa" width="768" height="768" loading="lazy" /></div>
          <div>
            <p class="section-kicker" data-lang="ru">Постоянная ссылка</p>
            <p class="section-kicker" data-lang="en">Permanent link</p>
            <h3>bridgeconsult.uz/larisa</h3>
            <p data-lang="ru">Сканируйте QR-код, чтобы открыть эту страницу и сохранить контакт.</p>
            <p data-lang="en">Scan the QR code to open this page and save the contact.</p>
            <button type="button" class="copy-link" data-copy-link>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h11v11H8V8Zm-3 8H3V3h13v2" /></svg>
              <span data-copy-label data-lang="ru">Копировать ссылку</span>
              <span data-copy-label data-lang="en">Copy link</span>
            </button>
          </div>
        </div>

        <footer>
          <a class="footer-brand" href="/"><img src="/bridge 2.svg" alt="Bridge Consult" width="150" height="56" /></a>
          <p>© {new Date().getFullYear()} BRIDGE Consult LLC</p>
          <p>Tashkent&nbsp;&nbsp; | &nbsp;&nbsp;Uzbekistan&nbsp;&nbsp; | &nbsp;&nbsp;Worldwide</p>
        </footer>
      </section>
    </main>

    <script is:inline>
      (() => {
        const body = document.body;
        const buttons = document.querySelectorAll('[data-language-button]');
        const titles = {
          ru: 'Лариса Белоусова — основатель и директор BRIDGE Consult',
          en: 'Larisa Belousova — Founder & Director, BRIDGE Consult'
        };

        const setLanguage = (language) => {
          body.dataset.language = language;
          document.documentElement.lang = language;
          document.title = titles[language];
          localStorage.setItem('larisa-language', language);
          buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.languageButton === language)));
        };
        buttons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.languageButton)));
        const savedLanguage = localStorage.getItem('larisa-language');
        if (savedLanguage === 'en' || savedLanguage === 'ru') setLanguage(savedLanguage);

        const progress = document.querySelector('.page-progress span');
        const frame = document.querySelector('[data-parallax-frame]');
        let ticking = false;
        const updateScroll = () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${scrollable > 0 ? window.scrollY / scrollable : 0})`;
          if (frame && window.innerWidth > 760 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            frame.style.setProperty('--parallax', `${Math.min(window.scrollY * .045, 36)}px`);
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(updateScroll); ticking = true; }
        }, { passive: true });
        updateScroll();

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const reveals = document.querySelectorAll('.reveal');
        if (!reduced && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: .14, rootMargin: '0px 0px -5% 0px' });
          reveals.forEach((element) => observer.observe(element));
        } else {
          reveals.forEach((element) => element.classList.add('is-visible'));
        }

        const counters = document.querySelectorAll('[data-count]');
        if (!reduced && 'IntersectionObserver' in window) {
          const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const node = entry.target;
              const target = Number(node.dataset.count);
              const duration = 900;
              const start = performance.now();
              const step = (now) => {
                const amount = Math.min((now - start) / duration, 1);
                node.textContent = Math.round(target * (1 - Math.pow(1 - amount, 3)));
                if (amount < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
              counterObserver.unobserve(node);
            });
          }, { threshold: .8 });
          counters.forEach((counter) => counterObserver.observe(counter));
        }

        if (!reduced && window.matchMedia('(pointer: fine)').matches) {
          document.querySelectorAll('.magnetic').forEach((element) => {
            element.addEventListener('pointermove', (event) => {
              const rect = element.getBoundingClientRect();
              element.style.transform = `translate(${(event.clientX - rect.left - rect.width / 2) * .08}px, ${(event.clientY - rect.top - rect.height / 2) * .08}px)`;
            });
            element.addEventListener('pointerleave', () => { element.style.transform = ''; });
          });
        }

        document.querySelector('[data-copy-link]')?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('https://bridgeconsult.uz/larisa');
            document.querySelectorAll('[data-copy-label]').forEach((label) => {
              label.textContent = label.dataset.lang === 'ru' ? 'Ссылка скопирована' : 'Link copied';
            });
            setTimeout(() => document.querySelectorAll('[data-copy-label]').forEach((label) => {
              label.textContent = label.dataset.lang === 'ru' ? 'Копировать ссылку' : 'Copy link';
            }), 1800);
          } catch (_) {}
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --carbon: #0d0c0b;
    --carbon-soft: #151311;
    --paper: #eee9df;
    --paper-bright: #faf7f0;
    --champagne: #d8bd96;
    --bronze: #987956;
    --muted: #a59d91;
    --line-dark: rgba(216, 189, 150, .2);
    --line-light: rgba(45, 38, 31, .14);
  }

  * { box-sizing: border-box; }
  html { background: var(--carbon); scroll-behavior: smooth; }
  body {
    margin: 0;
    overflow-x: hidden;
    background: var(--carbon);
    color: #f8f5ef;
    font-family: 'Manrope', 'Inter', sans-serif;
    font-weight: 400;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    opacity: .035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; font: inherit; }
  svg { display: block; }
  [data-lang='en'] { display: none !important; }
  body[data-language='en'] [data-lang='ru'] { display: none !important; }
  body[data-language='en'] [data-lang='en'] { display: revert !important; }

  :focus-visible { outline: 2px solid var(--champagne); outline-offset: 4px; }
  .page-progress { position: fixed; inset: 0 0 auto; z-index: 100; height: 2px; background: rgba(255,255,255,.04); }
  .page-progress span { display: block; width: 100%; height: 100%; background: var(--champagne); transform: scaleX(0); transform-origin: left; will-change: transform; }

  .site-nav {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 50%;
    width: min(100% - 64px, 1400px);
    min-height: 112px;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .brand { width: 154px; height: 58px; display: flex; align-items: center; }
  .brand img, .footer-brand img { width: 100%; height: auto; filter: brightness(0) invert(1); opacity: .95; }
  .nav-links { display: flex; gap: clamp(24px, 3vw, 54px); color: rgba(255,255,255,.65); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .nav-links a { position: relative; transition: color .2s ease; }
  .nav-links a::after { content: ''; position: absolute; left: 0; bottom: -8px; width: 100%; height: 1px; background: var(--champagne); transform: scaleX(0); transform-origin: right; transition: transform .3s ease; }
  .nav-links a:hover { color: white; }
  .nav-links a:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav-actions { justify-self: end; display: flex; align-items: center; gap: 28px; }
