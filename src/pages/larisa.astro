  .principles > div::after { content: ''; position: absolute; inset: auto 22px 0; height: 2px; background: linear-gradient(90deg, transparent, var(--champagne), transparent); opacity: .25; transform: scaleX(.35); transition: opacity .3s ease, transform .4s ease; }
