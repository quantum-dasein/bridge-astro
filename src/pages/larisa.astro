---
import '../styles/global.css';

const pageUrl = 'https://bridgeconsult.uz/larisa/';
const pageTitle = 'Лариса Белоусова — Founder & Director, BRIDGE Consult';
const pageDescription = 'Лариса Белоусова — международный эксперт по инфраструктурным контрактам, FIDIC, EPC/EPC+F, закупкам, claims и предотвращению споров.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0c0b" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://bridgeconsult.uz/larisa-belousova.jpg" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
  </head>
  <body data-language="ru">
    <div class="page-progress" aria-hidden="true"><span></span></div>

    <header class="site-nav" aria-label="Основная навигация">
      <a class="brand" href="/" aria-label="Bridge Consult — главная">
        <img src="/bridge 2.svg" alt="Bridge Consult" width="160" height="60" />
      </a>
      <nav class="nav-links" aria-label="Разделы страницы">
        <a href="#about"><span data-lang="ru">Обо мне</span><span data-lang="en">About</span></a>
        <a href="#expertise"><span data-lang="ru">Экспертиза</span><span data-lang="en">Expertise</span></a>
        <a href="#credentials"><span data-lang="ru">Квалификации</span><span data-lang="en">Credentials</span></a>
      </nav>
      <div class="nav-actions">
        <div class="language-switcher" role="group" aria-label="Language">
          <button type="button" data-language-button="ru" aria-pressed="true">RU</button>
          <span aria-hidden="true"></span>
          <button type="button" data-language-button="en" aria-pressed="false">EN</button>
        </div>
        <a class="nav-contact" href="#connect" aria-label="Перейти к контактам / Go to contacts">
          <span data-lang="ru">Связаться</span><span data-lang="en">Connect</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </header>

    <main>
      <section class="hero" id="about">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-monogram" aria-hidden="true">L·B</div>

        <div class="portrait-stage hero-enter">
          <div class="portrait-index" aria-hidden="true"><span>01</span> Executive profile</div>
          <div class="portrait-frame" data-parallax-frame>
            <img src="/larisa-belousova.jpg" alt="Лариса Константиновна Белоусова" width="854" height="1280" fetchpriority="high" />
            <div class="portrait-wash"></div>
            <div class="portrait-caption">
              <span>BRIDGE Consult LLC</span>
              <span>Tashkent · Uzbekistan</span>
            </div>
          </div>
          <div class="orbit orbit-one" aria-hidden="true"></div>
          <div class="orbit orbit-two" aria-hidden="true"></div>
          <span class="coordinates" aria-hidden="true">41.2995° N&nbsp;&nbsp; 69.2401° E</span>
          <div class="portrait-seal" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs><path id="seal-path" d="M60,60 m-43,0 a43,43 0 1,1 86,0 a43,43 0 1,1 -86,0" /></defs>
              <text><textPath href="#seal-path">BRIDGE CONSULT · TASHKENT · WORLDWIDE · </textPath></text>
              <path class="seal-mark" d="M38 62h44M67 47l15 15-15 15" />
            </svg>
          </div>
        </div>

        <div class="hero-copy">
          <div class="hero-status hero-enter" style="--delay: .06s">
            <span class="status-dot"></span>
            <span data-lang="ru">Ташкент · международные проекты</span>
            <span data-lang="en">Tashkent · international projects</span>
          </div>
          <div class="eyebrow hero-enter" style="--delay: .1s">
            <span class="eyebrow-line"></span>
            <span data-lang="ru">Основатель и директор</span>
            <span data-lang="en">Founder &amp; Director</span>
          </div>
          <h1 class="hero-title hero-enter" style="--delay: .18s">
            <span>Larisa K.</span>
            <em>Belousova</em>
          </h1>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="ru">
            Международный эксперт по инфраструктурным контрактам с 27-летним управленческим опытом — от стратегии контракта до предотвращения и разрешения споров.
          </p>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="en">
            An international infrastructure contracts specialist with 27 years of management experience — from contract strategy to dispute avoidance and resolution.
          </p>

          <div class="hero-credentials hero-enter" style="--delay: .32s" aria-label="Ключевые квалификации">
            <span>FCCE</span><i aria-hidden="true"></i><span>FCCP</span><i aria-hidden="true"></i><span>ADB Accredited</span><i aria-hidden="true"></i><span>MCIArb</span>
          </div>

          <div class="hero-actions hero-enter" style="--delay: .36s">
            <a class="primary-action magnetic" href="/larisa-contact.vcf" data-save-contact>
              <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M15 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M8.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" /></svg>
              </span>
              <span><strong data-contact-label data-lang="ru">Добавить в контакты</strong><strong data-contact-label data-lang="en">Add to contacts</strong><small data-lang="ru">Откроется карточка контакта</small><small data-lang="en">Opens your contact card</small></span>
              <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="secondary-action magnetic" href="https://wa.me/998330001530" target="_blank" rel="noopener" aria-label="Написать Ларисе Белоусовой в WhatsApp">
              <span class="action-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6ZM8.3 7.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.9 2.1c.1.3 0 .5-.2.8l-.7.8c-.2.2-.1.5 0 .7.7 1.2 1.7 2.2 3 2.9.2.1.5.1.7-.1l.9-1c.2-.2.5-.3.8-.2l2 .9c.3.1.4.3.4.6 0 .5-.2 1.5-.8 2-.6.5-1.4.8-2.3.6-1-.2-2.4-.7-4.1-1.8-2.5-1.6-4.1-4-4.5-5.1-.4-1.1 0-2.4.5-2.9l.7-.3Z" /></svg></span>
              <span><strong>WhatsApp</strong><small data-lang="ru">Написать напрямую</small><small data-lang="en">Message directly</small></span>
            </a>
          </div>

          <div class="stats hero-enter" style="--delay: .44s" aria-label="Опыт и охват">
            <div><strong><span data-count="27">27</span>+</strong><span data-lang="ru">лет опыта</span><span data-lang="en">years of experience</span></div>
            <div><strong><span data-count="15">15</span>+</strong><span data-lang="ru">лет в международных проектах</span><span data-lang="en">years in international projects</span></div>
            <div><strong><span data-count="600">600</span>+</strong><span data-lang="ru">обученных специалистов</span><span data-lang="en">specialists trained</span></div>
            <div><strong><span data-count="10">10</span>+</strong><span data-lang="ru">стран</span><span data-lang="en">countries</span></div>
          </div>
        </div>

        <a class="scroll-cue" href="#expertise" aria-label="Листать к разделу Экспертиза">
          <span data-lang="ru">Смотреть профиль</span><span data-lang="en">Explore profile</span>
          <i aria-hidden="true"></i>
        </a>
      </section>

      <section class="profile-section" id="expertise">
        <div class="section-intro reveal">
          <div class="section-number">01</div>
          <div>
            <p class="section-kicker" data-lang="ru">Ключевая экспертиза</p>
            <p class="section-kicker" data-lang="en">Key expertise</p>
            <h2 data-lang="ru">Контракты, которые<br /><span class="title-accent">работают на проект.</span></h2>
            <h2 data-lang="en">Contracts that<br /><span class="title-accent">work for the project.</span></h2>
          </div>
          <p class="section-summary" data-lang="ru">Консультационная поддержка заказчиков, подрядчиков, инженеров и государственных органов на всём жизненном цикле крупных инфраструктурных проектов.</p>
          <p class="section-summary" data-lang="en">Advising employers, contractors, engineers and public authorities throughout the full lifecycle of major infrastructure projects.</p>
        </div>

        <div class="expertise-grid">
          <article class="expertise-card reveal" style="--i: 0">
            <div class="card-top"><span class="card-index">01</span><span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 38V10h32v28H8Zm7-20h18M15 25h18M15 32h10" /></svg></span></div>
            <h3 data-lang="ru">Стратегия и подготовка контрактов</h3>
            <h3 data-lang="en">Contract strategy &amp; drafting</h3>
            <div class="expertise-tags" aria-label="FIDIC, EPC / EPC+F, MDB Harmonised"><span>FIDIC</span><span>EPC / EPC+F</span><span>MDB Harmonised</span></div>
          </article>
          <article class="expertise-card reveal" style="--i: 1">
            <div class="card-top"><span class="card-index">02</span><span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 39 24 8l15 31H9Zm15-20v9m0 5v.5" /></svg></span></div>
            <h3 data-lang="ru">Claims и предотвращение споров</h3>
            <h3 data-lang="en">Claims &amp; dispute avoidance</h3>
            <div class="expertise-tags" aria-label="DAB / DAAB, Mediation, Arbitration"><span>DAB / DAAB</span><span>Mediation</span><span>Arbitration</span></div>
          </article>
          <article class="expertise-card reveal" style="--i: 2">
            <div class="card-top"><span class="card-index">03</span><span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38h28M14 38V20h20v18M19 20v-6h10v6M20 27h8" /></svg></span></div>
            <h3 data-lang="ru">Закупки и управление рисками</h3>
            <h3 data-lang="en">Procurement &amp; risk management</h3>
            <div class="expertise-tags" aria-label="Tendering, Variations, Commercial risk"><span>Tendering</span><span>Variations</span><span>Commercial risk</span></div>
          </article>
          <article class="expertise-card reveal" style="--i: 3">
            <div class="card-top"><span class="card-index">04</span><span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 34c5-8 9-12 14-12s9 4 14 12M24 22V9m-6 5 6-5 6 5M12 39h24" /></svg></span></div>
            <h3 data-lang="ru">Обучение и развитие потенциала</h3>
            <h3 data-lang="en">Training &amp; capacity building</h3>
            <div class="expertise-tags" aria-label="FIDIC training, Workshops, Mentoring"><span>FIDIC training</span><span>Workshops</span><span>Mentoring</span></div>
          </article>
        </div>
      </section>

      <section class="manifesto-section" aria-label="Подход к работе">
        <img class="manifesto-image" src="/hero-bg2.png" alt="Международный инфраструктурный проект" width="1917" height="853" loading="lazy" />
        <div class="manifesto-shade" aria-hidden="true"></div>
        <div class="manifesto-content reveal">
          <div class="manifesto-copy">
            <p class="section-kicker" data-lang="ru">От сложности — к ясности</p>
            <p class="section-kicker" data-lang="en">From complexity to clarity</p>
            <h2 data-lang="ru">Инфраструктура строится<br />на <span class="title-accent">сильных решениях.</span></h2>
            <h2 data-lang="en">Infrastructure is built<br />on <span class="title-accent">strong decisions.</span></h2>
            <p class="manifesto-lead" data-lang="ru">Практический взгляд на контракт как на систему управления результатом — людьми, сроками, рисками и доверием.</p>
            <p class="manifesto-lead" data-lang="en">A practical view of the contract as a system for managing outcomes — people, time, risk and trust.</p>
          </div>
          <div class="principles">
            <div><div class="principle-top"><span>01</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></div><strong data-lang="ru">Ясность до конфликта</strong><strong data-lang="en">Clarity before conflict</strong></div>
            <div><div class="principle-top"><span>02</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7v5c0 4.7 3.3 7.8 8 9 4.7-1.2 8-4.3 8-9V7l-8-4Z" /></svg></div><strong data-lang="ru">Риски под контролем</strong><strong data-lang="en">Risk under control</strong></div>
            <div><div class="principle-top"><span>03</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11" /></svg></div><strong data-lang="ru">Решения, которые работают</strong><strong data-lang="en">Decisions that deliver</strong></div>
          </div>
        </div>
        <div class="manifesto-marquee" aria-hidden="true">
          <div>FIDIC <i></i> EPC / EPC+F <i></i> CLAIMS <i></i> DISPUTE AVOIDANCE <i></i> PROCUREMENT <i></i> FIDIC <i></i> EPC / EPC+F <i></i> CLAIMS <i></i> DISPUTE AVOIDANCE <i></i> PROCUREMENT <i></i></div>
        </div>
      </section>

      <section class="credentials-section" id="credentials">
        <div class="credentials-visual reveal">
          <div class="credentials-photo">
            <img src="/larisa-belousova.jpg" alt="Лариса Белоусова, основатель BRIDGE Consult" width="854" height="1280" loading="lazy" />
          </div>
          <p class="vertical-word" aria-hidden="true">INTEGRITY</p>
          <div class="quote-card">
            <span class="quote-mark">“</span>
            <blockquote data-lang="ru">Сильный контракт создаёт не барьеры, а ясность, доверие и общий путь к результату.</blockquote>
            <blockquote data-lang="en">A strong contract creates not barriers, but clarity, trust and a shared path to results.</blockquote>
          </div>
        </div>

        <div class="credentials-copy reveal">
          <div class="section-number">02</div>
          <p class="section-kicker" data-lang="ru">Профессиональный уровень</p>
          <p class="section-kicker" data-lang="en">Selected credentials</p>
          <h2 data-lang="ru">Международные<br /><em>квалификации.</em></h2>
          <h2 data-lang="en">International<br /><em>credentials.</em></h2>
          <ul class="credential-list">
            <li><span>FCCE</span><p>FIDIC Certified Consulting Engineer</p></li>
            <li><span>FCCP</span><p>FIDIC Certified Consulting Professional</p></li>
            <li><span>ADB</span><p>Accredited Contract Management &amp; Dispute Avoidance Specialist</p></li>
            <li><span>MCIArb</span><p data-lang="ru">Член Королевского института арбитров</p><p data-lang="en">Member, Chartered Institute of Arbitrators</p></li>
            <li><span>DRBF</span><p>Dispute Board Practitioner</p></li>
            <li><span>IMC</span><p data-lang="ru">Член Комитета FIDIC по управлению добросовестностью</p><p data-lang="en">Member, FIDIC Integrity Management Committee</p></li>
          </ul>
          <div class="credential-badges" aria-label="Профессиональные организации">
            <a href="https://credentials.fidic.org/credential/69f72bbf-bc1f-4f5e-b480-90590afd6440" target="_blank" rel="noopener" title="FIDIC FCCE">
              <img src="/fidic-fcce-badge.png" alt="FIDIC Certified Consulting Engineer" loading="lazy" />
            </a>
            <a href="https://credentials.fidic.org/credential/d97d9db8-ab47-4971-81aa-495bfcf78b9e" target="_blank" rel="noopener" title="FIDIC FCCP">
              <img src="/fidic-fccp-badge.png" alt="FIDIC Certified Consulting Professional" loading="lazy" />
            </a>
            <a href="https://www.ciarb.org" target="_blank" rel="noopener" title="Chartered Institute of Arbitrators">
              <img src="/ciarb-logo.png" alt="Chartered Institute of Arbitrators" loading="lazy" />
            </a>
            <a href="https://www.drbf.org" target="_blank" rel="noopener" title="Dispute Resolution Board Foundation">
              <img src="/drbf-logo.png" alt="Dispute Resolution Board Foundation" loading="lazy" />
            </a>
          </div>
          <a class="text-link" href="https://hyperstack.id/arisaelousova" target="_blank" rel="noopener">
            <span data-lang="ru">Все квалификации и членства</span><span data-lang="en">All credentials &amp; memberships</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </section>

      <section class="connect-section" id="connect">
