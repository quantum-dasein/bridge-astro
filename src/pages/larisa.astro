  .secondary-action:hover { border-color: rgba(216, 189, 150, 0.5); background: rgba(216, 189, 150, 0.09); }
  .secondary-action .action-icon { background: rgba(255, 255, 255, 0.065); color: var(--champagne); }
  .secondary-action small { color: rgba(255, 255, 255, 0.45); font-size: 9px; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding: 8px;
    border: 1px solid rgba(216, 189, 150, 0.16);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.022);
    backdrop-filter: blur(10px);
  }
  .stats > div {
    min-height: 116px;
    padding: 17px 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.012));
    transition: background 0.3s ease, transform 0.3s var(--ease-out);
  }
  .stats > div:hover { transform: translateY(-4px); background: rgba(216, 189, 150, 0.09); }
  .stats strong { color: var(--champagne); font-family: 'Playfair Display', serif; font-size: clamp(28px, 2.2vw, 38px); font-weight: 500; font-variant-numeric: tabular-nums; }
  .stats div > span { max-width: 130px; color: rgba(255, 255, 255, 0.55); font-size: 9px; line-height: 1.35; letter-spacing: 0.08em; text-transform: uppercase; }

  .scroll-cue {
    position: absolute;
    left: var(--gutter);
    bottom: 18px;
    display: flex;
    align-items: center;
    gap: 15px;
    color: rgba(255, 255, 255, 0.38);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .scroll-cue:hover { color: var(--champagne); }
  .scroll-cue i { position: relative; display: block; width: 54px; height: 1px; overflow: hidden; background: rgba(255, 255, 255, 0.17); }
  .scroll-cue i::after { content: ''; position: absolute; width: 50%; height: 100%; background: var(--champagne); animation: scan-line 2.4s ease-in-out infinite; }
  .hero-enter { animation: hero-in 0.95s var(--ease-out) both; animation-delay: var(--delay, 0s); }

  /* ═══ Expertise ═══════════════════════════════════════════════════════ */
  .profile-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 150px var(--gutter);
    color: #f7f4ee;
    background: #10100f;
  }
  .profile-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.38;
    background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: linear-gradient(135deg, black, transparent 78%);
    -webkit-mask-image: linear-gradient(135deg, black, transparent 78%);
    pointer-events: none;
  }
  .profile-section::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -260px;
    right: -180px;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(184, 139, 84, 0.16), transparent 68%);
    pointer-events: none;
  }
  .section-intro {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 64px minmax(0, 1.4fr) minmax(320px, 0.6fr);
    gap: 34px;
    align-items: end;
    margin-bottom: 68px;
  }
  .profile-section .section-number { color: var(--champagne); }
  .profile-section .section-kicker,
  .manifesto-section .section-kicker { color: var(--champagne); }
  .section-intro h2,
  .credentials-copy h2,
  .connect-copy h2 {
    margin: 0;
    font-family: 'Manrope', sans-serif;
    font-size: clamp(46px, 5.3vw, 80px);
    font-weight: 600;
    letter-spacing: -0.058em;
    line-height: 0.98;
  }
  .section-intro h2 em,
  .credentials-copy h2 em,
  .connect-copy h2 em { color: var(--bronze); font-family: 'Playfair Display', serif; font-weight: 500; }
  .section-summary { max-width: 480px; margin: 0 0 5px; color: rgba(255, 255, 255, 0.68); font-size: 17px; line-height: 1.72; }

  .expertise-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; }
  .expertise-card {
    --mx: 82%;
    --my: 18%;
    position: relative;
    grid-column: span 2;
    min-height: 340px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.105);
    border-radius: 24px;
    color: #f7f4ee;
    background: linear-gradient(145deg, rgba(30, 30, 28, 0.96), rgba(18, 18, 17, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045), 0 30px 70px -52px rgba(0, 0, 0, 0.9);
  }
  .expertise-card.is-wide { grid-column: span 3; }
  .expertise-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.55;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgba(216, 189, 150, 0.14), transparent 62%);
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .expertise-card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--champagne), transparent);
    opacity: 0;
    transform: scaleX(0.25);
    transition: opacity 0.3s ease, transform 0.45s var(--ease-out);
  }
  .expertise-card > * { position: relative; z-index: 1; }
  .expertise-card:hover { border-color: rgba(216, 189, 150, 0.38); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 36px 80px -46px rgba(184, 139, 84, 0.4); }
  .expertise-card:hover::before { opacity: 1; }
  .expertise-card:hover::after { opacity: 1; transform: scaleX(1); }
  .has-js .expertise-card.is-visible { transition: opacity 0.8s ease, transform 0.6s var(--ease-out), border-color 0.3s ease, box-shadow 0.3s ease; }
  .has-js .expertise-card.is-visible:hover { transform: translateY(-8px); }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .card-index { color: rgba(255, 255, 255, 0.5); font-family: ui-monospace, monospace; font-size: 13px; letter-spacing: 0.13em; }
  .card-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(216, 189, 150, 0.24);
    border-radius: 17px;
    color: var(--champagne);
    background: rgba(216, 189, 150, 0.055);
    transition: color 0.3s ease, background 0.3s ease, transform 0.4s var(--ease-out);
  }
  .card-icon svg { width: 29px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .expertise-card:hover .card-icon { color: #15120f; background: var(--champagne); transform: rotate(-4deg) scale(1.05); }
  .expertise-card h3 {
    max-width: 490px;
    margin: auto 0 14px;
    color: #f7f4ee;
    font-family: 'Manrope', sans-serif;
    font-size: clamp(24px, 1.9vw, 31px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.16;
  }
  .card-note { max-width: 420px; margin: 0 0 18px; color: rgba(255, 255, 255, 0.55); font-size: 14px; line-height: 1.55; }
  .expertise-tags { margin-top: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .expertise-tags span {
    padding: 8px 11px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 9px;
    color: rgba(255, 255, 255, 0.82);
    background: rgba(255, 255, 255, 0.05);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.15;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .expertise-card:hover .expertise-tags span { border-color: rgba(216, 189, 150, 0.28); background: rgba(216, 189, 150, 0.1); }

  /* ═══ Manifesto ═══════════════════════════════════════════════════════ */
  .manifesto-section { position: relative; min-height: 860px; display: flex; align-items: center; overflow: hidden; isolation: isolate; background: #090908; }
  .manifesto-image {
    position: absolute;
    inset: -2%;
    z-index: -3;
    width: 104%;
    height: 104%;
    object-fit: cover;
    object-position: 54% 50%;
    filter: saturate(0.62) contrast(1.12);
    animation: manifesto-breathe 18s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }
  .manifesto-shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(90deg, rgba(7, 7, 6, 0.97) 0%, rgba(7, 7, 6, 0.85) 47%, rgba(7, 7, 6, 0.28) 100%), linear-gradient(0deg, rgba(7, 7, 6, 0.88), transparent 62%);
  }
  .manifesto-content {
    width: min(calc(100% - 44px), 1400px);
    margin: 0 auto;
    padding: 124px 0 158px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 66px 8vw;
    align-items: end;
  }
  .manifesto-copy { max-width: 940px; }
  .manifesto-content h2 { max-width: 940px; margin: 0 0 28px; font-family: 'Manrope', sans-serif; font-size: clamp(44px, 4.9vw, 74px); font-weight: 600; letter-spacing: -0.058em; line-height: 1; }
  .manifesto-lead { max-width: 680px; margin: 0; color: rgba(255, 255, 255, 0.72); font-size: 17px; line-height: 1.72; }
  .principles { grid-column: 1 / -1; width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .principles > div {
    --mx: 50%;
    --my: 50%;
    position: relative;
    min-height: 178px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    background: rgba(12, 12, 11, 0.52);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055), 0 28px 70px -48px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
  }
  .principles > div::after {
    content: '';
    position: absolute;
    inset: auto 22px 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--champagne), transparent);
    opacity: 0.25;
    transform: scaleX(0.35);
    transition: opacity 0.3s ease, transform 0.45s var(--ease-out);
  }
  .has-js .reveal.is-visible .principles > div { transition: opacity 0.6s ease calc(var(--i, 0) * 55ms + 0.12s), transform 0.5s var(--ease-out), border-color 0.3s ease, background 0.3s ease; }
  .principles > div:hover { transform: translateY(-6px); border-color: rgba(216, 189, 150, 0.38); background: rgba(18, 17, 15, 0.68); }
  .principles > div:hover::after { opacity: 0.9; transform: scaleX(1); }
  .principle-top { display: flex; align-items: center; justify-content: space-between; }
  .principles span { color: var(--champagne); font-family: ui-monospace, monospace; font-size: 13px; letter-spacing: 0.12em; }
  .principle-top svg { width: 25px; fill: none; stroke: var(--champagne); stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  .principles strong { max-width: 280px; margin-top: auto; font-family: 'Manrope', sans-serif; font-size: clamp(18px, 1.45vw, 22px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.3; }

  .manifesto-marquee {
    position: absolute;
    inset: auto 0 0;
    overflow: hidden;
    border-top: 1px solid rgba(216, 189, 150, 0.2);
    border-bottom: 1px solid rgba(216, 189, 150, 0.2);
    background: rgba(9, 9, 8, 0.82);
    backdrop-filter: blur(18px);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .manifesto-marquee div {
    width: max-content;
    padding: 20px 0;
    display: flex;
    align-items: center;
    gap: 30px;
    color: rgba(255, 255, 255, 0.58);
    font-family: ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.12em;
    animation: marquee 34s linear infinite;
  }
  .manifesto-marquee:hover div { animation-play-state: paused; }
  .manifesto-marquee i { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--champagne); }

  /* ═══ Credentials ═════════════════════════════════════════════════════ */
  .credentials-section {
    padding: 146px var(--gutter);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(64px, 8vw, 150px);
    align-items: center;
    background: linear-gradient(150deg, #f7f2e9, #ded2c3);
    color: #221f1b;
  }
  .credentials-visual { position: relative; min-height: 720px; }
  .credentials-photo { width: 78%; height: 650px; overflow: hidden; border-radius: 220px 220px 24px 24px; filter: grayscale(0.18); box-shadow: 0 44px 90px -48px rgba(45, 34, 23, 0.5); }
  .credentials-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; transform: scale(1.04); }
  .vertical-word { position: absolute; right: 2%; top: 2%; margin: 0; color: rgba(71, 60, 49, 0.1); font-size: 70px; font-weight: 300; letter-spacing: 0.08em; writing-mode: vertical-rl; }
  .quote-card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(390px, 74%);
    padding: 32px 34px;
    border-radius: 22px 22px 4px 22px;
    background: rgba(17, 15, 13, 0.92);
    color: #fff;
    box-shadow: 0 30px 70px rgba(57, 45, 31, 0.25);
    backdrop-filter: blur(16px);
  }
  .quote-mark { display: block; height: 42px; color: var(--champagne); font-family: 'Playfair Display', serif; font-size: 70px; line-height: 0.8; }
  .quote-card blockquote { margin: 14px 0 0; font-family: 'Playfair Display', serif; font-size: 18px; font-style: italic; line-height: 1.55; }

  .credentials-copy { position: relative; }
  .credentials-copy .section-number { position: absolute; top: 7px; right: 0; }
  .credentials-copy h2 { margin-bottom: 42px; }
  .credential-list { list-style: none; margin: 0 0 26px; padding: 0; border-top: 1px solid var(--line-light); }
  .credential-list li {
    position: relative;
    min-height: 62px;
    padding: 13px 6px 13px 0;
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 20px;
    align-items: center;
    border-bottom: 1px solid var(--line-light);
    transition: padding-left 0.3s var(--ease-out), background 0.3s ease;
  }
  .credential-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 2px;
    background: var(--bronze);
    transform: translateY(-50%);
    transition: height 0.35s var(--ease-out);
  }
  .credential-list li:hover { padding-left: 16px; background: rgba(255, 255, 255, 0.42); }
  .credential-list li:hover::before { height: 60%; }
  .credential-list span { color: var(--bronze); font-family: ui-monospace, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .credential-list p { margin: 0; color: #4f4942; font-size: 14px; line-height: 1.5; }

  .credential-badges { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 9px; margin: 0 0 24px; }
  .credential-badges a {
    min-height: 74px;
    padding: 12px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(59, 48, 38, 0.1);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.62);
    transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  .has-js .reveal.is-visible .credential-badges a { transition: opacity 0.6s ease calc(var(--i, 0) * 55ms + 0.12s), transform 0.3s ease, background 0.25s ease, box-shadow 0.25s ease; }
  .credential-badges a:hover { transform: translateY(-3px); background: #fff; box-shadow: 0 16px 35px -24px rgba(48, 37, 26, 0.55); }
  .credential-badges img { max-width: 100%; max-height: 44px; object-fit: contain; filter: grayscale(1); opacity: 0.68; transition: filter 0.25s ease, opacity 0.25s ease; }
  .credential-badges a:hover img { filter: grayscale(0); opacity: 1; }

  .text-link { min-height: 44px; display: inline-flex; align-items: center; gap: 18px; color: #28231e; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .text-link svg { transition: transform 0.25s ease; }
  .text-link:hover svg { transform: translateX(6px); }

  /* ═══ Ethos ═══════════════════════════════════════════════════════════ */
  .ethos-section {
    position: relative;
    overflow: hidden;
    padding: 108px var(--gutter);
    background: linear-gradient(180deg, #0b0a09, #100e0c);
    border-top: 1px solid rgba(216, 189, 150, 0.12);
  }
  .ethos-section::before {
    content: '';
    position: absolute;
    inset: auto 0 -55% 0;
    height: 110%;
    background: radial-gradient(ellipse at 50% 100%, rgba(184, 139, 84, 0.18), transparent 62%);
    pointer-events: none;
  }
  .ethos-inner { position: relative; display: grid; gap: 54px; justify-items: center; text-align: center; }
  .ethos-line { margin: 0; max-width: 20ch; font-family: 'Manrope', sans-serif; font-size: clamp(30px, 4vw, 58px); font-weight: 600; letter-spacing: -0.05em; line-height: 1.08; }
  .ethos-line em { display: block; color: var(--champagne); font-family: 'Playfair Display', serif; font-weight: 500; font-style: italic; }
  .ethos-pillars { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .ethos-pillars > div {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: 30px 22px;
    display: grid;
    gap: 16px;
    justify-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.028);
  }
  .ethos-pillars > div::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(300px circle at var(--mx) var(--my), rgba(216, 189, 150, 0.14), transparent 65%);
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .ethos-pillars > div:hover::before { opacity: 1; }
  .ethos-pillars > div:hover { border-color: rgba(216, 189, 150, 0.32); }
  .ethos-pillars svg { position: relative; width: 34px; fill: none; stroke: var(--champagne); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .ethos-pillars strong { position: relative; color: rgba(255, 255, 255, 0.86); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; line-height: 1.6; text-transform: uppercase; }

  /* ═══ Connect ═════════════════════════════════════════════════════════ */
  .connect-section {
    position: relative;
    padding: 142px var(--gutter) 34px;
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 50px 8vw;
    overflow: hidden;
    background: radial-gradient(circle at 14% 8%, rgba(102, 72, 43, 0.22), transparent 28%), #090807;
    color: #fff;
  }
  .connect-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.24;
    background: radial-gradient(circle at 80% 20%, rgba(173, 123, 72, 0.18), transparent 34%),
      repeating-linear-gradient(110deg, transparent 0 150px, rgba(216, 189, 150, 0.11) 151px 152px, transparent 153px 300px);
  }
  .connect-copy,
  .contact-list,
  .qr-card,
  footer { position: relative; z-index: 1; }
  .connect-copy h2 { margin-bottom: 28px; }
  .connect-copy h2 em { color: var(--champagne); }
  .connect-copy > p:not(.section-kicker) { max-width: 450px; margin: 0; color: rgba(255, 255, 255, 0.52); font-size: 16px; line-height: 1.7; }

  .contact-list { padding: 8px; border: 1px solid var(--line-dark); border-radius: 24px; background: rgba(255, 255, 255, 0.025); }
  .contact-list > a {
    min-height: 86px;
    padding: 11px 15px;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 28px;
    gap: 18px;
    align-items: center;
    border-bottom: 1px solid rgba(216, 189, 150, 0.12);
    border-radius: 16px;
  }
  .has-js .reveal.is-visible.contact-list > a { transition: opacity 0.6s ease calc(var(--i, 0) * 55ms + 0.12s), transform 0.5s var(--ease-out), background 0.25s ease, padding 0.25s ease; }
  .contact-list > a:last-child { border-bottom: 0; }
  .contact-list > a:hover { padding-inline: 20px; background: rgba(216, 189, 150, 0.075); }
  .contact-icon { width: 50px; height: 50px; border: 1px solid rgba(255, 255, 255, 0.2); color: var(--champagne); transition: border-color 0.25s ease, background 0.25s ease; }
  .contact-list > a:hover .contact-icon { border-color: rgba(216, 189, 150, 0.5); background: rgba(216, 189, 150, 0.1); }
  .linkedin-icon { font-family: 'Inter', sans-serif; font-size: 21px; font-weight: 700; }
  .contact-text { display: grid; gap: 6px; }
  .contact-list small { color: rgba(255, 255, 255, 0.42); font-size: 9px; letter-spacing: 0.19em; text-transform: uppercase; }
  .contact-list strong { font-size: 15px; font-weight: 500; letter-spacing: 0.015em; }
  .contact-list .action-arrow { color: var(--champagne); transition: transform 0.25s ease; }
  .contact-list a:hover .action-arrow { transform: translateX(5px); }

  .qr-card {
    grid-column: 1 / -1;
    margin-top: 30px;
    padding: 34px;
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 38px;
    align-items: center;
