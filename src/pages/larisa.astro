---
import '../styles/global.css';

const origin = 'https://www.bridgeconsult.uz';
const pageUrl = `${origin}/larisa/`;
const shortUrl = 'bridgeconsult.uz/larisa';
const pageTitle = 'Лариса Белоусова — Founder & Director, BRIDGE Consult';
const pageDescription =
  'Лариса Белоусова — специалист по инфраструктурным контрактам: FIDIC, EPC/EPC+F, закупки, claims, предотвращение и разрешение споров. Визитная карточка, контакты и CV.';
const year = new Date().getFullYear();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Larisa K. Belousova',
  alternateName: ['Лариса Константиновна Белоусова', 'Larisa Belousova'],
  jobTitle: 'Founder & Director',
  description:
    'Infrastructure contracts specialist with 27+ years of experience, supporting governments, international financial institutions and private clients in the delivery of complex infrastructure projects.',
  url: pageUrl,
  image: `${origin}/larisa-belousova.jpg`,
  email: 'mailto:mail@lkbelousova.ru',
  telephone: '+998330001530',
  worksFor: {
    '@type': 'Organization',
    name: 'BRIDGE Consult LLC',
    url: origin
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tashkent',
    addressCountry: 'UZ'
  },
  knowsAbout: [
    'FIDIC contracts',
    'EPC / EPC+F',
    'Construction claims',
    'Dispute avoidance',
    'Dispute boards (DB/DAAB)',
    'Public procurement',
    'Infrastructure projects'
  ],
  knowsLanguage: ['ru', 'en', 'uz'],
  sameAs: ['https://www.linkedin.com/in/larissalk', origin]
};
---

<!doctype html>
<html lang="ru" data-language="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0c0b" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${origin}/larisa-belousova.jpg`} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="uz_UZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      /* Язык выбирается до первой отрисовки — страница не мигает. */
      (function () {
        var root = document.documentElement;
        root.classList.add('has-js');
        var allowed = ['ru', 'en', 'uz'];
        var chosen = 'ru';
        try {
          var saved = localStorage.getItem('larisa-language');
          if (allowed.indexOf(saved) > -1) chosen = saved;
        } catch (e) {}
        root.dataset.language = chosen;
        root.lang = chosen;
      })();
    </script>
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"><span></span></div>

    <a class="skip-link" href="#about"><span data-lang="ru">Перейти к содержанию</span><span data-lang="en">Skip to content</span><span data-lang="uz">Kontentga o‘tish</span></a>

    <header class="site-nav" aria-label="Bridge Consult">
      <a class="brand" href="/" aria-label="Bridge Consult">
        <img src="/bridge 2.svg" alt="Bridge Consult" width="160" height="60" />
      </a>
      <nav class="nav-links" aria-label="Разделы страницы">
        <a href="#about" data-nav-link><span data-lang="ru">Обо мне</span><span data-lang="en">About</span><span data-lang="uz">Men haqimda</span></a>
        <a href="#expertise" data-nav-link><span data-lang="ru">Экспертиза</span><span data-lang="en">Expertise</span><span data-lang="uz">Ekspertiza</span></a>
        <a href="#credentials" data-nav-link><span data-lang="ru">Квалификации</span><span data-lang="en">Credentials</span><span data-lang="uz">Malakalar</span></a>
      </nav>
      <div class="nav-actions">
        <div class="language-switcher" role="group" aria-label="Language / Язык / Til" data-language-switcher>
          <span class="language-thumb" aria-hidden="true"></span>
          <button type="button" data-language-button="ru" aria-pressed="true" lang="ru">RU</button>
          <button type="button" data-language-button="en" aria-pressed="false" lang="en">EN</button>
          <button type="button" data-language-button="uz" aria-pressed="false" lang="uz">UZ</button>
        </div>
        <a class="nav-contact" href="#connect" aria-label="Связаться / Connect / Bog‘lanish">
          <span data-lang="ru">Связаться</span><span data-lang="en">Connect</span><span data-lang="uz">Bog‘lanish</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </header>

    <main>
      <section class="hero" id="about">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-monogram" aria-hidden="true">L·B</div>

        <div class="portrait-stage hero-enter" data-tilt>
          <div class="portrait-index" aria-hidden="true"><span>01</span> Executive profile</div>
          <div class="portrait-frame" data-parallax-frame>
            <img src="/larisa-belousova.jpg" alt="Лариса Константиновна Белоусова" width="854" height="1280" fetchpriority="high" />
            <div class="portrait-wash"></div>
            <div class="portrait-sheen" aria-hidden="true"></div>
            <div class="portrait-caption">
              <span>BRIDGE Consult LLC</span>
              <span>Tashkent · Uzbekistan</span>
            </div>
          </div>
          <div class="orbit orbit-one" aria-hidden="true"></div>
          <span class="coordinates" aria-hidden="true">41.2995° N&nbsp;&nbsp; 69.2401° E</span>
          <div class="portrait-seal" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs><path id="seal-path" d="M60,60 m-43,0 a43,43 0 1,1 86,0 a43,43 0 1,1 -86,0" /></defs>
              <text><textPath href="#seal-path">BRIDGE CONSULT · TASHKENT · WORLDWIDE · </textPath></text>
              <path class="seal-mark" d="M38 62h44M67 47l15 15-15 15" />
            </svg>
          </div>
        </div>

        <div class="hero-copy">
          <div class="hero-status hero-enter" style="--delay: .06s">
            <span class="status-dot"></span>
            <span data-lang="ru">Ташкент · международные проекты</span>
            <span data-lang="en">Tashkent · international projects</span>
            <span data-lang="uz">Toshkent · xalqaro loyihalar</span>
          </div>
          <div class="eyebrow hero-enter" style="--delay: .1s">
            <span class="eyebrow-line"></span>
            <span data-lang="ru">Основатель и директор</span>
            <span data-lang="en">Founder &amp; Director</span>
            <span data-lang="uz">Asoschi va direktor</span>
          </div>
          <h1 class="hero-title hero-enter" style="--delay: .18s">
            <span>Larisa K.</span>
            <em>Belousova</em>
          </h1>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="ru">
            Специалист по инфраструктурным контрактам с опытом более 27 лет. Сопровождаю государственные органы, международные финансовые институты и частных клиентов в успешной реализации сложных инфраструктурных проектов.
          </p>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="en">
            An infrastructure contracts specialist with 27+ years of experience, supporting governments, international financial institutions and private clients in the successful delivery of complex infrastructure projects.
          </p>
          <p class="hero-lead hero-enter" style="--delay: .28s" data-lang="uz">
            Infratuzilma shartnomalari bo‘yicha 27 yildan ortiq tajribaga ega mutaxassis. Davlat organlari, xalqaro moliya institutlari va xususiy mijozlarga murakkab infratuzilma loyihalarini muvaffaqiyatli amalga oshirishda ko‘maklashaman.
          </p>

          <div class="hero-credentials hero-enter" style="--delay: .32s" aria-label="Ключевые квалификации">
            <span>FCCE</span><i aria-hidden="true"></i><span>FCCP</span><i aria-hidden="true"></i><span>ADB Accredited</span><i aria-hidden="true"></i><span>MCIArb</span><i aria-hidden="true"></i><span>DRBF</span>
          </div>

          <div class="hero-actions hero-enter" style="--delay: .36s">
            <a class="primary-action magnetic" href="/larisa-contact.vcf" data-save-contact>
              <span class="action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M15 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M8.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" /></svg>
              </span>
              <span class="action-text"
                ><strong data-contact-label data-lang="ru">Добавить в контакты</strong><strong data-contact-label data-lang="en">Add to contacts</strong><strong data-contact-label data-lang="uz">Kontaktga qo‘shish</strong
                ><small data-lang="ru">Откроется карточка контакта</small><small data-lang="en">Opens your contact card</small><small data-lang="uz">Kontakt kartasi ochiladi</small></span
              >
              <svg class="action-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="secondary-action magnetic" href="https://wa.me/998330001530" target="_blank" rel="noopener" aria-label="WhatsApp — Larisa Belousova">
              <span class="action-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.4-4.7A8.5 8.5 0 1 1 20.5 11.6ZM8.3 7.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.9 2.1c.1.3 0 .5-.2.8l-.7.8c-.2.2-.1.5 0 .7.7 1.2 1.7 2.2 3 2.9.2.1.5.1.7-.1l.9-1c.2-.2.5-.3.8-.2l2 .9c.3.1.4.3.4.6 0 .5-.2 1.5-.8 2-.6.5-1.4.8-2.3.6-1-.2-2.4-.7-4.1-1.8-2.5-1.6-4.1-4-4.5-5.1-.4-1.1 0-2.4.5-2.9l.7-.3Z" /></svg
              ></span>
              <span class="action-text"
                ><strong>WhatsApp</strong><small data-lang="ru">Написать напрямую</small><small data-lang="en">Message directly</small><small data-lang="uz">To‘g‘ridan-to‘g‘ri yozing</small></span
              >
            </a>
          </div>

          <div class="stats hero-enter" style="--delay: .44s" aria-label="Опыт и охват">
            <div><strong><span data-count="27">27</span>+</strong><span data-lang="ru">лет опыта</span><span data-lang="en">years of experience</span><span data-lang="uz">yillik tajriba</span></div>
            <div><strong><span data-count="15">15</span>+</strong><span data-lang="ru">лет в международных проектах</span><span data-lang="en">years in international projects</span><span data-lang="uz">yil xalqaro loyihalarda</span></div>
            <div><strong><span data-count="600">600</span>+</strong><span data-lang="ru">обученных специалистов</span><span data-lang="en">specialists trained</span><span data-lang="uz">o‘qitilgan mutaxassis</span></div>
            <div><strong><span data-count="10">10</span>+</strong><span data-lang="ru">стран</span><span data-lang="en">countries</span><span data-lang="uz">davlat</span></div>
          </div>
        </div>

        <a class="scroll-cue" href="#expertise" aria-label="К разделу «Экспертиза»">
          <span data-lang="ru">Смотреть профиль</span><span data-lang="en">Explore profile</span><span data-lang="uz">Profilni ko‘rish</span>
          <i aria-hidden="true"></i>
        </a>
      </section>

      <section class="profile-section" id="expertise">
        <div class="section-intro reveal">
          <div class="section-number">01</div>
          <div>
            <p class="section-kicker" data-lang="ru">Ключевая экспертиза</p>
            <p class="section-kicker" data-lang="en">Key expertise</p>
            <p class="section-kicker" data-lang="uz">Asosiy ekspertiza</p>
            <h2 data-lang="ru">Контракты, которые<br /><span class="title-accent">работают на проект.</span></h2>
            <h2 data-lang="en">Contracts that<br /><span class="title-accent">work for the project.</span></h2>
            <h2 data-lang="uz">Loyiha uchun<br /><span class="title-accent">ishlaydigan shartnomalar.</span></h2>
          </div>
          <p class="section-summary" data-lang="ru">Консультационная поддержка заказчиков, подрядчиков, инженеров и государственных органов на всём жизненном цикле крупных инфраструктурных проектов.</p>
          <p class="section-summary" data-lang="en">Advising employers, contractors, engineers and public authorities throughout the full lifecycle of major infrastructure projects.</p>
          <p class="section-summary" data-lang="uz">Yirik infratuzilma loyihalarining butun hayot sikli davomida buyurtmachilar, pudratchilar, muhandislar va davlat organlariga konsalting yordami.</p>
        </div>

        <div class="expertise-grid stagger">
          <article class="expertise-card reveal is-wide">
            <div class="card-top">
              <span class="card-index">01</span>
              <span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 38V10h32v28H8Zm7-20h18M15 25h18M15 32h10" /></svg></span>
            </div>
            <h3 data-lang="ru">Стратегия и подготовка контрактов</h3>
            <h3 data-lang="en">Contract strategy &amp; drafting</h3>
            <h3 data-lang="uz">Shartnoma strategiyasi va tayyorlash</h3>
            <div class="expertise-tags"><span>FIDIC</span><span>EPC / EPC+F</span><span>MDB Harmonised</span></div>
          </article>
          <article class="expertise-card reveal is-wide">
            <div class="card-top">
              <span class="card-index">02</span>
              <span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 39 24 8l15 31H9Zm15-20v9m0 5v.5" /></svg></span>
            </div>
            <h3 data-lang="ru">Claims и предотвращение споров</h3>
            <h3 data-lang="en">Claims &amp; dispute avoidance</h3>
            <h3 data-lang="uz">Claims va nizolarning oldini olish</h3>
            <div class="expertise-tags"><span>DB / DAAB</span><span>Mediation</span><span>Arbitration</span></div>
          </article>
          <article class="expertise-card reveal">
            <div class="card-top">
              <span class="card-index">03</span>
              <span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38h28M14 38V20h20v18M19 20v-6h10v6M20 27h8" /></svg></span>
            </div>
            <h3 data-lang="ru">Закупки и управление рисками</h3>
            <h3 data-lang="en">Procurement &amp; risk management</h3>
            <h3 data-lang="uz">Xaridlar va risklarni boshqarish</h3>
            <div class="expertise-tags"><span>Tendering</span><span>Variations</span><span>Commercial risk</span></div>
          </article>
          <article class="expertise-card reveal">
            <div class="card-top">
              <span class="card-index">04</span>
              <span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6 9 13v10c0 9 6.4 16.3 15 19 8.6-2.7 15-10 15-19V13L24 6Zm-6 18 4.5 4.5L31 20" /></svg></span>
            </div>
            <h3 data-lang="ru">Стратегический советник по контрактам</h3>
            <h3 data-lang="en">Strategic contract advisor</h3>
            <h3 data-lang="uz">Strategik shartnoma maslahatchisi</h3>
            <p class="card-note" data-lang="ru">Заказчикам, подрядчикам и другим участникам проекта.</p>
            <p class="card-note" data-lang="en">To employers, contractors and other project parties.</p>
            <p class="card-note" data-lang="uz">Buyurtmachilar, pudratchilar va boshqa loyiha ishtirokchilariga.</p>
            <div class="expertise-tags"><span>Employers</span><span>Contractors</span><span>Project parties</span></div>
          </article>
          <article class="expertise-card reveal">
            <div class="card-top">
              <span class="card-index">05</span>
              <span class="card-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 10 6 18l18 8 18-8-18-8Zm-11 12v9c0 3.3 4.9 6 11 6s11-2.7 11-6v-9M40 20v11" /></svg></span>
            </div>
            <h3 data-lang="ru">Обучение и развитие потенциала</h3>
            <h3 data-lang="en">Training &amp; capacity building</h3>
            <h3 data-lang="uz">O‘qitish va salohiyatni rivojlantirish</h3>
            <div class="expertise-tags"><span>FIDIC training</span><span>Workshops</span><span>Mentoring</span></div>
          </article>
        </div>
      </section>

      <section class="manifesto-section" aria-label="Подход к работе">
        <img class="manifesto-image" src="/hero-bg2.png" alt="" width="1917" height="853" loading="lazy" aria-hidden="true" />
        <div class="manifesto-shade" aria-hidden="true"></div>
        <div class="manifesto-content reveal">
          <div class="manifesto-copy">
            <p class="section-kicker" data-lang="ru">От сложности — к ясности</p>
            <p class="section-kicker" data-lang="en">From complexity to clarity</p>
            <p class="section-kicker" data-lang="uz">Murakkablikdan aniqlikka</p>
            <h2 data-lang="ru">Инфраструктура строится<br />на <span class="title-accent">сильных решениях.</span></h2>
            <h2 data-lang="en">Infrastructure is built<br />on <span class="title-accent">strong decisions.</span></h2>
            <h2 data-lang="uz">Infratuzilma <span class="title-accent">kuchli qarorlar</span><br />ustiga quriladi.</h2>
            <p class="manifesto-lead" data-lang="ru">Практический взгляд на контракт как на систему управления результатом — людьми, сроками, рисками и доверием.</p>
            <p class="manifesto-lead" data-lang="en">A practical view of the contract as a system for managing outcomes — people, time, risk and trust.</p>
            <p class="manifesto-lead" data-lang="uz">Shartnomaga natijani boshqarish tizimi sifatida amaliy qarash — odamlar, muddatlar, risklar va ishonch.</p>
          </div>
          <div class="principles stagger">
            <div>
              <div class="principle-top"><span>01</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></div>
              <strong data-lang="ru">Ясность до конфликта</strong><strong data-lang="en">Clarity before conflict</strong><strong data-lang="uz">Nizodan oldin aniqlik</strong>
            </div>
            <div>
              <div class="principle-top"><span>02</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7v5c0 4.7 3.3 7.8 8 9 4.7-1.2 8-4.3 8-9V7l-8-4Z" /></svg></div>
              <strong data-lang="ru">Риски под контролем</strong><strong data-lang="en">Risk under control</strong><strong data-lang="uz">Risklar nazorat ostida</strong>
            </div>
            <div>
              <div class="principle-top"><span>03</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11" /></svg></div>
              <strong data-lang="ru">Решения, которые работают</strong><strong data-lang="en">Decisions that deliver</strong><strong data-lang="uz">Natija beradigan qarorlar</strong>
            </div>
          </div>
        </div>
        <div class="manifesto-marquee" aria-hidden="true">
          <div>
            <span>FIDIC</span><i></i><span>EPC / EPC+F</span><i></i><span>CLAIMS</span><i></i><span>DISPUTE AVOIDANCE</span><i></i><span>PROCUREMENT</span><i></i>
            <span>FIDIC</span><i></i><span>EPC / EPC+F</span><i></i><span>CLAIMS</span><i></i><span>DISPUTE AVOIDANCE</span><i></i><span>PROCUREMENT</span><i></i>
          </div>
        </div>
      </section>

      <section class="credentials-section" id="credentials">
        <div class="credentials-visual reveal">
          <div class="credentials-photo">
            <img src="/larisa-belousova.jpg" alt="Лариса Белоусова, основатель BRIDGE Consult" width="854" height="1280" loading="lazy" />
          </div>
          <p class="vertical-word" aria-hidden="true">INTEGRITY</p>
          <div class="quote-card">
            <span class="quote-mark">“</span>
            <blockquote data-lang="ru">Сильный контракт создаёт не барьеры, а ясность, доверие и общий путь к результату.</blockquote>
            <blockquote data-lang="en">A strong contract creates not barriers, but clarity, trust and a shared path to results.</blockquote>
            <blockquote data-lang="uz">Kuchli shartnoma to‘siq emas — aniqlik, ishonch va natijaga umumiy yo‘l yaratadi.</blockquote>
          </div>
        </div>

        <div class="credentials-copy reveal">
          <div class="section-number">02</div>
          <p class="section-kicker" data-lang="ru">Профессиональный уровень</p>
          <p class="section-kicker" data-lang="en">Selected credentials</p>
          <p class="section-kicker" data-lang="uz">Tanlangan malakalar</p>
          <h2 data-lang="ru">Международные<br /><em>квалификации.</em></h2>
          <h2 data-lang="en">International<br /><em>credentials.</em></h2>
          <h2 data-lang="uz">Xalqaro<br /><em>malakalar.</em></h2>

          <ul class="credential-list stagger">
            <li>
              <span>FCCE</span>
              <p data-lang="ru">FIDIC Certified Consulting Engineer — сертифицированный инженер-консультант FIDIC</p>
              <p data-lang="en">FIDIC Certified Consulting Engineer</p>
              <p data-lang="uz">FIDIC Certified Consulting Engineer — FIDIC sertifikatlangan muhandis-konsultanti</p>
