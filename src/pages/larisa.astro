    <script is:inline>
      (() => {
        const body = document.body;
        const root = document.documentElement;
        const LANGS = ['ru', 'en', 'uz'];
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(pointer: fine)').matches;

        /* ── Language ─────────────────────────────────────────────── */
        const buttons = Array.from(document.querySelectorAll('[data-language-button]'));
        const switcher = document.querySelector('[data-language-switcher]');
        const meta = {
          ru: {
            title: 'Лариса Белоусова — основатель и директор BRIDGE Consult',
            description:
              'Лариса Белоусова — специалист по инфраструктурным контрактам: FIDIC, EPC/EPC+F, закупки, claims, предотвращение и разрешение споров.'
          },
          en: {
            title: 'Larisa Belousova — Founder & Director, BRIDGE Consult',
            description:
              'Larisa Belousova — infrastructure contracts specialist: FIDIC, EPC/EPC+F, procurement, claims, dispute avoidance and resolution.'
          },
          uz: {
            title: 'Larisa Belousova — BRIDGE Consult asoschisi va direktori',
            description:
              'Larisa Belousova — infratuzilma shartnomalari bo‘yicha mutaxassis: FIDIC, EPC/EPC+F, xaridlar, claims, nizolarning oldini olish va hal etish.'
          }
        };
        const descriptionTag = document.querySelector('meta[name="description"]');
        const labels = {
          contact: { ru: 'Добавить в контакты', en: 'Add to contacts', uz: 'Kontaktga qo‘shish' },
          contactBusy: { ru: 'Открываем контакт…', en: 'Opening contact…', uz: 'Kontakt ochilmoqda…' },
          copy: { ru: 'Копировать ссылку', en: 'Copy link', uz: 'Havolani nusxalash' },
          copied: { ru: 'Ссылка скопирована', en: 'Link copied', uz: 'Havola nusxalandi' }
        };

        const setLanguage = (language, persist) => {
          if (!LANGS.includes(language)) language = 'ru';
          root.dataset.language = language;
          root.lang = language;
          document.title = meta[language].title;
          if (descriptionTag) descriptionTag.setAttribute('content', meta[language].description);
          if (persist) {
            try {
              localStorage.setItem('larisa-language', language);
            } catch (e) {}
          }
          buttons.forEach((button, index) => {
            const active = button.dataset.languageButton === language;
            button.setAttribute('aria-pressed', String(active));
            if (active && switcher) switcher.style.setProperty('--active', String(index));
          });
        };

        buttons.forEach((button) =>
          button.addEventListener('click', () => {
            if (root.dataset.language === button.dataset.languageButton) return;
            body.classList.add('is-switching');
            setLanguage(button.dataset.languageButton, true);
            window.setTimeout(() => body.classList.remove('is-switching'), 320);
          })
        );
        /* Язык уже выбран встроенным скриптом в <head> — синхронизируем кнопки и мета-теги. */
        setLanguage(root.dataset.language, false);

        /* ── Scroll: progress, sticky nav, dock, parallax ─────────── */
        const progress = document.querySelector('.page-progress span');
        const frame = document.querySelector('[data-parallax-frame]');
        const contactDock = document.querySelector('[data-contact-dock]');
        let ticking = false;
        const updateScroll = () => {
          const scrollable = root.scrollHeight - window.innerHeight;
          if (progress) progress.style.transform = `scaleX(${scrollable > 0 ? window.scrollY / scrollable : 0})`;
          body.classList.toggle('is-scrolled', window.scrollY > 24);
          if (contactDock) contactDock.classList.toggle('is-visible', window.scrollY > Math.min(620, window.innerHeight * 0.7));
          if (frame && window.innerWidth > 820 && !reduced) {
            frame.style.setProperty('--parallax', `${Math.min(window.scrollY * 0.045, 36)}px`);
          }
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(updateScroll);
              ticking = true;
            }
          },
          { passive: true }
        );
        updateScroll();

        /* ── Pointer lighting ─────────────────────────────────────── */
        const hero = document.querySelector('.hero');
        if (hero && !reduced && finePointer) {
          hero.addEventListener('pointermove', (event) => {
            const rect = hero.getBoundingClientRect();
            hero.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
            hero.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
          });
        }

        if (!reduced && finePointer) {
          document.querySelectorAll('.expertise-card, .principles > div, .ethos-pillars > div').forEach((card) => {
            card.addEventListener('pointermove', (event) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
              card.style.setProperty('--my', `${event.clientY - rect.top}px`);
            });
          });
        }

        /* ── Portrait tilt ────────────────────────────────────────── */
        const tilt = document.querySelector('[data-tilt]');
        if (tilt && !reduced && finePointer) {
          tilt.addEventListener('pointermove', (event) => {
            const rect = tilt.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - 0.5;
            const y = (event.clientY - rect.top) / rect.height - 0.5;
            tilt.style.setProperty('--tilt-x', `${(-y * 4).toFixed(2)}deg`);
            tilt.style.setProperty('--tilt-y', `${(x * 5).toFixed(2)}deg`);
          });
          tilt.addEventListener('pointerleave', () => {
            tilt.style.setProperty('--tilt-x', '0deg');
            tilt.style.setProperty('--tilt-y', '0deg');
          });
        }

        /* ── Staggered reveals ────────────────────────────────────── */
        document.querySelectorAll('.stagger').forEach((group) => {
          Array.from(group.children).forEach((child, index) => child.style.setProperty('--i', String(index)));
        });

        const reveals = document.querySelectorAll('.reveal');
        if (!reduced && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
          );
          reveals.forEach((element) => observer.observe(element));
        } else {
          reveals.forEach((element) => element.classList.add('is-visible'));
        }

        /* ── Counters ─────────────────────────────────────────────── */
        const counters = document.querySelectorAll('[data-count]');
        if (!reduced && 'IntersectionObserver' in window) {
          const counterObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const node = entry.target;
                const target = Number(node.dataset.count);
                const duration = 1100;
                const start = performance.now();
                const step = (now) => {
                  const amount = Math.min((now - start) / duration, 1);
                  node.textContent = String(Math.round(target * (1 - Math.pow(1 - amount, 4))));
                  if (amount < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
                counterObserver.unobserve(node);
              });
            },
            { threshold: 0.8 }
          );
          counters.forEach((counter) => counterObserver.observe(counter));
        }

        /* ── Active section in the nav ────────────────────────────── */
        const navLinks = Array.from(document.querySelectorAll('[data-nav-link]'));
        const sections = navLinks.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
        if (sections.length && 'IntersectionObserver' in window) {
          const navObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                navLinks.forEach((link) => link.classList.toggle('is-current', link.getAttribute('href') === `#${entry.target.id}`));
              });
            },
            { rootMargin: '-45% 0px -50% 0px' }
          );
          sections.forEach((section) => navObserver.observe(section));
        }

        /* ── Magnetic buttons ─────────────────────────────────────── */
        if (!reduced && finePointer) {
          document.querySelectorAll('.magnetic').forEach((element) => {
            element.addEventListener('pointermove', (event) => {
              const rect = element.getBoundingClientRect();
              element.style.setProperty('--mag-x', `${((event.clientX - rect.left - rect.width / 2) * 0.07).toFixed(2)}px`);
              element.style.setProperty('--mag-y', `${((event.clientY - rect.top - rect.height / 2) * 0.07).toFixed(2)}px`);
            });
            element.addEventListener('pointerleave', () => {
              element.style.setProperty('--mag-x', '0px');
              element.style.setProperty('--mag-y', '0px');
            });
          });
        }

        /* ── Toast ────────────────────────────────────────────────── */
        const toast = document.querySelector('[data-toast]');
        let toastTimer;
        const showToast = (message) => {
          if (!toast) return;
          toast.textContent = message;
          toast.classList.add('is-visible');
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2400);
        };

        /* ── Save contact ─────────────────────────────────────────── */
        document.querySelectorAll('[data-save-contact]').forEach((link) => {
          link.addEventListener('click', () => {
            const language = root.dataset.language;
            link.classList.add('is-opening');
            link.querySelectorAll('[data-contact-label]').forEach((label) => {
              label.textContent = labels.contactBusy[label.dataset.lang] || labels.contactBusy.ru;
            });
            showToast(labels.contactBusy[language] || labels.contactBusy.ru);
            window.setTimeout(() => {
              link.classList.remove('is-opening');
              link.querySelectorAll('[data-contact-label]').forEach((label) => {
                label.textContent = labels.contact[label.dataset.lang] || labels.contact.ru;
              });
            }, 1800);
          });
        });

        /* ── Copy link ────────────────────────────────────────────── */
        const copyButton = document.querySelector('[data-copy-link]');
        if (copyButton) {
          copyButton.addEventListener('click', async () => {
            const language = root.dataset.language;
            const url = 'https://www.bridgeconsult.uz/larisa/';
            try {
              await navigator.clipboard.writeText(url);
            } catch (e) {
              const field = document.createElement('input');
              field.value = url;
              document.body.appendChild(field);
              field.select();
              try {
                document.execCommand('copy');
              } catch (err) {}
              field.remove();
            }
            copyButton.classList.add('is-copied');
            document.querySelectorAll('[data-copy-label]').forEach((label) => {
              label.textContent = labels.copied[label.dataset.lang] || labels.copied.ru;
            });
            showToast(labels.copied[language] || labels.copied.ru);
            window.setTimeout(() => {
              copyButton.classList.remove('is-copied');
              document.querySelectorAll('[data-copy-label]').forEach((label) => {
                label.textContent = labels.copy[label.dataset.lang] || labels.copy.ru;
              });
            }, 2000);
          });
        }
      })();
    </script>
  </body>
</html>

