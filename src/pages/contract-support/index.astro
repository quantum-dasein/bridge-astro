---
/**
 * Лендинг «Полное договорное сопровождение» — предложение подрядчикам.
 * Русская версия; EN и UZ лежат в en/ и uz/ и отличаются только данными.
 */
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import Offer from '../../components/offer/Offer.astro';
import { offerRu as c } from '../../data/offer.ru';
import { offerSchema } from '../../data/schema';
---

<AcademyLayout
	title={c.meta.title}
	description={c.meta.description}
	lang={c.lang}
	image="/academy-atmosphere.png"
	langLinks={c.langLinks}
	schema={offerSchema(c.lang, c.meta.title, c.meta.description, c.pillars.items.map((i) => i.title))}
>
	<Offer c={c} current="ru" />
</AcademyLayout>
