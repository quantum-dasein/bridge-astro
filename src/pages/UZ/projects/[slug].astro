---
import ProjectCasePage from '../../../components/ProjectCasePage.astro';
import { getProjectCases, type LocalizedProjectCase } from '../../../data/projectCaseLocales';

export const prerender = true;

export function getStaticPaths() {
	return getProjectCases('uz').map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

interface Props {
	project: LocalizedProjectCase;
}

const { project } = Astro.props;
---

<ProjectCasePage project={project} lang="uz" />
