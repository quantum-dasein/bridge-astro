---
// Страница одного термина словаря FIDIC.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import TelegramCta from './TelegramCta.astro';
import ExpertByline from './ExpertByline.astro';
import { faqJsonLd } from '../data/authors';
import { glossaryUrl, glossaryIndexUrl, GLOSSARY_T } from '../data/glossary';

interface Props {
	entry: CollectionEntry<'glossary'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const lang = (d.lang === 'en' || d.lang === 'uz' ? d.lang : 'ru') as 'ru' | 'en' | 'uz';
const t = GLOSSARY_T[lang];
const idSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '').replace(/^(ru|en|uz)-/, '');
const slug = idSlug(entry.id);
const origin = 'https://www.bridgeconsult.uz';
const langUrls = { ru: origin + glossaryUrl('ru', slug), en: origin + glossaryUrl('en', slug), uz: origin + glossaryUrl('uz', slug) };
const pageUrl = langUrls[lang];
const serpTitle = d.seoTitle ?? d.title;
const pageTitle = serpTitle.length + ' | Bridge Consult'.length <= 60 ? `${serpTitle} | Bridge Consult` : serpTitle;

const others = (await getCollection('glossary'))
	.filter((e) => (e.data.lang ?? 'ru') === lang && e.id !== entry.id)
	.sort((a, b) => a.data.term.localeCompare(b.data.term))
	.slice(0, 14);

// Статьи, где этот термин — главный герой: по названию и тегам.
const needles = [d.term, ...d.aliases].map((s) => s.toLowerCase());
const news = (await getCollection('news'))
	.filter((p) => (p.data.lang ?? 'ru') === lang)
	.filter((p) => needles.some((n) => p.data.title.toLowerCase().includes(n) || p.data.tags.some((tag) => tag.toLowerCase() === n)))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 4);
const newsUrl = (id: string) => {
	const s = id.replace(/\.(md|mdx)$/i, '');
	const base = s.replace(/^(ru|en|uz)-/, '');
	return lang === 'en' ? `/news/en/${base}/` : lang === 'uz' ? `/news/uz/${base}/` : `/news/${s}/`;
};

const termJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'DefinedTerm',
	'@id': pageUrl,
	name: d.term,
	alternateName: d.aliases,
	description: d.excerpt,
	url: pageUrl,
	inDefinedTermSet: { '@type': 'DefinedTermSet', name: t.title, url: origin + glossaryIndexUrl(lang) },
};
const crumbsJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Bridge Consult', item: origin + (lang === 'ru' ? '/' : `/${lang.toUpperCase()}/`) },
		{ '@type': 'ListItem', position: 2, name: t.title, item: origin + glossaryIndexUrl(lang) },
		{ '@type': 'ListItem', position: 3, name: d.term, item: pageUrl },
	],
};
---

<Layout title={pageTitle} description={d.metaDescription ?? d.excerpt} image={d.socialImage ?? '/og-image.jpg'} type="article" lang={lang}>
	<Fragment slot="head">
		<link rel="alternate" hreflang="ru" href={langUrls.ru} />
		<link rel="alternate" hreflang="en" href={langUrls.en} />
		<link rel="alternate" hreflang="uz" href={langUrls.uz} />
		<link rel="alternate" hreflang="x-default" href={langUrls.ru} />
		<meta property="article:modified_time" content={(d.updated ?? d.date).toISOString()} />
		<script type="application/ld+json" set:html={JSON.stringify(termJsonLd)}></script>
		<script type="application/ld+json" set:html={JSON.stringify(crumbsJsonLd)}></script>
		{d.faq?.length && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd(d.faq))}></script>}
	</Fragment>

	<SiteHeader lang={lang} langUrls={langUrls} />
	<article class="bg-bridge-light font-sans">
		<header class="relative overflow-hidden bg-bridge-dark pt-36 pb-16 md:pt-44 md:pb-20">
			<div class="pointer-events-none absolute left-1/2 top-1/2 z-[1] -translate-x-1/2 -translate-y-1/2" style="width:700px;height:700px;border-radius:9999px;background:radial-gradient(circle,rgba(138,123,102,0.2) 0%,transparent 60%);"></div>
			<div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
				<a href={glossaryIndexUrl(lang)} class="mb-8 inline-flex items-center text-xs font-bold uppercase tracking-[0.24em] text-bridge-taupe transition-colors hover:text-white">
					<svg class="mr-3 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
					{t.title}
				</a>
				<h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl">{d.title}</h1>
				<p class="mx-auto max-w-2xl text-base font-light leading-relaxed text-gray-300 md:text-lg">{d.excerpt}</p>
			</div>
		</header>

		<section class="relative py-12 md:py-16">
			<div class="relative z-10 mx-auto max-w-3xl px-6">
				<ExpertByline expert="larisa" lang={lang} updated={d.updated} />
				<div class="news-body"><Content /></div>

				{news.length > 0 && (
					<section class="mt-12">
						<h2 class="mb-5 flex items-center gap-3 text-xl font-bold text-bridge-dark"><span class="inline-block h-[3px] w-8 rounded-full bg-bridge-taupe"></span>{t.inArticles}</h2>
						<ul class="bc-term-news">
							{news.map((p) => <li><a href={newsUrl(p.id)}>{p.data.title}</a></li>)}
						</ul>
					</section>
				)}

				{others.length > 0 && (
					<section class="mt-12">
						<h2 class="mb-5 flex items-center gap-3 text-xl font-bold text-bridge-dark"><span class="inline-block h-[3px] w-8 rounded-full bg-bridge-taupe"></span>{t.other}</h2>
						<div class="bc-term-chips">
							{others.map((e) => <a href={glossaryUrl(lang, idSlug(e.id))}>{e.data.term}</a>)}
						</div>
					</section>
				)}
				<TelegramCta lang={lang} />
			</div>
		</section>
	</article>
	<SiteFooter lang={lang} />
</Layout>
