---
/**
 * Финальный экран-заявка на карбоне.
 *
 * Не карточка с формой, а целая тёмная секция: слева крупное утверждение,
 * справа форма на прозрачных полях с волосяными линейками вместо рамок.
 *
 * Отправляется на собственную функцию /api/apply (см. api/apply.js): она
 * рассылает заявку в Telegram и, если задан FORMSPREE_ID, дублирует на почту.
 * Скрытое поле source задаёт заголовок сообщения — без него заявка пришла бы
 * подписанной как летняя школа.
 *
 * Тексты состояний лежат в data-атрибутах формы: один скрипт обслуживает все
 * языковые версии.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	list: readonly string[];
	mailNote: string;
	source: string;
	submit: string;
	states: {
		sending: string;
		sendingNote: string;
		sent: string;
		successNote: string;
		errorNote: string;
		subject: string;
		sentFrom: string;
	};
	fields: any;
}

const { id = 'apply', label, title, lead, list, mailNote, source, submit, states, fields } =
	Astro.props;

const inputClass =
	'w-full min-w-0 border-0 border-b border-academy-paper/25 bg-transparent px-0 py-3 text-[0.95rem] font-light tracking-normal text-academy-paper normal-case transition-colors duration-300 outline-none placeholder:text-academy-paper/30 focus:border-academy-brass';
const labelClass = 'grid min-w-0 gap-1 academy-mark text-academy-paper/40';
---

<section id={id} class="relative bg-academy-carbon px-6 py-20 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-12 border-t border-academy-paper/20 pt-8 lg:gap-x-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>

			<div class="col-span-12 lg:col-span-5 lg:col-start-3">
				<h2
					class="academy-reveal max-w-[16ch] font-serif text-[clamp(2rem,3.8vw,3.2rem)] leading-[1.06] font-normal tracking-[-0.03em] text-balance"
				>
					{title}
				</h2>
				<p class="academy-reveal mt-6 max-w-[44ch] text-[0.95rem] leading-relaxed font-light text-academy-paper/60">
					{lead}
				</p>

				<ul class="mt-9">
					{
						list.map((item, i) => (
							<li class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-t border-academy-paper/12 py-3.5 text-[0.88rem] font-light text-academy-paper/75">
								<span class="academy-mark text-academy-paper/30">{String(i + 1).padStart(2, '0')}</span>
								<span>{item}</span>
							</li>
						))
					}
				</ul>

				<p class="mt-7 text-[0.88rem] font-light text-academy-paper/60">
					{mailNote}{' '}
					<a
						href="mailto:info@bridgeconsult.uz"
						class="text-academy-brass underline-offset-4 transition-colors hover:text-white hover:underline"
						>info@bridgeconsult.uz</a
					>
				</p>
			</div>

			<form
				id="academyApplyForm"
				method="POST"
				data-subject={states.subject}
				data-sent-from={states.sentFrom}
				data-sending={states.sending}
				data-sending-note={states.sendingNote}
				data-sent={states.sent}
				data-success-note={states.successNote}
				data-error-note={states.errorNote}
				class="academy-reveal col-span-12 grid gap-6 lg:col-span-4 lg:col-start-9"
			>
				<input type="hidden" name="source" value={source} />

				<label class={labelClass}>
					{fields.name.label}
					<input name="name" autocomplete="name" required placeholder={fields.name.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.role.label}
					<input name="role" autocomplete="organization-title" placeholder={fields.role.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.contact.label}
					<input name="contact" autocomplete="tel" required placeholder={fields.contact.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.programme.label}
					<select name="programme" class={inputClass}>
						{fields.programme.options.map((o: string) => <option class="bg-academy-carbon">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.participants.label}
					<select name="participants" class={inputClass}>
						{fields.participants.options.map((o: string) => <option class="bg-academy-carbon">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.language.label}
					<select name="language" class={inputClass}>
						{fields.language.options.map((o: string) => <option class="bg-academy-carbon">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.cases.label}
					<textarea name="cases_to_discuss" rows="3" placeholder={fields.cases.placeholder} class={`${inputClass} resize-y`}></textarea>
				</label>

				<label class={labelClass}>
					{fields.message.label}
					<textarea name="message" rows="2" placeholder={fields.message.placeholder} class={`${inputClass} resize-y`}></textarea>
				</label>

				<!-- Ловушка для ботов: не display:none — часть ботов такие поля пропускает.
				     Заполненную ловушку /api/apply не выбрасывает, а помечает. -->
				<input
					type="text"
					name="hp_ref"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
					class="absolute -left-[9999px] h-px w-px opacity-0"
				/>

				<button
					type="submit"
					class="mt-2 inline-flex min-h-[3.4rem] w-full cursor-pointer items-center justify-center rounded-full bg-academy-champagne px-8 text-[0.75rem] font-semibold tracking-[0.16em] text-[#17130A] uppercase transition-colors duration-300 hover:bg-white disabled:cursor-default disabled:opacity-50"
				>
					{submit}
				</button>

				<p
					id="academyFormNote"
					role="status"
					aria-live="polite"
					class="min-h-[1.4em] text-[0.78rem] leading-relaxed font-light text-academy-paper/60"
				>
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const LEAD_EMAIL = 'info@bridgeconsult.uz';
	const form = document.getElementById('academyApplyForm') as HTMLFormElement | null;
	const note = document.getElementById('academyFormNote');

	if (form && note) {
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		const idle = button.textContent ?? '';

		// Запасной вариант: подписи берём у самих <label>, поэтому письмо
		// автоматически выходит на языке страницы.
		const buildMailto = (data: FormData) => {
			const lines: string[] = [];
			form.querySelectorAll<HTMLInputElement>('input[name], select[name], textarea[name]').forEach((field) => {
				const name = field.getAttribute('name');
				if (!name || name === 'hp_ref') return;
				const value = (data.get(name) ?? '').toString().trim();
				if (!value) return;
				const label = field.closest('label');
				const caption = label?.childNodes[0]?.textContent?.trim() ?? name;
				lines.push(`${caption}: ${value}`);
			});
			const body = `${lines.join('\n')}\n\n${form.dataset.sentFrom} ${location.href}`;
			return `mailto:${LEAD_EMAIL}?subject=${encodeURIComponent(form.dataset.subject ?? '')}&body=${encodeURIComponent(body)}`;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			button.disabled = true;
			button.textContent = form.dataset.sending ?? '';
			note.textContent = form.dataset.sendingNote ?? '';

			try {
				const response = await fetch('/api/apply', {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' },
				});
				if (!response.ok) throw new Error(`/api/apply вернул ${response.status}`);
				form.reset();
				note.textContent = form.dataset.successNote ?? '';
				button.textContent = form.dataset.sent ?? idle;
			} catch {
				// Функция недоступна — заявка не должна пропасть.
				location.href = buildMailto(data);
				note.textContent = (form.dataset.errorNote ?? '').replace('{email}', LEAD_EMAIL);
				button.disabled = false;
				button.textContent = idle;
			}
		});
	}
</script>
