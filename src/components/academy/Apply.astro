---
/**
 * Форма заявки.
 *
 * Отправляется на собственную функцию /api/apply (см. api/apply.js): она
 * рассылает заявку в Telegram и, если задан FORMSPREE_ID, дублирует на почту.
 * Скрытое поле source задаёт заголовок сообщения в Telegram — без него заявка
 * пришла бы подписанной как летняя школа.
 *
 * Тексты состояний лежат в data-атрибутах формы: один скрипт обслуживает все
 * языковые версии.
 *
 * data-anim: label · title · lead · apply-item · apply-form
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	list: readonly string[];
	mailNote: string;
	source: string;
	submit: string;
	states: {
		sending: string;
		sendingNote: string;
		sent: string;
		successNote: string;
		errorNote: string;
		subject: string;
		sentFrom: string;
	};
	fields: any;
}

const { id = 'apply', label, title, lead, list, mailNote, source, submit, states, fields } =
	Astro.props;

const inputClass =
	'w-full min-w-0 rounded-sm border border-white/[0.08] bg-black/35 px-4 py-3.5 text-[0.95rem] font-light tracking-normal text-gray-100 normal-case transition-all duration-300 outline-none placeholder:text-gray-600 focus:border-academy-gold focus:bg-black/50 focus:ring-2 focus:ring-academy-gold/15';
const labelClass =
	'grid min-w-0 gap-2 text-[10.5px] font-medium tracking-[0.16em] text-gray-400 uppercase';
---

<section id={id} class="relative border-t border-white/10 py-24 lg:py-32">
	<div class="mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:gap-20">
			<div>
				<SectionLabel text={label} />
				<h2
					data-anim="title"
					class="mb-6 max-w-[18ch] font-serif text-[clamp(1.9rem,3.2vw,2.9rem)] leading-tight font-medium tracking-[-0.02em] text-white text-balance"
				>
					{title}
				</h2>
				<p data-anim="lead" class="max-w-[46ch] text-[1rem] leading-relaxed font-light text-gray-300">
					{lead}
				</p>

				<ul class="mt-9">
					{
						list.map((item) => (
							<li
								data-anim="apply-item"
								class="relative border-t border-white/[0.06] py-4 pl-7 text-[0.95rem] font-light text-gray-300 before:absolute before:top-[1.6rem] before:left-0 before:h-px before:w-3.5 before:bg-academy-gold"
							>
								{item}
							</li>
						))
					}
				</ul>

				<p class="mt-7 text-[0.95rem] font-light text-gray-300">
					{mailNote}{' '}
					<a
						href="mailto:info@bridgeconsult.uz"
						class="text-academy-gold-soft transition-colors hover:text-academy-gold">info@bridgeconsult.uz</a
					>
				</p>
			</div>

			<form
				data-anim="apply-form"
				id="academyApplyForm"
				method="POST"
				data-subject={states.subject}
				data-sent-from={states.sentFrom}
				data-sending={states.sending}
				data-sending-note={states.sendingNote}
				data-sent={states.sent}
				data-success-note={states.successNote}
				data-error-note={states.errorNote}
				class="grid gap-4 rounded-sm border border-white/10 bg-white/[0.035] p-7 shadow-[0_44px_100px_-44px_rgba(0,0,0,0.95)] backdrop-blur-md lg:p-10"
			>
				<input type="hidden" name="source" value={source} />

				<label class={labelClass}>
					{fields.name.label}
					<input name="name" autocomplete="name" required placeholder={fields.name.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.role.label}
					<input name="role" autocomplete="organization-title" placeholder={fields.role.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.contact.label}
					<input name="contact" autocomplete="tel" required placeholder={fields.contact.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.programme.label}
					<select name="programme" class={inputClass}>
						{fields.programme.options.map((o: string) => <option class="bg-[#f3eee4] text-[#17130c]">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.participants.label}
					<select name="participants" class={inputClass}>
						{fields.participants.options.map((o: string) => <option class="bg-[#f3eee4] text-[#17130c]">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.language.label}
					<select name="language" class={inputClass}>
						{fields.language.options.map((o: string) => <option class="bg-[#f3eee4] text-[#17130c]">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.cases.label}
					<textarea name="cases_to_discuss" rows="4" placeholder={fields.cases.placeholder} class={`${inputClass} resize-y`}
					></textarea>
				</label>

				<label class={labelClass}>
					{fields.message.label}
					<textarea name="message" rows="3" placeholder={fields.message.placeholder} class={`${inputClass} resize-y`}
					></textarea>
				</label>

				<!-- Ловушка для ботов: не display:none — часть ботов такие поля пропускает.
				     Заполненную ловушку /api/apply не выбрасывает, а помечает. -->
				<input
					type="text"
					name="hp_ref"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
					class="absolute -left-[9999px] h-px w-px opacity-0"
				/>

				<button
					type="submit"
					class="mt-2 inline-flex min-h-[3.25rem] w-full cursor-pointer items-center justify-center rounded-sm bg-gradient-to-r from-academy-gold-soft via-academy-gold to-[#96793F] px-8 text-[11px] font-semibold tracking-[0.18em] text-academy-ink uppercase shadow-[0_8px_30px_-10px_rgba(197,168,128,0.35)] transition-shadow duration-300 hover:shadow-[0_14px_44px_-10px_rgba(197,168,128,0.5)] disabled:cursor-default disabled:opacity-50"
				>
					{submit}
				</button>

				<p class="min-h-[1.5em] text-[0.82rem] leading-relaxed font-light text-gray-400" id="academyFormNote" role="status" aria-live="polite"></p>
			</form>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		var LEAD_EMAIL = 'info@bridgeconsult.uz';
		var form = document.getElementById('academyApplyForm');
		var note = document.getElementById('academyFormNote');
		if (!form || !note) return;
		var button = form.querySelector('button[type="submit"]');
		var idle = button.textContent;

		// Запасной вариант: подписи берём у самих <label>, поэтому письмо
		// автоматически выходит на языке страницы.
		function buildMailto(data) {
			var lines = [];
			form.querySelectorAll('input[name], select[name], textarea[name]').forEach(function (field) {
				var name = field.getAttribute('name');
				if (!name || name === 'hp_ref') return;
				var value = (data.get(name) || '').toString().trim();
				if (!value) return;
				var label = field.closest('label');
				var caption = label ? label.childNodes[0].textContent.trim() : name;
				lines.push(caption + ': ' + value);
			});
			var body = lines.join('\n') + '\n\n' + form.dataset.sentFrom + ' ' + location.href;
			return (
				'mailto:' + LEAD_EMAIL + '?subject=' + encodeURIComponent(form.dataset.subject) + '&body=' + encodeURIComponent(body)
			);
		}

		form.addEventListener('submit', async function (event) {
			event.preventDefault();
			var data = new FormData(form);
			button.disabled = true;
			button.textContent = form.dataset.sending;
			note.textContent = form.dataset.sendingNote;

			try {
				var response = await fetch('/api/apply', {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' },
				});
				if (!response.ok) throw new Error('/api/apply вернул ' + response.status);
				form.reset();
				note.textContent = form.dataset.successNote;
				button.textContent = form.dataset.sent;
			} catch (e) {
				// Функция недоступна — заявка не должна пропасть.
				location.href = buildMailto(data);
				note.textContent = (form.dataset.errorNote || '').replace('{email}', LEAD_EMAIL);
				button.disabled = false;
				button.textContent = idle;
			}
		});
	})();
</script>
