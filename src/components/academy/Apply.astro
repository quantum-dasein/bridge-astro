---
/**
 * Форма заявки.
 *
 * Отправляется на собственную функцию /api/apply (см. api/apply.js): она
 * рассылает заявку в Telegram и, если задан FORMSPREE_ID, дублирует на почту.
 * Скрытое поле source задаёт заголовок сообщения — без него заявка пришла бы
 * подписанной как летняя школа.
 *
 * Тексты состояний лежат в data-атрибутах формы: один скрипт обслуживает все
 * языковые версии.
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	list: readonly string[];
	mailNote: string;
	source: string;
	submit: string;
	states: {
		sending: string;
		sendingNote: string;
		sent: string;
		successNote: string;
		errorNote: string;
		subject: string;
		sentFrom: string;
	};
	fields: any;
}

const { id = 'apply', label, title, lead, list, mailNote, source, submit, states, fields } =
	Astro.props;

const inputClass =
	'w-full min-w-0 rounded-full border border-white/80 bg-white/55 px-5 py-3.5 text-[0.93rem] font-light tracking-normal text-academy-ink normal-case shadow-[inset_0_1px_0_rgb(255_255_255/.9)] transition-all duration-300 outline-none placeholder:text-[#9C9488] focus:border-academy-taupe/60 focus:bg-white/80 focus:ring-4 focus:ring-academy-taupe/12';
const areaClass = inputClass.replace('rounded-full', 'rounded-[1.6rem]') + ' resize-y';
const labelClass =
	'grid min-w-0 gap-2 text-[0.66rem] font-medium tracking-[0.16em] text-[#8E867A] uppercase';
---

<section id={id} class="relative px-4 pt-28 pb-28 sm:px-6 lg:px-10 lg:pt-36 lg:pb-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
			<div class="academy-reveal">
				<SectionLabel text={label} />
				<h2
					class="mt-5 max-w-[18ch] font-serif text-[clamp(1.9rem,3.2vw,2.9rem)] leading-tight font-medium tracking-[-0.025em] text-balance"
				>
					{title}
				</h2>
				<p class="mt-5 max-w-[46ch] text-[clamp(0.98rem,1.15vw,1.1rem)] leading-relaxed font-light text-[#5C5449]">
					{lead}
				</p>

				<ul class="mt-8 flex flex-wrap gap-2.5">
					{
						list.map((item) => (
							<li class="academy-pill rounded-full px-5 py-3 text-[0.86rem] font-light text-[#3D372F]">
								{item}
							</li>
						))
					}
				</ul>

				<p class="mt-7 text-[0.9rem] font-light text-[#5C5449]">
					{mailNote}{' '}
					<a
						href="mailto:info@bridgeconsult.uz"
						class="text-academy-taupe-deep underline-offset-4 transition-colors hover:text-academy-ink hover:underline"
						>info@bridgeconsult.uz</a
					>
				</p>
			</div>

			<form
				id="academyApplyForm"
				method="POST"
				data-subject={states.subject}
				data-sent-from={states.sentFrom}
				data-sending={states.sending}
				data-sending-note={states.sendingNote}
				data-sent={states.sent}
				data-success-note={states.successNote}
				data-error-note={states.errorNote}
				class="academy-reveal academy-glass grid gap-4 rounded-[2.6rem] px-6 py-8 sm:px-10 sm:py-10"
			>
				<input type="hidden" name="source" value={source} />

				<label class={labelClass}>
					{fields.name.label}
					<input name="name" autocomplete="name" required placeholder={fields.name.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.role.label}
					<input name="role" autocomplete="organization-title" placeholder={fields.role.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.contact.label}
					<input name="contact" autocomplete="tel" required placeholder={fields.contact.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.programme.label}
					<select name="programme" class={inputClass}>
						{fields.programme.options.map((o: string) => <option>{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.participants.label}
					<select name="participants" class={inputClass}>
						{fields.participants.options.map((o: string) => <option>{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.language.label}
					<select name="language" class={inputClass}>
						{fields.language.options.map((o: string) => <option>{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.cases.label}
					<textarea name="cases_to_discuss" rows="4" placeholder={fields.cases.placeholder} class={areaClass}></textarea>
				</label>

				<label class={labelClass}>
					{fields.message.label}
					<textarea name="message" rows="3" placeholder={fields.message.placeholder} class={areaClass}></textarea>
				</label>

				<!-- Ловушка для ботов: не display:none — часть ботов такие поля пропускает.
				     Заполненную ловушку /api/apply не выбрасывает, а помечает. -->
				<input
					type="text"
					name="hp_ref"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
					class="absolute -left-[9999px] h-px w-px opacity-0"
				/>

				<button
					type="submit"
					data-magnetic
					class="mt-2 inline-flex min-h-[3.25rem] w-full cursor-pointer items-center justify-center rounded-full bg-[linear-gradient(140deg,#A8927A,#8A7B66_52%,#5F5240)] px-8 text-[0.8rem] font-medium tracking-[0.03em] text-white shadow-[0_22px_46px_-18px_rgb(138_123_102/.85),inset_0_1.5px_0_rgb(255_255_255/.35)] transition-shadow duration-300 hover:shadow-[0_28px_56px_-18px_rgb(138_123_102/.95),inset_0_1.5px_0_rgb(255_255_255/.4)] disabled:cursor-default disabled:opacity-55"
				>
					{submit}
				</button>

				<p
					id="academyFormNote"
					role="status"
					aria-live="polite"
					class="min-h-[1.5em] text-center text-[0.8rem] leading-relaxed font-light text-[#5C5449]"
				>
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const LEAD_EMAIL = 'info@bridgeconsult.uz';
	const form = document.getElementById('academyApplyForm') as HTMLFormElement | null;
	const note = document.getElementById('academyFormNote');

	if (form && note) {
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		const idle = button.textContent ?? '';

		// Запасной вариант: подписи берём у самих <label>, поэтому письмо
		// автоматически выходит на языке страницы.
		const buildMailto = (data: FormData) => {
			const lines: string[] = [];
			form.querySelectorAll<HTMLInputElement>('input[name], select[name], textarea[name]').forEach((field) => {
				const name = field.getAttribute('name');
				if (!name || name === 'hp_ref') return;
				const value = (data.get(name) ?? '').toString().trim();
				if (!value) return;
				const label = field.closest('label');
				const caption = label?.childNodes[0]?.textContent?.trim() ?? name;
				lines.push(`${caption}: ${value}`);
			});
			const body = `${lines.join('\n')}\n\n${form.dataset.sentFrom} ${location.href}`;
			return `mailto:${LEAD_EMAIL}?subject=${encodeURIComponent(form.dataset.subject ?? '')}&body=${encodeURIComponent(body)}`;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			button.disabled = true;
			button.textContent = form.dataset.sending ?? '';
			note.textContent = form.dataset.sendingNote ?? '';

			try {
				const response = await fetch('/api/apply', {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' },
				});
				if (!response.ok) throw new Error(`/api/apply вернул ${response.status}`);
				form.reset();
				note.textContent = form.dataset.successNote ?? '';
				button.textContent = form.dataset.sent ?? idle;
			} catch {
				// Функция недоступна — заявка не должна пропасть.
				location.href = buildMailto(data);
				note.textContent = (form.dataset.errorNote ?? '').replace('{email}', LEAD_EMAIL);
				button.disabled = false;
				button.textContent = idle;
			}
		});
	}
</script>
