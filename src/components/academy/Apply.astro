---
/**
 * Экран-заявка на светлом.
 *
 * Раньше секция была карбоновой и шла третьей тёмной подряд — после
 * финального призыва и перед тёмным футером. Три чёрных экрана встык
 * читались как одна мутная плита, а поля формы на них проваливались.
 * Заявка вынесена на бумагу: она последняя, где от человека нужно
 * действие, и должна быть самой светлой точкой страницы.
 *
 * Отправляется на собственную функцию /api/apply (см. api/apply.js): она
 * рассылает заявку в Telegram и, если задан FORMSPREE_ID, дублирует на почту.
 * Скрытое поле source задаёт заголовок сообщения — без него заявка пришла бы
 * подписанной как летняя школа.
 *
 * Тексты состояний лежат в data-атрибутах формы: один скрипт обслуживает все
 * языковые версии.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	list: readonly string[];
	mailNote: string;
	source: string;
	submit: string;
	states: {
		sending: string;
		sendingNote: string;
		sent: string;
		successNote: string;
		errorNote: string;
		subject: string;
		sentFrom: string;
	};
	fields: any;
}

const { id = 'apply', label, title, lead, list, mailNote, source, submit, states, fields } =
	Astro.props;

const inputClass =
	'w-full min-w-0 border-0 border-b border-academy-ink/20 bg-transparent px-0 py-3 text-[0.95rem] font-light tracking-normal text-academy-ink normal-case transition-colors duration-300 outline-none placeholder:text-[#9A968D] focus:border-academy-brass';
const labelClass = 'grid min-w-0 gap-1 academy-mark text-academy-taupe';
---

<section id={id} class="relative bg-academy-ground px-6 py-20 text-academy-ink sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-12 border-t border-academy-ink/20 pt-8 lg:gap-x-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>

			<div class="col-span-12 lg:col-span-5 lg:col-start-3">
				<h2
					class="academy-reveal-mask max-w-[16ch] font-serif text-[clamp(2rem,3.8vw,3.2rem)] leading-[1.06] font-normal tracking-[-0.03em] text-balance"
				>
					{title}
				</h2>
				<p class="academy-reveal mt-6 max-w-[44ch] text-[0.95rem] leading-relaxed font-light text-[#5F5B53]">
					{lead}
				</p>

				<ul data-reveal-group class="mt-9">
					{
						list.map((item, i) => (
							<li class="group grid grid-cols-[2.5rem_minmax(0,1fr)_1.25rem] items-baseline gap-x-4 border-t border-academy-ink/12 py-3.5 text-[0.9rem] font-light text-[#4A453D] transition-colors duration-300 hover:text-academy-ink">
								<span class="academy-mark text-[#8E8A81] transition-colors duration-300 group-hover:text-academy-brass">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span>{item}</span>
								{/* Галочка проявляется на наведении: строка перестаёт быть
								    просто перечислением и читается как «что вы получите». */}
								<svg
									aria-hidden="true"
									class="h-3.5 w-3.5 self-center justify-self-end text-academy-brass opacity-0 transition-opacity duration-300 group-hover:opacity-100"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5" />
								</svg>
							</li>
						))
					}
				</ul>

				<!-- Прямой контакт. Раньше это была серая строчка в потоке текста и
				     терялась насмерть; теперь — карточка с латунной чертой слева. -->
				<div class="academy-reveal mt-9 border-l-2 border-academy-brass bg-academy-champagne/25 px-6 py-5">
					<p class="academy-mark text-academy-brass">{mailNote}</p>
					<a
						href="mailto:info@bridgeconsult.uz"
						class="group mt-2.5 inline-flex items-center gap-3 font-serif text-[clamp(1.1rem,1.7vw,1.45rem)] leading-none font-normal text-academy-ink transition-colors duration-300 hover:text-academy-taupe-deep"
					>
						info@bridgeconsult.uz
						<span
							aria-hidden="true"
							class="h-px w-6 bg-academy-brass transition-all duration-300 group-hover:w-11"
						></span>
					</a>
					<a
						href="tel:+998330001530"
						class="mt-2 block text-[0.9rem] font-light text-[#5F5B53] transition-colors duration-300 hover:text-academy-taupe-deep"
					>
						+998 33 000 15 30
					</a>
				</div>
			</div>

			<form
				id="academyApplyForm"
				method="POST"
				data-subject={states.subject}
				data-sent-from={states.sentFrom}
				data-sending={states.sending}
				data-sending-note={states.sendingNote}
				data-sent={states.sent}
				data-success-note={states.successNote}
				data-error-note={states.errorNote}
				class="academy-reveal col-span-12 grid gap-6 lg:col-span-4 lg:col-start-9"
			>
				<input type="hidden" name="source" value={source} />

				<label class={labelClass}>
					{fields.name.label}
					<input name="name" autocomplete="name" required placeholder={fields.name.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.role.label}
					<input name="role" autocomplete="organization-title" placeholder={fields.role.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.contact.label}
					<input name="contact" autocomplete="tel" required placeholder={fields.contact.placeholder} class={inputClass} />
				</label>

				<label class={labelClass}>
					{fields.programme.label}
					<select name="programme" class={inputClass}>
						{fields.programme.options.map((o: string) => <option class="bg-white">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.participants.label}
					<select name="participants" class={inputClass}>
						{fields.participants.options.map((o: string) => <option class="bg-white">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.language.label}
					<select name="language" class={inputClass}>
						{fields.language.options.map((o: string) => <option class="bg-white">{o}</option>)}
					</select>
				</label>

				<label class={labelClass}>
					{fields.cases.label}
					<textarea name="cases_to_discuss" rows="3" placeholder={fields.cases.placeholder} class={`${inputClass} resize-y`}></textarea>
				</label>

				<label class={labelClass}>
					{fields.message.label}
					<textarea name="message" rows="2" placeholder={fields.message.placeholder} class={`${inputClass} resize-y`}></textarea>
				</label>

				<!-- Ловушка для ботов: не display:none — часть ботов такие поля пропускает.
				     Заполненную ловушку /api/apply не выбрасывает, а помечает. -->
				<input
					type="text"
					name="hp_ref"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
					class="absolute -left-[9999px] h-px w-px opacity-0"
				/>

				<button
					type="submit"
					class="mt-2 inline-flex min-h-[3.4rem] w-full cursor-pointer items-center justify-center rounded-full bg-academy-carbon px-8 text-[0.75rem] font-semibold tracking-[0.16em] text-academy-paper uppercase transition-colors duration-300 hover:bg-academy-taupe-deep disabled:cursor-default disabled:opacity-50"
				>
					{submit}
				</button>

				<p
					id="academyFormNote"
					role="status"
					aria-live="polite"
					class="min-h-[1.4em] text-[0.78rem] leading-relaxed font-light text-[#5F5B53]"
				>
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const LEAD_EMAIL = 'info@bridgeconsult.uz';
	const form = document.getElementById('academyApplyForm') as HTMLFormElement | null;
	const note = document.getElementById('academyFormNote');

	if (form && note) {
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		const idle = button.textContent ?? '';

		// Запасной вариант: подписи берём у самих <label>, поэтому письмо
		// автоматически выходит на языке страницы.
		const buildMailto = (data: FormData) => {
			const lines: string[] = [];
			form.querySelectorAll<HTMLInputElement>('input[name], select[name], textarea[name]').forEach((field) => {
				const name = field.getAttribute('name');
				if (!name || name === 'hp_ref') return;
				const value = (data.get(name) ?? '').toString().trim();
				if (!value) return;
				const label = field.closest('label');
				const caption = label?.childNodes[0]?.textContent?.trim() ?? name;
				lines.push(`${caption}: ${value}`);
			});
			const body = `${lines.join('\n')}\n\n${form.dataset.sentFrom} ${location.href}`;
			return `mailto:${LEAD_EMAIL}?subject=${encodeURIComponent(form.dataset.subject ?? '')}&body=${encodeURIComponent(body)}`;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			button.disabled = true;
			button.textContent = form.dataset.sending ?? '';
			note.textContent = form.dataset.sendingNote ?? '';

			try {
				const response = await fetch('/api/apply', {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' },
				});
				if (!response.ok) throw new Error(`/api/apply вернул ${response.status}`);
				form.reset();
				note.textContent = form.dataset.successNote ?? '';
				button.textContent = form.dataset.sent ?? idle;
			} catch {
				// Функция недоступна — заявка не должна пропасть.
				location.href = buildMailto(data);
				note.textContent = (form.dataset.errorNote ?? '').replace('{email}', LEAD_EMAIL);
				button.disabled = false;
				button.textContent = idle;
			}
		});
	}
</script>
