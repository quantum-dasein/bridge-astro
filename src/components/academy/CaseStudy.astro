---
/**
 * Разбор кейса.
 *
 * Снимок во всю ширину, поверх — карбоновая заливка и текст прямо на ней,
 * без стеклянной плиты: плита превращала секцию в очередную карточку.
 */

interface Props {
	label: string;
	title: string;
	lead: string;
	docTitle: string;
	clauses: readonly string[];
	blocks: readonly { heading: string; text: string; key?: boolean }[];
}

const { label, title, lead, docTitle, clauses, blocks } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-academy-carbon px-6 py-16 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div aria-hidden="true" class="absolute inset-0 -z-10">
		<picture>
			<source srcset="/academy-atmosphere.avif" type="image/avif" />
			<source srcset="/academy-atmosphere.webp" type="image/webp" />
			<img
				src="/academy-atmosphere.png"
				alt=""
				width="1920"
				height="823"
				loading="lazy"
				class="h-full w-full object-cover opacity-55"
			/>
		</picture>
		<div class="absolute inset-0 bg-[linear-gradient(100deg,rgb(17_17_17/.94),rgb(17_17_17/.72)_58%,rgb(17_17_17/.86))]"></div>
	</div>

	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-5 border-t border-academy-paper/25 pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[20ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.08] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			<div class="col-span-12 lg:col-span-4 lg:col-start-9">
				<p class="academy-reveal max-w-[44ch] text-[0.92rem] leading-relaxed font-light text-academy-paper/60">
					{lead}
				</p>
				<div class="mt-4 flex flex-wrap items-center gap-2.5">
					<span class="academy-mark text-academy-paper/40">{docTitle}</span>
					{clauses.map((c) => (
						<span class="academy-mark rounded-full border border-academy-brass/40 px-3 py-1 text-[0.58rem] text-academy-brass">
							{c}
						</span>
					))}
				</div>
			</div>
		</div>

		<div data-reveal-group class="mt-12 grid lg:mt-14 lg:grid-cols-3 lg:gap-x-12">
			{
				blocks.map((b, i) => (
					<div
						class={`grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-x-5 border-t py-5 lg:block ${b.key ? 'border-academy-brass/50' : 'border-academy-paper/15'}`}
					>
						<span class={`academy-mark ${b.key ? 'text-academy-brass' : 'text-academy-paper/35'}`}>
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<h3
								class={`text-[0.7rem] font-medium tracking-[0.18em] uppercase lg:mt-4 ${b.key ? 'text-academy-brass' : 'text-academy-paper/45'}`}
							>
								{b.heading}
							</h3>
							<p
								class={`mt-2.5 max-w-[36ch] text-[0.92rem] leading-relaxed ${b.key ? 'font-normal text-white' : 'font-light text-academy-paper/70'}`}
							>
								{b.text}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
