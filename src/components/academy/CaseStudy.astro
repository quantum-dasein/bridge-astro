---
/**
 * Разбор кейса.
 *
 * Атмосферный снимок лежит подложкой во всю ширину, стекло — прямо на нём.
 * Контраст тёмного кадра и молочного стекла и даёт глубину; на плоском фоне
 * этот блок выглядел бы очередной карточкой.
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	label: string;
	title: string;
	lead: string;
	docTitle: string;
	clauses: readonly string[];
	blocks: readonly { heading: string; text: string; key?: boolean }[];
}

const { label, title, lead, docTitle, clauses, blocks } = Astro.props;
---

<section class="relative px-4 pt-28 sm:px-6 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div
			class="academy-reveal relative overflow-hidden rounded-[3rem] shadow-[0_44px_90px_-32px_rgb(63_50_36/.48)]"
		>
			<picture>
				<source srcset="/academy-atmosphere.avif" type="image/avif" />
				<source srcset="/academy-atmosphere.webp" type="image/webp" />
				<img
					src="/academy-atmosphere.png"
					alt=""
					width="1920"
					height="823"
					loading="lazy"
					class="h-full min-h-[30rem] w-full object-cover"
				/>
			</picture>
			<div
				aria-hidden="true"
				class="absolute inset-0 bg-[linear-gradient(120deg,rgb(41_39_36/.82),rgb(41_39_36/.6))]"
			>
			</div>

			<div class="absolute inset-3 sm:inset-6 lg:inset-8">
				<div class="academy-glass academy-glass-solid h-full rounded-[2.4rem] px-6 py-7 sm:px-10 sm:py-9">
					<div class="relative flex h-full flex-col">
						<div class="flex flex-wrap items-center gap-2.5">
							<SectionLabel text={label} class="mr-2" />
							{clauses.map((c) => <span class="academy-clause">{c}</span>)}
						</div>

						<h2
							class="mt-5 max-w-[24ch] font-serif text-[clamp(1.5rem,2.6vw,2.2rem)] leading-tight font-medium tracking-[-0.02em] text-balance"
						>
							{title}
						</h2>

						<p class="mt-3 max-w-[62ch] text-[0.92rem] leading-relaxed font-light text-[#5C5449]">
							{lead}
						</p>

						<div class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-7">
							{
								blocks.map((b) => (
									<div>
										<div
											class={`mb-2 text-[0.65rem] font-medium tracking-[0.18em] uppercase ${b.key ? 'text-academy-taupe' : 'text-[#6E665B]'}`}
										>
											{b.heading}
										</div>
										<p
											class={`text-[0.88rem] leading-relaxed ${b.key ? 'font-normal text-academy-ink' : 'font-light text-[#4A443B]'}`}
										>
											{b.text}
										</p>
									</div>
								))
							}
						</div>

						<div class="mt-auto pt-5 text-[0.7rem] font-medium tracking-[0.16em] text-[#6E665B] uppercase">
							{docTitle}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
