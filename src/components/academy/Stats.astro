---
/**
 * Спецификация программы.
 *
 * Не четыре одинаковые карточки, а лист технических данных: волосяные
 * линейки, маркировка сверху, крупная цифра, подпись. Читается как
 * spec sheet к чертежу, а не как плитки лендинга.
 *
 * data-anim="stat-value" — в data-count цель для счётчика; суффикс вынесен
 * в отдельный <small>, чтобы его не затирало при анимации textContent.
 */

interface Props {
	items: readonly { count?: number; value: string; suffix?: string; label: string; mark: string }[];
	trainerNote: string;
}

const { items, trainerNote } = Astro.props;
---

<section class="relative bg-academy-ground px-6 pt-14 pb-12 sm:px-10 lg:px-14 lg:pt-24">
	<div class="mx-auto w-full max-w-[1400px]">
		<dl data-reveal-group class="grid grid-cols-2 lg:grid-cols-4">
			{
				items.map((item) => (
					<div class="border-t border-academy-ink/18 pt-5 pr-6 pb-2 lg:pt-6">
						<dt class="academy-mark text-academy-brass">{item.mark}</dt>
						<dd class="mt-5 font-serif text-[clamp(2.6rem,5vw,4.2rem)] leading-[0.9] font-normal tracking-[-0.03em] whitespace-nowrap text-academy-ink tabular-nums">
							<span data-anim="stat-value" data-count={item.count}>{item.value}</span>
							{item.suffix && <small class="text-[0.42em] text-[#5F5B53]">{item.suffix}</small>}
						</dd>
						<p class="mt-4 max-w-[20ch] text-[0.82rem] leading-snug font-light text-[#5F5B53]">
							{item.label}
						</p>
					</div>
				))
			}
		</dl>

		<p
			class="academy-reveal mt-14 flex flex-wrap items-baseline gap-x-4 gap-y-2 border-t border-academy-ink/18 pt-5 text-[0.88rem] font-light text-[#4A453D] lg:mt-16"
		>
			<span class="academy-mark shrink-0 text-academy-brass">Practitioner</span>
			<Fragment set:html={trainerNote} />
		</p>
	</div>
</section>
