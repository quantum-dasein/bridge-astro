---
/**
 * Полоса из четырёх чисел под Hero.
 *
 * Точки для GSAP:
 *   data-anim="stat"        — колонка целиком (stagger)
 *   data-anim="stat-rule"   — вертикальная линейка слева (scaleY: 0 -> 1)
 *   data-anim="stat-value"  — само число; в data-count лежит цель для счётчика,
 *                             суффикс вынесен в отдельный <small>, чтобы его
 *                             не затирало при анимации textContent
 */

interface Props {
	items: {
		/** Число для счётчика. Если не задано — значение не анимируется (RU + UZ). */
		count?: number;
		value: string;
		suffix?: string;
		label: string;
	}[];
}

const { items } = Astro.props;
---

<section class="relative border-y border-white/10">
	<div class="mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div
			class="grid grid-cols-1 gap-x-10 gap-y-12 pt-32 pb-20 sm:grid-cols-2 lg:grid-cols-4 lg:pt-48 lg:pb-24"
		>
			{
				items.map((item) => (
					<div data-anim="stat" class="relative pl-6">
						<span
							data-anim="stat-rule"
							class="absolute top-1.5 bottom-1.5 left-0 w-px origin-top bg-gradient-to-b from-academy-gold to-transparent"
						/>
						<p class="bg-gradient-to-br from-academy-gold-soft via-academy-gold to-[#96793F] bg-clip-text font-geo text-[clamp(2.5rem,4.6vw,3.8rem)] leading-none font-light tracking-[-0.02em] whitespace-nowrap text-transparent tabular-nums"><span
								data-anim="stat-value"
								data-count={item.count}>{item.value}</span>{
								item.suffix && <small class="text-[0.44em] font-normal tracking-normal">{item.suffix}</small>
							}</p>
						<p class="mt-3.5 max-w-[24ch] text-[0.85rem] leading-relaxed font-light text-gray-400">
							{item.label}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>
