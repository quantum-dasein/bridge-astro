---
/**
 * «Единый формат разбора кейсов» — восемь позиций разбора.
 *
 * Не карточки: раньше здесь были восемь мягких стеклянных плиток, и на
 * фоне остальной редакционной вёрстки они выпадали из языка страницы.
 * Теперь это лист спецификации: две колонки строк на волосяных линейках,
 * номер моноширинным, название и пояснение в одной строке.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	rows: readonly { key: string; value: string }[];
}

const { id = 'method', label, title, lead, rows } = Astro.props;
---

<section id={id} class="relative bg-academy-ground px-6 py-20 sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-5 border-t border-academy-ink/20 pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>
			<h2
				class="academy-reveal col-span-12 max-w-[16ch] font-serif text-[clamp(1.8rem,3.2vw,2.8rem)] leading-[1.08] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			<p
				class="academy-reveal col-span-12 max-w-[44ch] text-[0.92rem] leading-relaxed font-light text-[#77746D] lg:col-span-4 lg:col-start-9"
			>
				{lead}
			</p>
		</div>

		<div class="mt-10 grid gap-x-16 lg:mt-12 lg:grid-cols-2">
			{
				rows.map((row, i) => (
					<div class="group grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-x-5 border-t border-academy-ink/12 py-4 lg:grid-cols-[3.5rem_minmax(0,11rem)_minmax(0,1fr)] lg:gap-x-6">
						<span class="academy-mark text-[#8B887F] transition-colors duration-300 group-hover:text-academy-brass">
							{String(i + 1).padStart(2, '0')}
						</span>
						<span class="text-[0.98rem] font-medium text-academy-ink">{row.key}</span>
						<span class="col-start-2 mt-1 text-[0.85rem] leading-relaxed font-light text-[#77746D] lg:col-start-3 lg:mt-0">
							{row.value}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>
