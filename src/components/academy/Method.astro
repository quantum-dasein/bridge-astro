---
/**
 * «Единый формат разбора кейсов» + стеклянный лист с анатомией кейса.
 *
 * Лист намеренно свёрстан как документ: тёмная шапка с золотым отливом,
 * строки через тонкие линейки, номера моноширинным.
 *
 * data-anim: label · title · lead · sheet · sheet-row
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	spine: string;
	sheetTitle: string;
	sheetNote: string;
	rows: readonly { key: string; value: string }[];
}

const { id = 'method', label, title, lead, spine, sheetTitle, sheetNote, rows } = Astro.props;
---

<section id={id} class="relative border-t border-white/10 py-24 lg:py-32">
	<div class="mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-24">
			<div>
				<SectionLabel text={label} />
				<h2
					data-anim="title"
					class="max-w-[14ch] font-serif text-[clamp(1.7rem,2.5vw,2.3rem)] leading-tight font-medium tracking-[-0.02em] text-white text-balance"
				>
					{title}
				</h2>
			</div>
			<p data-anim="lead" class="max-w-[64ch] text-[clamp(1rem,1.15vw,1.15rem)] leading-relaxed font-light text-gray-300">
				{lead}
			</p>
		</div>

		<div class="relative mt-14 lg:mt-16">
			<span
				aria-hidden="true"
				class="absolute top-0 -left-10 hidden text-[10px] tracking-[0.34em] whitespace-nowrap text-gray-500 uppercase [writing-mode:vertical-rl] rotate-180 xl:block"
			>
				{spine}
			</span>

			<div
				data-anim="sheet"
				class="overflow-hidden rounded-sm border border-white/10 bg-white/[0.035] shadow-[0_40px_90px_-40px_rgba(0,0,0,0.95)] backdrop-blur-md"
			>
				<div
					class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-academy-gold/20 bg-gradient-to-r from-academy-gold/12 to-transparent px-6 py-5 lg:px-8"
				>
					<strong class="text-[11px] font-medium tracking-[0.2em] text-academy-gold-soft uppercase">
						{sheetTitle}
					</strong>
					<span class="text-[11px] text-gray-500">{sheetNote}</span>
				</div>

				{
					rows.map((row, i) => (
						<div
							data-anim="sheet-row"
							class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-5 gap-y-1 border-t border-white/[0.06] px-6 py-5 transition-colors duration-300 first:border-t-0 hover:bg-academy-gold/[0.06] lg:grid-cols-[3.5rem_minmax(0,16rem)_minmax(0,1fr)] lg:px-8"
						>
							<span class="text-[11px] tabular-nums text-academy-gold">
								{String(i + 1).padStart(2, '0')}
							</span>
							<span class="text-[0.98rem] font-medium text-white">{row.key}</span>
							<span class="col-start-2 text-[0.92rem] font-light text-gray-400 lg:col-start-3">
								{row.value}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
