---
/**
 * «Единый формат разбора кейсов».
 *
 * Восемь позиций разбора — не таблица, а капли: каждая позиция это отдельная
 * стеклянная пилюля с номером. Прямых углов нет ни у одной.
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	rows: readonly { key: string; value: string }[];
}

const { id = 'method', label, title, lead, rows } = Astro.props;
---

<section id={id} class="relative px-4 pt-28 sm:px-6 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="academy-reveal mx-auto max-w-[52rem] text-center">
			<SectionLabel text={label} center />
			<h2
				class="mx-auto mt-5 max-w-[18ch] font-serif text-[clamp(1.9rem,3.2vw,2.9rem)] leading-tight font-medium tracking-[-0.025em] text-balance"
			>
				{title}
			</h2>
			<p class="mx-auto mt-5 max-w-[60ch] text-[clamp(0.98rem,1.15vw,1.1rem)] leading-relaxed font-light text-[#5C5449]">
				{lead}
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
			{
				rows.map((row, i) => (
					<div
						class="academy-reveal academy-pill group rounded-[2rem] px-6 py-6 transition-shadow duration-500 hover:shadow-[inset_0_1px_0_rgb(255_255_255/.95),0_26px_50px_-18px_rgb(63_50_36/.36)]"
					>
						<span class="font-serif text-[1.6rem] leading-none font-medium text-academy-taupe tabular-nums">
							{String(i + 1).padStart(2, '0')}
						</span>
						<h3 class="mt-3 text-[0.98rem] font-medium text-academy-ink">{row.key}</h3>
						<p class="mt-1.5 text-[0.85rem] leading-relaxed font-light text-[#6E665B]">{row.value}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
