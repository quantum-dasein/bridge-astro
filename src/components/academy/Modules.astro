---
/**
 * Восемнадцать модулей — четыре карточки потоков.
 *
 * Раньше это был список строк с крошечным превью сбоку: снимок не вписывался
 * ни в масштаб, ни в ритм строки. Теперь снимок и есть карточка — он лежит
 * фоном во всю её площадь, а модули потока живут поверх. Карточек четыре,
 * а не восемнадцать: восемнадцать одинаковых плиток ничего не сообщают
 * о структуре программы, четыре потока — сообщают.
 *
 * Интерактивность: наведение поднимает карточку, снимок наезжает, оверлей
 * светлеет, номера уходят в латунь. На тач-устройствах hover не существует,
 * поэтому исходное состояние уже читаемо — эффект только усиливает.
 *
 * До lg карточки лежат не в столбик, а в горизонтальной ленте со снапом:
 * четыре высокие карточки одна под другой давали на телефоне экран
 * бесконечной прокрутки. Лента листается пальцем, карточка занимает 86%
 * ширины — край следующей виден и подсказывает, что лента продолжается.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	groups: readonly {
		roman: string;
		title: string;
		note: string;
		image: string;
		imageAlt: string;
		items: readonly string[];
	}[];
}

const { id = 'modules', label, title, groups } = Astro.props;

// Сквозная нумерация 01..18 поверх четырёх потоков
let counter = 0;
const streams = groups.map((g) => ({
	...g,
	items: g.items.map((item) => ({ item, n: String(++counter).padStart(2, '0') })),
}));
---

<section id={id} class="relative bg-academy-carbon px-6 py-16 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 items-baseline gap-y-4 border-t border-academy-paper/20 pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[22ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.08] font-normal tracking-[-0.025em] text-balance lg:col-span-7 lg:col-start-3"
				set:html={title}
			/>
		</div>

		<!-- Подсказка про свайп: на телефоне лента ничем не выдаёт, что её
		     можно листать, кроме выглядывающего края следующей карточки. -->
		<p class="academy-mark mt-8 flex items-center gap-2.5 text-academy-paper/40 lg:hidden">
			Листайте вбок
			<svg class="h-3 w-6" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M0 6h21m0 0l-5-5m5 5l-5 5" />
			</svg>
		</p>

		<!-- До lg — лента со снапом, от lg — сетка 2×2. Отрицательные поля
		     возвращают ленте края экрана, чтобы карточки уезжали под срез,
		     а не упирались в отступ секции.
		     Появление вешаем на всю ленту, а не на каждую карточку: сдвиг
		     потомков внутри контейнера с overflow-x породил бы вертикальную
		     прокрутку и обрезал размытие. -->
		<div
			class="academy-reveal -mx-6 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 [scrollbar-width:none] sm:-mx-10 sm:px-10 lg:mx-0 lg:mt-14 lg:grid lg:grid-cols-2 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden"
		>
			{
				streams.map((stream) => (
					<article class="group relative isolate w-[86%] shrink-0 snap-start overflow-hidden rounded-[1.75rem] border border-academy-paper/12 transition-transform duration-600 hover:-translate-y-1 sm:w-[68%] lg:w-auto lg:shrink">
						{/* Снимок во всю площадь карточки */}
						<picture>
							<source srcset={`/${stream.image}.avif`} type="image/avif" />
							<source srcset={`/${stream.image}.webp`} type="image/webp" />
							<img
								src={`/${stream.image}.png`}
								alt={stream.imageAlt}
								width="900"
								height="675"
								loading="lazy"
								class="absolute inset-0 -z-10 h-full w-full scale-105 object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-100"
							/>
						</picture>
						<span
							aria-hidden="true"
							class="absolute inset-0 -z-10 bg-[linear-gradient(155deg,rgb(17_17_17/.9),rgb(17_17_17/.82)_45%,rgb(17_17_17/.94))] transition-opacity duration-600 group-hover:opacity-90"
						/>

						<div class="p-7 lg:p-9">
							<div class="flex items-baseline gap-4">
								<span class="font-serif text-[clamp(1.9rem,2.6vw,2.5rem)] leading-none font-normal text-academy-brass">
									{stream.roman}
								</span>
								<h3 class="font-serif text-[clamp(1.2rem,1.9vw,1.6rem)] leading-tight font-normal">
									{stream.title}
								</h3>
							</div>

							<p class="mt-3 max-w-[42ch] text-[0.86rem] leading-relaxed font-light text-academy-paper/55">
								{stream.note}
							</p>

							<ul class="mt-6 border-t border-academy-paper/15">
								{stream.items.map(({ item, n }) => (
									<li class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-b border-academy-paper/10 py-2.5 last:border-b-0">
										<span class="academy-mark text-academy-paper/35 transition-colors duration-400 group-hover:text-academy-brass">
											{n}
										</span>
										<span class="text-[0.95rem] leading-snug font-light text-academy-paper/85 transition-colors duration-400 group-hover:text-white">
											{item}
										</span>
									</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
