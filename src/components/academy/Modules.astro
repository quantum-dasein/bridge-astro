---
/**
 * 18 модулей четырьмя потоками.
 *
 * Модуль — не плитка, а капля: полностью скруглённая стеклянная пилюля,
 * обтекающая строку. У каждого потока круглая линза с генерированным
 * снимком — тёмное окно в светлом листе.
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	groups: readonly {
		roman: string;
		title: string;
		note: string;
		image: string;
		imageAlt: string;
		items: readonly string[];
	}[];
}

const { id = 'modules', label, title, groups } = Astro.props;

let counter = 0;
const numbered = groups.map((g) => ({
	...g,
	items: g.items.map((item) => ({ item, n: String(++counter).padStart(2, '0') })),
}));
---

<section id={id} class="relative px-4 pt-28 sm:px-6 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="academy-reveal mx-auto max-w-[48rem] text-center">
			<SectionLabel text={label} center />
			<h2
				class="mx-auto mt-5 max-w-[20ch] font-serif text-[clamp(1.9rem,3.2vw,2.9rem)] leading-tight font-medium tracking-[-0.025em] text-balance"
				set:html={title}
			/>
		</div>

		<div class="mt-12 flex flex-col gap-8 lg:mt-16 lg:gap-10">
			{
				numbered.map((group) => (
					<div class="academy-reveal flex flex-col items-center gap-6 text-center lg:flex-row lg:items-center lg:gap-7 lg:text-left">
						<div class="academy-lens h-[6.5rem] w-[6.5rem] shrink-0 lg:h-[7.25rem] lg:w-[7.25rem]">
							<picture>
								<source srcset={`/${group.image}.avif`} type="image/avif" />
								<source srcset={`/${group.image}.webp`} type="image/webp" />
								<img
									src={`/${group.image}.png`}
									alt={group.imageAlt}
									width="900"
									height="675"
									loading="lazy"
									class="h-full w-full object-cover brightness-115 saturate-110"
								/>
							</picture>
						</div>

						<div class="w-full shrink-0 lg:w-[9rem]">
							<div class="font-serif text-[1.9rem] leading-none font-normal text-academy-taupe">
								{group.roman}
							</div>
							<div class="mt-1.5 text-[0.88rem] font-medium">{group.title}</div>
						</div>

						<ul class="flex flex-wrap justify-center gap-2.5 lg:justify-start">
							{group.items.map(({ item, n }) => (
								<li class="academy-pill inline-flex items-baseline gap-2.5 rounded-full px-5 py-3 text-[0.92rem] font-light text-[#3D372F] transition-shadow duration-400 hover:shadow-[inset_0_1px_0_rgb(255_255_255/.95),0_20px_36px_-16px_rgb(63_50_36/.4)]">
									<b class="text-[0.7rem] font-medium tracking-[0.04em] text-academy-taupe tabular-nums">
										{n}
									</b>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
