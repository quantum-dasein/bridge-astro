---
/** «Формат» — одна широкая стеклянная плита, четыре пункта внутри. */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	items: readonly { title: string; text: string }[];
}

const { id = 'format', label, title, lead, items } = Astro.props;
---

<section id={id} class="relative px-4 pt-28 sm:px-6 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="academy-reveal academy-glass rounded-[3rem] px-6 py-10 sm:px-12 sm:py-14 lg:px-16">
			<div class="relative">
				<div class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
					<div>
						<SectionLabel text={label} />
						<h2
							class="mt-5 max-w-[16ch] font-serif text-[clamp(1.7rem,2.6vw,2.4rem)] leading-tight font-medium tracking-[-0.02em] text-balance"
						>
							{title}
						</h2>
					</div>
					<p class="max-w-[62ch] text-[clamp(0.98rem,1.15vw,1.1rem)] leading-relaxed font-light text-[#5C5449]">
						{lead}
					</p>
				</div>

				<div class="mt-10 grid gap-7 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-9">
					{
						items.map((item) => (
							<div class="border-t border-academy-taupe/30 pt-5">
								<h3 class="mb-2 text-[0.96rem] font-medium">{item.title}</h3>
								<p class="text-[0.85rem] leading-relaxed font-light text-[#6E665B]">{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
