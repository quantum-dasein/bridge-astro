---
/**
 * «Формат» — единственная секция с фотоподложкой: атмосферный кадр на
 * низкой прозрачности, края растворены в фон страницы.
 *
 * data-anim: label · title · lead · format-item
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	items: readonly { title: string; text: string }[];
}

const { id = 'format', label, title, lead, items } = Astro.props;
---

<section id={id} class="relative overflow-hidden border-t border-white/10 py-24 lg:py-32">
	<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
		<picture>
			<source srcset="/academy-atmosphere.avif" type="image/avif" />
			<source srcset="/academy-atmosphere.webp" type="image/webp" />
			<img
				src="/academy-atmosphere.png"
				alt=""
				width="1920"
				height="823"
				loading="lazy"
				class="h-full w-full object-cover opacity-30"
			/>
		</picture>
		<div
			class="absolute inset-0 bg-[linear-gradient(180deg,#100E0C,rgba(16,14,12,0.55)_26%,rgba(16,14,12,0.55)_74%,#100E0C)]"
		>
		</div>
	</div>

	<div class="mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-24">
			<div>
				<SectionLabel text={label} />
				<h2
					data-anim="title"
					class="max-w-[16ch] font-serif text-[clamp(1.8rem,2.7vw,2.5rem)] leading-tight font-medium tracking-[-0.02em] text-white text-balance"
				>
					{title}
				</h2>
			</div>
			<p data-anim="lead" class="max-w-[64ch] text-[clamp(1rem,1.15vw,1.15rem)] leading-relaxed font-light text-gray-300">
				{lead}
			</p>
		</div>

		<div class="mt-14 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-10">
			{
				items.map((item) => (
					<div data-anim="format-item" class="border-t border-academy-gold/25 pt-6">
						<h3 class="mb-2.5 text-[1.02rem] font-medium text-white">{item.title}</h3>
						<p class="text-[0.9rem] leading-relaxed font-light text-gray-300">{item.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
