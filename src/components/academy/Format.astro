---
/**
 * «Формат» на карбоне. Четыре пункта строками на линейках, без карточек.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	items: readonly { title: string; text: string }[];
}

const { id = 'format', label, title, lead, items } = Astro.props;
---

<section id={id} class="relative bg-academy-carbon px-6 py-16 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-4 border-t border-academy-paper/20 pt-7 lg:gap-y-5 lg:pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[18ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.08] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			<p
				class="academy-reveal col-span-12 max-w-[44ch] text-[0.92rem] leading-relaxed font-light text-academy-paper/55 lg:col-span-4 lg:col-start-9"
			>
				{lead}
			</p>
		</div>

		<div data-reveal-group class="mt-10 grid lg:mt-12 lg:grid-cols-2 lg:gap-x-16">
			{
				items.map((item, i) => (
					<div class="group grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-x-5 border-t border-academy-paper/12 py-5 lg:grid-cols-[3.5rem_minmax(0,12rem)_minmax(0,1fr)] lg:gap-x-6">
						<span class="academy-mark text-academy-paper/35 transition-colors duration-300 group-hover:text-academy-brass">
							{String(i + 1).padStart(2, '0')}
						</span>
						<span class="text-[0.98rem] font-medium">{item.title}</span>
						<span class="col-start-2 mt-1.5 text-[0.85rem] leading-relaxed font-light text-academy-paper/55 lg:col-start-3 lg:mt-0">
							{item.text}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>
