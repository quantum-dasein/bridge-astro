---
/** «Для кого» — четыре стеклянные капли со сквозной нумерацией. */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	lead: string;
	cards: readonly { title: string; text: string }[];
}

const { id = 'audience', label, title, lead, cards } = Astro.props;
---

<section id={id} class="relative px-4 pt-28 sm:px-6 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="academy-reveal mx-auto max-w-[54rem] text-center">
			<SectionLabel text={label} center />
			<h2
				class="mx-auto mt-5 max-w-[24ch] font-serif text-[clamp(1.9rem,3.2vw,2.9rem)] leading-tight font-medium tracking-[-0.025em] text-balance"
			>
				{title}
			</h2>
			<p class="mx-auto mt-5 max-w-[68ch] text-[clamp(0.98rem,1.15vw,1.1rem)] leading-relaxed font-light text-[#5C5449]">
				{lead}
			</p>
		</div>

		<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
			{
				cards.map((card, i) => (
					<article
						class="academy-reveal academy-glass rounded-[2.4rem] px-7 py-8 transition-transform duration-500 hover:-translate-y-1"
					>
						<div class="relative">
							<span class="font-serif text-[1.7rem] leading-none font-medium text-academy-taupe tabular-nums">
								{String(i + 1).padStart(2, '0')}
							</span>
							<h3 class="mt-4 mb-2.5 font-serif text-[1.3rem] font-medium">{card.title}</h3>
							<p
								class="text-[0.88rem] leading-relaxed font-light text-[#5C5449]"
								set:html={card.text}
							/>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
