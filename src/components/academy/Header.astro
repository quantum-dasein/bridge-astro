---
/**
 * Шапка: строгая, во всю ширину, без плавающего овала.
 *
 * Два состояния:
 *   stuck=false — прозрачный фон поверх героя, тонкая линия white/20
 *   stuck=true  — карбон с размытием
 *
 * Подложка карбоновая, а не молочная: страница чередует светлые и тёмные
 * секции, и светлая полоса поверх карбона читалась как чужеродная. Карбон
 * работает над обеими. Текст поэтому всегда светлый, логотип всегда вывернут.
 */

interface Props {
	nav: readonly { label: string; href: string }[];
	cta: string;
	current: 'ru' | 'en' | 'uz';
	langLinks: { ru: string; en: string; uz: string };
}

const { nav, cta, current, langLinks } = Astro.props;
const langs = [
	{ code: 'ru', href: langLinks.ru },
	{ code: 'en', href: langLinks.en },
	{ code: 'uz', href: langLinks.uz },
] as const;
---

<header
	id="academy-header"
	data-stuck="false"
	class="group fixed inset-x-0 top-0 z-50 border-b border-white/20 transition-[background-color,border-color,backdrop-filter] duration-500 data-[stuck=true]:border-academy-paper/12 data-[stuck=true]:bg-[rgb(17_17_17/.82)] data-[stuck=true]:backdrop-blur-xl data-[stuck=true]:backdrop-saturate-150"
>
	<div class="mx-auto flex h-[4.5rem] w-full max-w-[1400px] items-center justify-between gap-4 px-6 sm:px-10 lg:h-[5rem] lg:px-14">
		<a href="https://www.bridgeconsult.uz/" class="shrink-0" aria-label="BRIDGE Consult">
			<img
				src="/bridge%202.svg"
				alt="BRIDGE Consult"
				width="120"
				height="32"
				class="h-7 w-auto object-contain brightness-0 invert sm:h-8"
			/>
		</a>

		<nav class="hidden items-center gap-8 lg:flex">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="relative py-1.5 text-[0.82rem] font-light tracking-[0.02em] text-white/70 transition-colors duration-300 hover:text-white after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:scale-x-100"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3 sm:gap-6">
			<div class="flex items-center gap-1.5 text-[0.66rem] font-medium tracking-[0.14em]">
				{
					langs.map((l, i) => (
						<>
							{i > 0 && <span class="text-white/25">/</span>}
							{l.code === current ? (
								<span class="text-academy-brass uppercase">
									{l.code}
								</span>
							) : (
								<a
									href={l.href}
									class="text-white/50 uppercase transition-colors duration-300 hover:text-white"
								>
									{l.code}
								</a>
							)}
						</>
					))
				}
			</div>

			<a
				href="#apply"
				class="inline-flex min-h-[2.5rem] items-center rounded-full border border-white/30 px-5 text-[0.64rem] font-semibold tracking-[0.16em] whitespace-nowrap text-white uppercase transition-colors duration-300 hover:border-academy-brass hover:bg-academy-brass hover:text-[#17130A] sm:min-h-[2.75rem] sm:px-7 sm:text-[0.7rem]"
			>
				{cta}
			</a>
		</div>
	</div>
</header>

<script>
	// Инициализация после разбора DOM: шапка рендерится раньше героя, и на
	// момент выполнения этого скрипта [data-hero] ещё не существует.
	const init = () => {
		const header = document.getElementById('academy-header');
		const hero = document.querySelector('[data-hero]');
		if (!header) return;
		if (!hero || !('IntersectionObserver' in window)) {
			header.dataset.stuck = 'true';
			return;
		}
		let io: IntersectionObserver | undefined;
		const observe = () => {
			io?.disconnect();
			io = new IntersectionObserver(
				(entries) => {
					header.dataset.stuck = entries[0].isIntersecting ? 'false' : 'true';
				},
				{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 }
			);
			io.observe(hero);
		};
		observe();
		addEventListener('resize', observe);
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
	else init();
</script>
