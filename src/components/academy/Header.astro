---
/**
 * Шапка — стеклянная таблетка, парящая над страницей.
 *
 * На светлом фоне подложка нужна всегда, иначе таблетка теряется на молочном;
 * после ухода героя стекло уплотняется тенью.
 */

interface Props {
	nav: readonly { label: string; href: string }[];
	cta: string;
	current: 'ru' | 'en' | 'uz';
	langLinks: { ru: string; en: string; uz: string };
}

const { nav, cta, current, langLinks } = Astro.props;
const langs = [
	{ code: 'ru', href: langLinks.ru },
	{ code: 'en', href: langLinks.en },
	{ code: 'uz', href: langLinks.uz },
] as const;
---

<header id="academy-header" class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 sm:pt-6 lg:px-10">
	<div
		id="academy-header-shell"
		data-stuck="false"
		class="academy-pill flex items-center justify-between gap-3 rounded-full py-2.5 pr-2.5 pl-5 transition-shadow duration-500 sm:gap-5 sm:pl-7 data-[stuck=true]:shadow-[inset_0_1px_0_rgb(255_255_255/.95),0_22px_44px_-16px_rgb(63_50_36/.36)]"
	>
		<a
			href="https://www.bridgeconsult.uz/"
			class="shrink-0 font-serif text-[1.05rem] font-semibold tracking-[-0.01em] sm:text-[1.2rem]"
		>
			Bridge<span class="font-normal text-academy-taupe"> Academy</span>
		</a>

		<nav class="hidden items-center gap-7 text-[0.86rem] font-light text-[#5C5449] lg:flex">
			{
				nav.map((item) => (
					<a href={item.href} class="transition-colors duration-300 hover:text-academy-ink">
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2.5 sm:gap-4">
			<div class="flex items-center gap-1 text-[0.66rem] font-medium tracking-[0.06em] sm:text-[0.7rem]">
				{
					langs.map((l, i) => (
						<>
							{i > 0 && <span class="text-academy-taupe/35">·</span>}
							{l.code === current ? (
								<span class="px-0.5 text-academy-taupe uppercase">{l.code}</span>
							) : (
								<a
									href={l.href}
									class="px-0.5 text-[#8E867A] uppercase transition-colors duration-300 hover:text-academy-ink"
								>
									{l.code}
								</a>
							)}
						</>
					))
				}
			</div>

			<a
				href="#apply"
				data-magnetic
				class="inline-flex min-h-[2.5rem] items-center rounded-full bg-[linear-gradient(140deg,#A8927A,#8A7B66_55%,#6B5D4B)] px-4 text-[0.66rem] font-medium tracking-[0.03em] whitespace-nowrap text-white shadow-[0_12px_26px_-10px_rgb(138_123_102/.7),inset_0_1px_0_rgb(255_255_255/.35)] sm:min-h-[2.7rem] sm:px-6 sm:text-[0.75rem]"
			>
				{cta}
			</a>
		</div>
	</div>
</header>

<script>
	// Инициализация после разбора DOM: шапка рендерится раньше героя, и на
	// момент выполнения этого скрипта [data-hero] ещё не существует.
	const init = () => {
		const shell = document.getElementById('academy-header-shell');
		const header = document.getElementById('academy-header');
		const hero = document.querySelector('[data-hero]');
		if (!shell || !header) return;
		if (!hero || !('IntersectionObserver' in window)) {
			shell.dataset.stuck = 'true';
			return;
		}
		let io: IntersectionObserver | undefined;
		const observe = () => {
			io?.disconnect();
			io = new IntersectionObserver(
				(entries) => {
					shell.dataset.stuck = entries[0].isIntersecting ? 'false' : 'true';
				},
				{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 }
			);
			io.observe(hero);
		};
		observe();
		addEventListener('resize', observe);
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
	else init();
</script>
