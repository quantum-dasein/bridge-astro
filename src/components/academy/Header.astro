---
/**
 * Шапка: строгая, во всю ширину, карбоновая.
 *
 * Состояния намеренно нет. Раньше фон появлялся только после ухода героя
 * через IntersectionObserver, и когда переключение не срабатывало, белый
 * текст оставался на светлой секции — то есть нечитаемым. Постоянный
 * карбоновый фон читается над любой секцией и убирает весь этот класс
 * отказов вместе с зависимостью от JS.
 */

interface Props {
	nav: readonly { label: string; href: string }[];
	cta: string;
	current: 'ru' | 'en' | 'uz';
	langLinks: { ru: string; en: string; uz: string };
}

const { nav, cta, current, langLinks } = Astro.props;
const langs = [
	{ code: 'ru', href: langLinks.ru },
	{ code: 'en', href: langLinks.en },
	{ code: 'uz', href: langLinks.uz },
] as const;
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-academy-paper/12 bg-academy-carbon/88 backdrop-blur-xl backdrop-saturate-150"
>
	<div
		class="mx-auto flex h-[4.25rem] w-full max-w-[1400px] items-center justify-between gap-4 px-6 sm:px-10 lg:h-[4.75rem] lg:px-14"
	>
		<a href="https://www.bridgeconsult.uz/" class="shrink-0" aria-label="BRIDGE Consult">
			<img
				src="/bridge%202.svg"
				alt="BRIDGE Consult"
				width="120"
				height="32"
				class="h-6 w-auto object-contain brightness-0 invert sm:h-7"
			/>
		</a>

		<nav class="hidden items-center gap-8 lg:flex">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="relative py-1.5 text-[0.8rem] font-light tracking-[0.02em] text-academy-paper/70 transition-colors duration-300 hover:text-white after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-academy-brass after:transition-transform after:duration-300 hover:after:scale-x-100"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3 sm:gap-6">
			<div class="flex items-center gap-1.5 text-[0.64rem] font-medium tracking-[0.14em]">
				{
					langs.map((l, i) => (
						<>
							{i > 0 && <span class="text-academy-paper/25">/</span>}
							{l.code === current ? (
								<span class="text-academy-brass uppercase">{l.code}</span>
							) : (
								<a
									data-lang-link
									data-base={l.href}
									href={l.href}
									class="text-academy-paper/45 uppercase transition-colors duration-300 hover:text-white"
								>
									{l.code}
								</a>
							)}
						</>
					))
				}
			</div>

			<a
				href="#apply"
				class="inline-flex min-h-[2.4rem] items-center rounded-full border border-academy-paper/30 px-5 text-[0.62rem] font-semibold tracking-[0.16em] whitespace-nowrap text-academy-paper uppercase transition-colors duration-300 hover:border-academy-brass hover:bg-academy-brass hover:text-[#17130A] sm:min-h-[2.6rem] sm:px-7 sm:text-[0.68rem]"
			>
				{cta}
			</a>
		</div>
	</div>

	<!-- Навигация для телефона.
	     Ниже lg в шапке не было вообще никакого меню: ни бургера, ни ссылок.
	     Единственным способом добраться до раздела оставалась прокрутка всей
	     страницы, а у предложения подрядчикам это два десятка экранов. Полоса
	     чипов листается пальцем и едет вместе с фиксированной шапкой. -->
	<nav class="border-t border-academy-paper/10 lg:hidden" aria-label="Разделы страницы">
		<ul
			class="flex snap-x gap-2 overflow-x-auto px-6 py-2.5 [scrollbar-width:none] sm:px-10 [&::-webkit-scrollbar]:hidden"
		>
			{
				nav.map((item) => (
					<li class="shrink-0 snap-start">
						<a
							href={item.href}
							class="academy-mark inline-flex items-center rounded-full border border-academy-paper/15 bg-academy-paper/[0.04] px-3.5 py-1.5 text-[0.6rem] text-academy-paper/70 transition-colors duration-300 hover:border-academy-brass/60 hover:text-white"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	// Переключение языка не должно возвращать в начало страницы.
	//
	// Первая версия дописывала к адресу якорь текущей секции — и человек
	// попадал не туда, где читал, а в НАЧАЛО этой секции, то есть заметно
	// выше. Здесь запоминается ещё и то, насколько глубоко он в секции:
	// доля от её высоты. Доля, а не пиксели, потому что переводы разной
	// длины и одна и та же секция на разных языках имеет разную высоту.
	//
	// Якорь в адресе остаётся — он работает как запасной вариант без JS и
	// как грубая наводка, а точную позицию доводит скрипт после загрузки.
	const langLinks = document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]');

	if (langLinks.length) {
		const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
		// Линия чтения: сразу под фиксированной шапкой. На телефоне она выше —
		// под строкой с логотипом едет ещё полоса разделов.
		const READING_LINE = 140;
		const KEY = 'bc:lang-pos';

		/** Секция под линией чтения и глубина захода в неё долей высоты. */
		const position = () => {
			for (const el of sections) {
				const r = el.getBoundingClientRect();
				if (r.top <= READING_LINE && r.bottom > READING_LINE) {
					return { id: el.id, frac: (READING_LINE - r.top) / (r.height || 1) };
				}
			}
			return null;
		};

		// Адрес языковой ссылки держим в актуальном состоянии: без JS на той
		// стороне человек хотя бы попадёт в нужный раздел.
		const sync = () => {
			const pos = position();
			for (const link of langLinks) {
				const base = link.dataset.base ?? '';
				link.href = pos ? `${base}#${pos.id}` : base;
			}
		};

		for (const link of langLinks) {
			link.addEventListener('click', () => {
				const pos = position();
				// sessionStorage переживает переход внутри одного домена и
				// умирает вместе с вкладкой — ровно то, что нужно.
				if (pos) sessionStorage.setItem(KEY, JSON.stringify(pos));
				else sessionStorage.removeItem(KEY);
			});
		}

		addEventListener('scroll', sync, { passive: true });
		addEventListener('resize', sync, { passive: true });
		sync();

		// Восстановление на новой языковой версии.
		const saved = sessionStorage.getItem(KEY);
		if (saved) {
			sessionStorage.removeItem(KEY);
			try {
				const { id, frac } = JSON.parse(saved);
				const restore = () => {
					const el = document.getElementById(id);
					if (!el) return;
					const y = el.getBoundingClientRect().top + scrollY + frac * el.offsetHeight - READING_LINE;
					scrollTo({ top: Math.max(0, y), behavior: 'instant' });
				};
				restore();
				// Повторяем после загрузки картинок: пока они не пришли,
				// высоты секций другие и позиция уезжает.
				addEventListener('load', restore);
			} catch {
				/* мусор в хранилище — просто игнорируем */
			}
		}
	}
</script>
