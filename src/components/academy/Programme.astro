---
/**
 * «Чем эта программа отличается».
 *
 * Без стеклянной плиты: сетка 12 колонок, маркировка слева, текст в
 * колонках 3–8, цитата отдельным блоком справа на волосяной линейке.
 */

interface Props {
	id?: string;
	label: string;
	title: string;
	paragraphs: readonly string[];
	pullquote: string;
}

const { id = 'programme', label, title, paragraphs, pullquote } = Astro.props;
---

<section id={id} class="relative bg-academy-ground px-6 py-20 sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-8 border-t border-academy-ink/20 pt-8 lg:gap-x-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{label}</p>

			<div class="col-span-12 lg:col-span-6 lg:col-start-3">
				<h2
					class="academy-reveal max-w-[16ch] font-serif text-[clamp(1.8rem,3.2vw,2.8rem)] leading-[1.08] font-normal tracking-[-0.025em] text-balance"
				>
					{title}
				</h2>
				{
					paragraphs.map((p) => (
						<p
							class="academy-reveal mt-6 max-w-[58ch] text-[0.98rem] leading-relaxed font-light text-[#5C5449] [&_b]:font-medium [&_b]:text-academy-ink"
							set:html={p}
						/>
					))
				}
			</div>

			<div class="col-span-12 lg:col-span-3 lg:col-start-10">
				<p
					class="academy-reveal border-t border-academy-brass/50 pt-6 font-serif text-[clamp(1.2rem,1.8vw,1.55rem)] leading-[1.25] font-normal text-academy-taupe-deep italic"
				>
					{pullquote}
				</p>
			</div>
		</div>
	</div>
</section>
