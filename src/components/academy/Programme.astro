---
/**
 * «Чем эта программа отличается» — редакционная двухколонка с липким
 * заголовком слева и цитатой в конце текста.
 *
 * data-anim: label · title · para · pullquote
 */
import SectionLabel from './SectionLabel.astro';

interface Props {
	id?: string;
	label: string;
	title: string;
	paragraphs: readonly string[];
	pullquote: string;
}

const { id = 'programme', label, title, paragraphs, pullquote } = Astro.props;
---

<section id={id} class="relative py-24 lg:py-32">
	<div class="mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div class="grid gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-24">
			<div class="lg:sticky lg:top-32 lg:self-start">
				<SectionLabel text={label} />
				<h2
					data-anim="title"
					class="max-w-[14ch] font-serif text-[clamp(1.7rem,2.5vw,2.3rem)] leading-tight font-medium tracking-[-0.02em] text-white text-balance"
				>
					{title}
				</h2>
			</div>

			<div>
				{
					paragraphs.map((p) => (
						<p
							data-anim="para"
							class="mb-5 max-w-[64ch] text-[clamp(1rem,1.15vw,1.15rem)] leading-relaxed font-light text-gray-300 last:mb-0 [&_b]:font-medium [&_b]:text-white"
							set:html={p}
						/>
					))
				}
				<p
					data-anim="pullquote"
					class="mt-11 max-w-[38ch] border-t border-white/10 pt-8 font-serif text-[clamp(1.25rem,1.9vw,1.75rem)] leading-snug font-normal text-academy-gold-soft italic text-balance"
				>
					{pullquote}
				</p>
			</div>
		</div>
	</div>
</section>
