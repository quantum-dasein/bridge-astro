---
/**
 * Первый экран.
 *
 * Текст слева, тёмный снимок справа в высоком скруглённом вырезе. Плита
 * с цифрами — стеклянная, наезжает на снимок снизу; таблетка преподавателя
 * наезжает на плиту. Перекрытия и держат композицию: секция не выглядит
 * набором отдельных блоков.
 *
 * height:auto на снимке обязателен — атрибуты width/height в разметке это
 * презентационная подсказка CSS, и вместе с w-full они задают обе стороны,
 * из-за чего заданная высота игнорируется.
 */

interface Props {
	eyebrow: string;
	titleLines: string[];
	titleAccent: string;
	lead: string;
	ctaPrimary: { label: string; href: string };
	ctaSecondary: { label: string; href: string };
	credsText: string;
	imageAlt: string;
	stats: readonly { count?: number; value: string; suffix?: string; label: string }[];
}

const { eyebrow, titleLines, titleAccent, lead, ctaPrimary, ctaSecondary, credsText, imageAlt, stats } =
	Astro.props;
---

<section data-hero class="relative z-10 px-4 pt-28 sm:px-6 sm:pt-32 lg:px-10 lg:pt-36">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-end lg:gap-12">
			<!-- Текст -->
			<div class="academy-reveal lg:pb-24">
				<span
					class="academy-pill inline-block rounded-full px-5 py-2 text-[0.68rem] font-semibold tracking-[0.2em] text-academy-taupe-deep uppercase"
				>
					{eyebrow}
				</span>

				<h1
					class="mt-6 max-w-[13ch] font-serif text-[clamp(2.6rem,6vw,4.6rem)] leading-[0.98] font-medium tracking-[-0.03em] text-balance"
				>
					{titleLines.map((line) => <span class="block">{line}</span>)}
					<span
						class="block bg-[linear-gradient(104deg,#A8927A_6%,#8A7B66_46%,#5C4F3F)] bg-clip-text pb-[0.08em] italic text-transparent"
					>
						{titleAccent}
					</span>
				</h1>

				<p class="mt-6 max-w-[46ch] text-[clamp(1rem,1.3vw,1.1rem)] leading-relaxed font-light text-[#5C5449]">
					{lead}
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
					<a
						href={ctaPrimary.href}
						data-magnetic
						class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full bg-[linear-gradient(140deg,#A8927A,#8A7B66_52%,#5F5240)] px-9 text-[0.8rem] font-medium tracking-[0.03em] text-white shadow-[0_22px_46px_-18px_rgb(138_123_102/.8),inset_0_1.5px_0_rgb(255_255_255/.35)]"
					>
						{ctaPrimary.label}
					</a>
					<a
						href={ctaSecondary.href}
						class="academy-pill inline-flex min-h-[3.25rem] items-center justify-center rounded-full px-8 text-[0.8rem] font-medium text-academy-ink transition-colors duration-300 hover:text-academy-taupe-deep"
					>
						{ctaSecondary.label}
					</a>
				</div>
			</div>

			<!-- Снимок в высоком вырезе -->
			<div
				class="academy-reveal relative overflow-hidden rounded-[13rem] shadow-[0_44px_90px_-30px_rgb(63_50_36/.45),inset_0_0_0_1px_rgb(255_255_255/.55)]"
			>
				<picture>
					<source srcset="/academy-hero.avif" type="image/avif" />
					<source srcset="/academy-hero.webp" type="image/webp" />
					<img
						src="/academy-hero.png"
						alt={imageAlt}
						width="1600"
						height="900"
						fetchpriority="high"
						class="h-[clamp(20rem,42vw,32rem)] w-full object-cover object-[center_45%]"
					/>
				</picture>
				<div
					aria-hidden="true"
					class="absolute inset-0 bg-[linear-gradient(180deg,rgb(41_39_36/.1),rgb(41_39_36/.42))]"
				>
				</div>
			</div>
		</div>

		<!-- Плита с цифрами наезжает на снимок -->
		<div class="academy-reveal relative z-20 -mt-10 lg:-mt-14">
			<div class="academy-glass rounded-[2.6rem] px-6 py-7 sm:px-10 sm:py-8">
				<dl class="relative grid grid-cols-2 gap-y-6 lg:grid-cols-4 lg:gap-y-0">
					{
						stats.map((item, i) => (
							<div
								class={`px-2 text-center ${i > 0 ? 'lg:border-l lg:border-academy-taupe/22' : ''} ${i % 2 === 1 ? 'border-l border-academy-taupe/22 lg:border-l' : ''}`}
							>
								<dd class="font-serif text-[clamp(2rem,3.4vw,3rem)] leading-none font-medium tracking-[-0.02em] whitespace-nowrap text-academy-taupe-deep tabular-nums">
									<span data-count={item.count}>{item.value}</span>
									{item.suffix && <small class="text-[0.5em]">{item.suffix}</small>}
								</dd>
								<dt class="mx-auto mt-2 max-w-[16ch] text-[0.78rem] leading-snug font-light text-[#6E665B]">
									{item.label}
								</dt>
							</div>
						))
					}
				</dl>
			</div>
		</div>

		<!-- Преподаватель наезжает на плиту -->
		<div class="academy-reveal relative z-30 -mt-6 flex justify-center">
			<div class="academy-pill flex items-center gap-4 rounded-full py-2.5 pr-7 pl-2.5">
				<span
					aria-hidden="true"
					class="h-11 w-11 shrink-0 rounded-full bg-[linear-gradient(150deg,#E4D6BE,#A8927A)] shadow-[inset_0_1px_0_rgb(255_255_255/.7)]"
				>
				</span>
				<span class="max-w-[52ch] text-[0.82rem] leading-snug font-light text-[#4A443B]">
					<Fragment set:html={credsText} />
				</span>
			</div>
		</div>
	</div>
</section>
