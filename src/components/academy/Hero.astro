---
/**
 * Кинематографичный первый экран во весь вьюпорт.
 *
 * Слои:
 *   z-0   [data-hero-media] — обёртка overflow-hidden, внутри [data-hero-image]
 *   z-10  градиентный оверлей: плотный слева и снизу, прозрачный вправо-вверх
 *   z-20  контент
 *
 * Крючки под GSAP:
 *   data-hero-image   — Ken Burns / параллакс по скроллу. По умолчанию работает
 *                       CSS-анимация .hero-kenburns; если вешаешь GSAP, сними
 *                       этот класс, иначе трансформации будут спорить.
 *   data-hero-line    — строка заголовка, лежит в маске overflow-hidden,
 *                       заводится классическим yPercent: 100 -> 0
 *   data-hero-fade    — надзаголовок, абзац, кнопки, бейджи (stagger)
 *   data-scroll-cue   — индикатор прокрутки
 *
 * height:auto на снимке не нужен: обе стороны заданы намеренно (h-full w-full).
 */

interface Props {
	eyebrow: string;
	titleLines: string[];
	titleAccent: string;
	lead: string;
	ctaPrimary: { label: string; href: string };
	ctaSecondary: { label: string; href: string };
	credsText: string;
	imageAlt: string;
	scrollCue: string;
}

const { eyebrow, titleLines, titleAccent, lead, ctaPrimary, ctaSecondary, credsText, imageAlt, scrollCue } =
	Astro.props;
---

<section data-hero class="relative isolate flex min-h-screen flex-col justify-end overflow-hidden">
	<!-- Фон во весь экран -->
	<div data-hero-media class="absolute inset-0 z-0 overflow-hidden">
		<picture>
			<source srcset="/academy-hero.avif" type="image/avif" />
			<source srcset="/academy-hero.webp" type="image/webp" />
			<img
				data-hero-image
				src="/academy-hero.png"
				alt={imageAlt}
				width="1600"
				height="900"
				fetchpriority="high"
				class="hero-kenburns h-full w-full object-cover object-[center_45%]"
			/>
		</picture>
	</div>

	<!-- Оверлей: плотно слева и снизу, прозрачно вправо-вверх -->
	<div
		aria-hidden="true"
		class="absolute inset-0 z-10 bg-[linear-gradient(100deg,rgb(14_12_10/.92)_0%,rgb(14_12_10/.72)_32%,rgb(14_12_10/.28)_62%,transparent_88%),linear-gradient(0deg,rgb(14_12_10/.88)_0%,rgb(14_12_10/.35)_28%,transparent_58%)]"
	>
	</div>
	<!-- Тёплый отсвет, чтобы кадр не уходил в серость -->
	<div
		aria-hidden="true"
		class="absolute inset-0 z-10 bg-[radial-gradient(ellipse_50%_44%_at_16%_58%,rgb(201_183_156/.16),transparent_72%)]"
	>
	</div>
	<!-- Никакого растворения в светлый фон: полоса выходила белым мазком
	     поверх кадра и подписей. Кадр кончается чистым срезом. -->

	<!-- Контент -->
	<div class="relative z-20 px-6 pt-28 pb-36 sm:px-10 lg:px-14 lg:pt-28 lg:pb-36">
		<div class="mx-auto w-full max-w-[1400px]">
			<p data-hero-fade class="academy-mark flex flex-wrap items-center gap-x-4 gap-y-2 text-white/55">
				<span class="h-px w-11 bg-[linear-gradient(90deg,transparent,#A58A62)]"></span>
				<span class="text-academy-brass">Bridge Consult Academy</span>
				<span class="text-white/25">/</span>
				<span>Online programme</span>
				<span class="text-white/25">/</span>
				<span class="text-white/70">01</span>
			</p>

			<h1
				class="mt-7 max-w-[19ch] font-serif text-[clamp(2.1rem,5.3vw,4.9rem)] leading-[0.98] font-medium tracking-[-0.035em] text-white"
			>
				{
					titleLines.map((line) => (
						<span class="block overflow-hidden pb-[0.04em]">
							<span data-hero-line class="block">
								{line}
							</span>
						</span>
					))
				}
				<span class="block overflow-hidden pb-[0.1em]">
					<span
						data-hero-line
						class="block bg-[linear-gradient(102deg,#FBF3E4_4%,#E4D6BE_38%,#B49B74)] bg-clip-text italic text-transparent"
					>
						{titleAccent}
					</span>
				</span>
			</h1>

			<p
				data-hero-fade
				class="mt-7 max-w-[48ch] text-[clamp(1rem,1.45vw,1.2rem)] leading-relaxed font-light text-white/72"
			>
				{lead}
			</p>

			<div data-hero-fade class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
				<a
					href={ctaPrimary.href}
					class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full bg-academy-champagne px-11 text-[0.78rem] font-semibold tracking-[0.16em] text-[#17130A] uppercase transition-colors duration-300 hover:bg-white"
				>
					{ctaPrimary.label}
				</a>
				<a
					href={ctaSecondary.href}
					class="inline-flex min-h-[3.4rem] items-center justify-center rounded-full border border-white/30 bg-white/8 px-11 text-[0.78rem] font-semibold tracking-[0.16em] text-white uppercase backdrop-blur-md transition-colors duration-300 hover:border-white/60 hover:bg-white/15"
				>
					{ctaSecondary.label}
				</a>
			</div>

			<div
				data-hero-fade
				class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-white/15 pt-6"
			>
				<img src="/fidic-fcce-badge.png" alt="FIDIC Certified Consulting Engineer" width="78" height="56" class="h-14 w-auto max-w-[5rem] object-contain" />
				<img src="/fidic-fccp-badge.png" alt="FIDIC Certified Consulting Professional" width="78" height="56" class="h-14 w-auto max-w-[5rem] object-contain" />
				<span class="max-w-[34ch] text-[0.8rem] leading-relaxed font-light text-white/60">
					<Fragment set:html={credsText} />
				</span>
			</div>
		</div>
	</div>

	<!-- Индикатор прокрутки -->
	<div
		data-scroll-cue
		class="absolute inset-x-0 bottom-24 z-20 hidden flex-col items-center gap-2.5 lg:flex"
	>
		<span class="text-[0.62rem] font-medium tracking-[0.3em] text-white/45 uppercase">{scrollCue}</span>
		<span aria-hidden="true" class="hero-cue-line block h-10 w-px origin-top bg-[linear-gradient(180deg,rgb(255_255_255/.7),transparent)]"></span>
	</div>
</section>

<style>
	/* Ken Burns по умолчанию — очень медленный зум со сдвигом.
	   Если вешаешь GSAP на [data-hero-image], сними класс hero-kenburns:
	   иначе CSS-трансформация и GSAP будут спорить за один и тот же transform. */
	@keyframes hero-kenburns {
		from { transform: scale(1.04) translate3d(0, 0, 0); }
		to { transform: scale(1.16) translate3d(-1.6%, -1.4%, 0); }
	}
	.hero-kenburns {
		transform: scale(1.04);
		animation: hero-kenburns 26s ease-in-out infinite alternate;
		will-change: transform;
	}

	@keyframes hero-cue {
		0%, 100% { transform: scaleY(.35); opacity: .35; }
		50% { transform: scaleY(1); opacity: .9; }
	}
	.hero-cue-line { animation: hero-cue 2.6s cubic-bezier(.22,.61,.36,1) infinite; }

	/* Появление при загрузке — работает и без GSAP. */
	[data-hero-line] { animation: hero-line-in .95s cubic-bezier(.22,.61,.36,1) both; }
	@keyframes hero-line-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
	h1 span:nth-child(1) [data-hero-line] { animation-delay: .15s; }
	h1 span:nth-child(2) [data-hero-line] { animation-delay: .27s; }
	h1 span:nth-child(3) [data-hero-line] { animation-delay: .39s; }

	[data-hero-fade] { animation: hero-fade-in .9s cubic-bezier(.22,.61,.36,1) both; }
	@keyframes hero-fade-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
	[data-hero-fade]:nth-of-type(1) { animation-delay: .1s; }

	@media (prefers-reduced-motion: reduce) {
		.hero-kenburns { animation: none; transform: scale(1.02); }
		.hero-cue-line { animation: none; }
		[data-hero-line], [data-hero-fade] { animation: none; }
	}
</style>
