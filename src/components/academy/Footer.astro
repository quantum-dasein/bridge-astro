---
/**
 * Футер.
 *
 * Структура повторяет общий SiteFooter.astro — бренд с описанием, навигация,
 * контакты, копирайт, — но живёт на палитре лендинга. Раньше он тащил с
 * основного сайта скруглённую шапку 3rem, четырёхпиксельный тауповый кант и
 * свой оттенок тёмного: на карбоне лендинга это читалось как приклеенная
 * чужая плита. Здесь — тот же карбон, что и в остальных тёмных секциях,
 * волосяные линейки и латунные акценты.
 */

interface Props {
	description: string;
	navTitle: string;
	nav: readonly { label: string; href: string }[];
	contactsTitle: string;
	address: string;
	rights: string;
	disclaimer: string;
}

const { description, navTitle, nav, contactsTitle, address, rights, disclaimer } = Astro.props;
---

<footer class="relative bg-academy-carbon px-6 pt-16 pb-9 text-academy-paper sm:px-10 lg:px-14 lg:pt-20">
	<div class="relative z-10 mx-auto w-full max-w-[1400px]">
		<div class="mb-12 grid grid-cols-1 gap-10 border-t border-academy-paper/20 pt-10 md:mb-16 md:grid-cols-2 md:gap-12 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-5">
				<a href="https://www.bridgeconsult.uz/" class="mb-5 inline-flex w-max flex-col">
					<span class="font-serif text-3xl leading-none font-normal tracking-tight text-academy-paper">Bridge</span>
					<span class="academy-mark text-academy-brass">Consult</span>
				</a>
				<p class="mb-7 max-w-sm text-[0.88rem] leading-relaxed font-light text-academy-paper/55">{description}</p>
				<div class="flex flex-wrap items-center gap-4">
					<img src="/fidic-fcce-badge.png" alt="FIDIC Certified Consulting Engineer" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
					<img src="/fidic-fccp-badge.png" alt="FIDIC Certified Consulting Professional" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
				</div>
			</div>

			<div class="lg:col-span-3">
				<h4 class="academy-mark mb-5 text-academy-brass md:mb-6">{navTitle}</h4>
				<ul class="text-[0.9rem] font-light text-academy-paper/75">
					{
						nav.map((item) => (
							<li class="border-t border-academy-paper/12 first:border-0">
								<a
									href={item.href}
									class="block py-2.5 transition-colors duration-300 first:pt-0 hover:text-academy-brass"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-4">
				<h4 class="academy-mark mb-5 text-academy-brass md:mb-6">{contactsTitle}</h4>
				<ul class="space-y-5 text-[0.9rem] font-light text-academy-paper/75">
					<li class="flex items-start">
						<svg class="mt-0.5 mr-3.5 h-5 w-5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						<span class="leading-relaxed" set:html={address} />
					</li>
					<li class="flex items-center">
						<svg class="mr-3.5 h-5 w-5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
						</svg>
						<a href="tel:+998330001530" class="text-base transition-colors duration-300 hover:text-academy-brass">+998 33 000 15 30</a>
					</li>
					<li class="flex items-center">
						<svg class="mr-3.5 h-5 w-5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
						</svg>
						<a href="mailto:info@bridgeconsult.uz" class="break-all transition-colors duration-300 hover:text-academy-brass">info@bridgeconsult.uz</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="border-t border-academy-paper/15 pt-7">
			<p class="mb-3 max-w-[86ch] text-[0.76rem] leading-relaxed font-light text-academy-paper/45">
				{disclaimer}
			</p>
			<p class="text-[0.76rem] font-light text-academy-paper/35">
				&copy; 2016–2026 Bridge Consult. {rights}
			</p>
		</div>
	</div>
</footer>
