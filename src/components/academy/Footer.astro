---
/**
 * Футер лендинга.
 *
 * Структура повторяет общий SiteFooter.astro основного сайта — бренд с
 * описанием, навигация, контакты с иконками, копирайт — но в палитре
 * лендинга: золото вместо taupe и более глубокий фон.
 */

interface Props {
	description: string;
	navTitle: string;
	nav: readonly { label: string; href: string }[];
	contactsTitle: string;
	address: string;
	rights: string;
	disclaimer: string;
}

const { description, navTitle, nav, contactsTitle, address, rights, disclaimer } = Astro.props;
---

<footer
	class="relative overflow-hidden border-t-2 border-academy-gold bg-academy-ink pt-16 pb-8 md:pt-20"
>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute -top-40 -right-40 h-96 w-96 rounded-full bg-academy-gold/5 blur-3xl"
	>
	</div>

	<div class="relative z-10 mx-auto w-full max-w-[1400px] px-6 lg:px-12">
		<div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-12 lg:gap-8 md:mb-16">
			<!-- Бренд -->
			<div class="lg:col-span-5">
				<a href="https://www.bridgeconsult.uz/" class="mb-5 inline-flex w-max flex-col">
					<span class="font-serif text-3xl leading-none font-medium tracking-tight text-white">Bridge</span>
					<span class="text-[11px] font-semibold tracking-[0.24em] text-academy-gold uppercase">Consult</span>
				</a>
				<p class="mb-7 max-w-sm text-sm leading-relaxed font-light text-gray-400">{description}</p>
				<div class="flex flex-wrap items-center gap-4">
					<img
						src="/fidic-fcce-badge.png"
						alt="FIDIC Certified Consulting Engineer"
						width="70"
						height="52"
						loading="lazy"
						class="h-13 w-auto object-contain"
					/>
					<img
						src="/fidic-fccp-badge.png"
						alt="FIDIC Certified Consulting Professional"
						width="70"
						height="52"
						loading="lazy"
						class="h-13 w-auto object-contain"
					/>
				</div>
			</div>

			<!-- Навигация -->
			<div class="lg:col-span-3">
				<h4 class="mb-5 text-xs font-semibold tracking-[0.2em] text-white uppercase md:mb-6">{navTitle}</h4>
				<ul class="space-y-3.5 text-sm font-light text-gray-300">
					{
						nav.map((item) => (
							<li>
								<a href={item.href} class="transition-colors duration-300 hover:text-academy-gold-soft">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Контакты -->
			<div class="lg:col-span-4">
				<h4 class="mb-5 text-xs font-semibold tracking-[0.2em] text-white uppercase md:mb-6">
					{contactsTitle}
				</h4>
				<ul class="space-y-5 text-sm font-light text-gray-300">
					<li class="flex items-start">
						<svg
							class="mt-0.5 mr-3.5 h-5 w-5 shrink-0 text-academy-gold"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
								d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
								d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						<span class="leading-relaxed" set:html={address} />
					</li>
					<li class="flex items-center">
						<svg
							class="mr-3.5 h-5 w-5 shrink-0 text-academy-gold"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<a
							href="tel:+998330001530"
							class="text-base transition-colors duration-300 hover:text-academy-gold-soft"
						>
							+998 33 000 15 30
						</a>
					</li>
					<li class="flex items-center">
						<svg
							class="mr-3.5 h-5 w-5 shrink-0 text-academy-gold"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="1.5"
								d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
							></path>
						</svg>
						<a
							href="mailto:info@bridgeconsult.uz"
							class="break-all transition-colors duration-300 hover:text-academy-gold-soft"
						>
							info@bridgeconsult.uz
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="border-t border-white/10 pt-7">
			<p class="mb-3 max-w-[80ch] text-xs leading-relaxed font-light text-gray-400">{disclaimer}</p>
			<p class="text-xs font-light text-gray-500">&copy; 2016–2026 Bridge Consult. {rights}</p>
		</div>
	</div>
</footer>
