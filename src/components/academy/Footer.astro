---
/**
 * Футер.
 *
 * Живёт на палитре лендинга: тот же карбон, что в тёмных секциях, волосяные
 * линейки, латунные акценты. Раньше он тащил с основного сайта скруглённую
 * шапку 3rem и тауповый кант — на карбоне это читалось как приклеенная
 * чужая плита.
 *
 * Логотип — настоящий /bridge 2.svg, тот же файл, что в шапке сайта и
 * лендинга. Набранная текстом пара «Bridge / CONSULT» была самоделкой и
 * не совпадала с фирменным знаком.
 *
 * Сверху — крупная зона с логотипом и адресом почты как призывом: футер
 * должен заканчивать страницу, а не осыпаться мелкими колонками.
 */

interface Props {
	description: string;
	navTitle: string;
	nav: readonly { label: string; href: string }[];
	contactsTitle: string;
	address: string;
	rights: string;
	disclaimer: string;
}

const { description, navTitle, nav, contactsTitle, address, rights, disclaimer } = Astro.props;
---

<footer class="relative overflow-hidden bg-academy-carbon px-6 pt-16 pb-9 text-academy-paper sm:px-10 lg:px-14 lg:pt-20">
	<!-- Тёплый отсвет в левом верхнем углу, чтобы карбон не был плоским -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_46%_58%_at_8%_0%,rgb(165_138_98/.14),transparent_70%)]"
	>
	</div>

	<div class="relative z-10 mx-auto w-full max-w-[1400px]">
		<!-- Верхняя зона: знак и почта крупно, на одной линейке -->
		<div
			class="flex flex-col gap-8 border-t border-academy-paper/20 pt-10 md:flex-row md:items-end md:justify-between"
		>
			<a href="https://www.bridgeconsult.uz/" class="inline-flex w-max" aria-label="BRIDGE Consult">
				<img
					src="/bridge%202.svg"
					alt="BRIDGE Consult"
					width="200"
					height="54"
					loading="lazy"
					class="h-11 w-auto object-contain brightness-0 invert lg:h-12"
				/>
			</a>

			<a
				href="mailto:info@bridgeconsult.uz"
				class="group inline-flex items-center gap-4 font-serif text-[clamp(1.4rem,3vw,2.4rem)] leading-none font-normal tracking-[-0.02em] text-academy-paper transition-colors duration-300 hover:text-academy-brass"
			>
				info@bridgeconsult.uz
				<span
					aria-hidden="true"
					class="h-px w-8 bg-academy-brass transition-all duration-300 group-hover:w-16"
				></span>
			</a>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-5">
				<p class="max-w-sm text-[0.88rem] leading-relaxed font-light text-academy-paper/55">{description}</p>
				<div class="mt-7 flex flex-wrap items-center gap-4">
					<img src="/fidic-fcce-badge.png" alt="FIDIC Certified Consulting Engineer" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
					<img src="/fidic-fccp-badge.png" alt="FIDIC Certified Consulting Professional" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
					<img src="/ciarb-logo.png" alt="CIArb — Chartered Institute of Arbitrators" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
					<img src="/drbf-logo.png" alt="DRBF — Dispute Resolution Board Foundation" width="70" height="52" loading="lazy" class="h-12 w-auto max-w-[4.5rem] object-contain" />
				</div>
			</div>

			<div class="lg:col-span-3">
				<h4 class="academy-mark mb-4 text-academy-brass">{navTitle}</h4>
				<ul class="text-[0.9rem] font-light text-academy-paper/75">
					{
						nav.map((item) => (
							<li class="border-t border-academy-paper/12 first:border-0">
								<a
									href={item.href}
									class="group flex items-center justify-between gap-3 py-2.5 transition-colors duration-300 hover:text-academy-brass"
								>
									{item.label}
									<span
										aria-hidden="true"
										class="h-px w-0 bg-academy-brass transition-all duration-300 group-hover:w-5"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-4">
				<h4 class="academy-mark mb-4 text-academy-brass">{contactsTitle}</h4>
				<ul class="space-y-4 text-[0.9rem] font-light text-academy-paper/75">
					<li class="flex items-start border-t border-academy-paper/12 pt-3.5">
						<svg class="mt-0.5 mr-3.5 h-4.5 w-4.5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						<span class="leading-relaxed" set:html={address} />
					</li>
					<li class="flex items-center border-t border-academy-paper/12 pt-3.5">
						<svg class="mr-3.5 h-4.5 w-4.5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
						</svg>
						<a href="tel:+998330001530" class="transition-colors duration-300 hover:text-academy-brass">+998 33 000 15 30</a>
					</li>
					<li class="flex items-center border-t border-academy-paper/12 pt-3.5">
						<svg class="mr-3.5 h-4.5 w-4.5 shrink-0 text-academy-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19 14.5M14.25 3.104c.251.023.501.05.75.082M19 14.5v4a2 2 0 01-2 2H7a2 2 0 01-2-2v-4"></path>
						</svg>
						<a href="/larisa-belousova-cv.pdf" target="_blank" rel="noopener" class="transition-colors duration-300 hover:text-academy-brass">CV (PDF)</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-14 border-t border-academy-paper/15 pt-7">
			<p class="mb-3 max-w-[86ch] text-[0.76rem] leading-relaxed font-light text-academy-paper/45">
				{disclaimer}
			</p>
			<p class="text-[0.76rem] font-light text-academy-paper/35">
				&copy; 2016–2026 Bridge Consult. {rights}
			</p>
		</div>
	</div>
</footer>
