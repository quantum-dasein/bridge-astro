---
/**
 * Знаки аккредитаций — одним компонентом на всю страницу.
 *
 * Раньше это был просто ряд <img> без рамок и без ссылок: логотипы висели
 * на фоне как случайные картинки разного размера и веса. Теперь каждый знак
 * сидит в своей рамке одинаковой высоты и ведёт на страницу организации.
 *
 * Знаки FIDIC ведут НЕ на страницу программы, а на именной сертификат
 * Ларисы в реестре FIDIC (credentials.fidic.org/credential/<uuid>): по клику
 * открывается сам документ с серийным номером и статусом Verified, а не
 * рекламная страница про аккредитацию вообще. Идентификаторы выданы FIDIC
 * Credentialing: FCCE от 27.11.2024, FCCP от 07.03.2024.
 *
 * Адреса проверены запросами 26.08.2026 — все отдают 200. Прежние вели в
 * никуда: fidic.org/professional-credentialing отдаёт 404, а drb.org
 * редиректит на drbf.org и по https сам не отвечает.
 *
 * tone="light" — для светлых секций, tone="dark" — для карбона и снимков.
 */

interface Props {
	tone?: 'light' | 'dark';
	/** Показывать только два знака FIDIC: для первого экрана и футера. */
	compact?: boolean;
	class?: string;
}

const { tone = 'light', compact = false, class: extra = '' } = Astro.props;

const items = [
	{
		src: '/fidic-fcce-badge.png',
		alt: 'FIDIC Certified Consulting Engineer',
		title: 'FIDIC Certified Consulting Engineer (FCCE) — открыть сертификат',
		href: 'https://credentials.fidic.org/credential/69f72bbf-bc1f-4f5e-b480-90590afd6440',
	},
	{
		src: '/fidic-fccp-badge.png',
		alt: 'FIDIC Certified Consulting Professional',
		title: 'FIDIC Certified Consulting Professional (FCCP) — открыть сертификат',
		href: 'https://credentials.fidic.org/credential/d97d9db8-ab47-4971-81aa-495bfcf78b9e',
	},
	{
		src: '/ciarb-logo.png',
		alt: 'CIArb — Chartered Institute of Arbitrators',
		title: 'Chartered Institute of Arbitrators — MCIArb',
		href: 'https://www.ciarb.org',
	},
	{
		src: '/drbf-logo.png',
		alt: 'DRBF — Dispute Resolution Board Foundation',
		title: 'Dispute Resolution Board Foundation',
		href: 'https://www.drbf.org',
	},
];

const shown = compact ? items.slice(0, 2) : items;

const frame =
	tone === 'dark'
		? 'border-academy-paper/20 bg-academy-paper/[0.06] hover:border-academy-brass/70 hover:bg-academy-paper/10'
		: 'border-academy-ink/15 bg-white hover:border-academy-brass/70 hover:bg-academy-champagne/25';
---

<ul class={`flex flex-wrap items-stretch gap-2.5 ${extra}`}>
	{
		shown.map((b) => (
			<li>
				<a
					href={b.href}
					target="_blank"
					rel="noopener"
					title={b.title}
					aria-label={b.title}
					class={`group flex h-16 w-[5.5rem] items-center justify-center rounded-xl border px-2.5 transition-all duration-300 hover:-translate-y-0.5 ${frame}`}
				>
					<img
						src={b.src}
						alt={b.alt}
						width="80"
						height="60"
						loading="lazy"
						class="h-10 w-auto max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
					/>
				</a>
			</li>
		))
	}
</ul>
