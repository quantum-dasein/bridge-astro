---
// Email-gated lead magnet: "28 days claim checklist" PDF.
// Submits to the existing Formspree inbox with form=claim-checklist marker,
// then triggers the PDF download client-side.
interface Props { lang?: string; page?: string }
const { lang = 'ru', page = '' } = Astro.props;

const t = {
	ru: {
		kicker: 'Бесплатный чек-лист',
		title: '28 дней: что делать подрядчику при событии claim',
		sub: 'PDF-чеклист: шесть шагов с дедлайнами по FIDIC 2017 и красные флаги, из-за которых теряют право на EOT и компенсацию.',
		placeholder: 'Ваш рабочий email',
		btn: 'Получить чек-лист',
		sending: 'Отправка…',
		success: 'Готово! Скачивание началось.',
		again: 'Скачать ещё раз',
		error: 'Не получилось отправить. Напишите нам: info@bridgeconsult.uz',
		privacy: 'Никакого спама — только чек-лист и редкие экспертные материалы.',
		file: '/files/claim-checklist-28-days-ru.pdf',
	},
	en: {
		kicker: 'Free checklist',
		title: '28 days: what a contractor must do when a claim event occurs',
		sub: 'A PDF checklist: six deadline-driven steps under FIDIC 2017 and the red flags that cost contractors their right to EOT and compensation.',
		placeholder: 'Your work email',
		btn: 'Get the checklist',
		sending: 'Sending…',
		success: 'Done! Your download has started.',
		again: 'Download again',
		error: 'Something went wrong. Email us: info@bridgeconsult.uz',
		privacy: 'No spam — just the checklist and occasional expert materials.',
		file: '/files/claim-checklist-28-days-en.pdf',
	},
	uz: {
		kicker: 'Bepul chek-list',
		title: '28 kun: claim hodisasida pudratchi nima qilishi kerak',
		sub: "PDF chek-list: FIDIC 2017 bo'yicha muddatli olti qadam va EOT hamda kompensatsiya huquqidan mahrum qiladigan xatolar (rus tilida).",
		placeholder: 'Ish emailingiz',
		btn: 'Chek-listni olish',
		sending: 'Yuborilmoqda…',
		success: 'Tayyor! Yuklab olish boshlandi.',
		again: 'Yana yuklab olish',
		error: "Yuborib bo'lmadi. Bizga yozing: info@bridgeconsult.uz",
		privacy: "Spam yo'q — faqat chek-list va vaqti-vaqti bilan ekspert materiallari.",
		file: '/files/claim-checklist-28-days-ru.pdf',
	},
}[lang as 'ru' | 'en' | 'uz'] ?? {
	kicker: 'Бесплатный чек-лист', title: '28 дней: что делать подрядчику при событии claim',
	sub: '', placeholder: 'Email', btn: 'Получить чек-лист', sending: '…', success: 'Готово!',
	again: 'Скачать ещё раз', error: 'Ошибка', privacy: '', file: '/files/claim-checklist-28-days-ru.pdf',
};
---

<div class="bc-leadmagnet not-prose relative mt-14 overflow-hidden rounded-3xl bg-bridge-dark p-8 md:p-10" data-aos="fade-up" data-file={t.file} data-lang={lang} data-page={page}>
	<div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[480px] -translate-x-1/2 rounded-full" style="background:radial-gradient(ellipse,rgba(138,123,102,0.28),transparent 70%);"></div>
	<div class="relative z-10">
		<span class="mb-3 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.28em] text-bridge-taupe">
			<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
			{t.kicker}
		</span>
		<p class="mb-2 text-xl font-bold leading-snug text-white md:text-2xl">{t.title}</p>
		<p class="mb-6 max-w-xl text-sm font-light leading-relaxed text-gray-400">{t.sub}</p>

		<form class="bc-lm-form flex flex-col gap-3 sm:flex-row" novalidate>
			<input type="email" name="email" required placeholder={t.placeholder} autocomplete="email"
				class="w-full flex-1 rounded-full border border-white/15 bg-white/5 px-6 py-3.5 text-sm text-white placeholder-gray-500 outline-none transition-colors focus:border-bridge-taupe" />
			<button type="submit" data-label={t.btn} data-sending={t.sending}
				class="shrink-0 rounded-full bg-bridge-taupe px-8 py-3.5 text-[11px] font-bold uppercase tracking-[0.16em] text-white transition-all hover:-translate-y-0.5 hover:bg-[#9c8d76] disabled:opacity-60">
				{t.btn}
			</button>
		</form>
		<p class="bc-lm-success mt-4 hidden items-center gap-2 text-sm font-medium text-[#8fd694]">
			<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
			<span>{t.success}</span>
			<a class="underline decoration-bridge-taupe underline-offset-4 hover:text-white" href={t.file} download>{t.again}</a>
		</p>
		<p class="bc-lm-error mt-4 hidden text-sm text-[#e8a0a0]">{t.error}</p>
		<p class="mt-3 text-[11px] font-light text-gray-500">{t.privacy}</p>
	</div>
</div>

<script>
	function initLeadMagnets() {
		document.querySelectorAll<HTMLElement>('.bc-leadmagnet').forEach((box) => {
			const form = box.querySelector<HTMLFormElement>('.bc-lm-form');
			if (!form || form.dataset.bound) return;
			form.dataset.bound = '1';
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const email = form.querySelector<HTMLInputElement>('input[name=email]');
				const btn = form.querySelector<HTMLButtonElement>('button');
				const ok = box.querySelector<HTMLElement>('.bc-lm-success');
				const err = box.querySelector<HTMLElement>('.bc-lm-error');
				if (!email || !email.value || !email.checkValidity()) { email?.focus(); return; }
				if (btn) { btn.disabled = true; btn.textContent = btn.dataset.sending || '…'; }
				err?.classList.add('hidden');
				try {
					const fd = new FormData();
					fd.append('email', email.value);
					fd.append('form', 'claim-checklist');
					fd.append('lang', box.dataset.lang || '');
					fd.append('page', box.dataset.page || location.pathname);
					fd.append('_subject', 'Лид-магнит: чек-лист 28 дней (' + email.value + ')');
					const res = await fetch('https://formspree.io/f/meedwzjw', {
						method: 'POST', body: fd, headers: { Accept: 'application/json' },
					});
					if (!res.ok) throw new Error('formspree ' + res.status);
					form.classList.add('hidden');
					ok?.classList.remove('hidden');
					ok?.classList.add('flex');
					const a = document.createElement('a');
					a.href = box.dataset.file || '';
					a.download = '';
					document.body.appendChild(a);
					a.click();
					a.remove();
				} catch {
					err?.classList.remove('hidden');
					if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || ''; }
				}
			});
		});
	}
	initLeadMagnets();
	document.addEventListener('astro:page-load', initLeadMagnets);
</script>
