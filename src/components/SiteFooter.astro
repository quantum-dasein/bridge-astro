---
interface Props { lang?: string; }
const { lang = 'ru' } = Astro.props;

const home = lang === 'uz' ? '/UZ/' : lang === 'en' ? '/EN/' : '/';
const projects = lang === 'uz' ? '/UZ/projects.html' : lang === 'en' ? '/EN/projects.html' : '/projects.html';
const news = lang === 'uz' ? '/news/uz/' : lang === 'en' ? '/news/en/' : '/news/';

const t = {
	ru: {
		description: 'Ваш надежный партнер в контрактном инжиниринге и разрешении споров. Строим мосты между правовой надежностью и успешной реализацией проектов.',
		nav: 'Навигация',
		about: 'О компании',
		services: 'Услуги',
		projects: 'Проекты',
		news: 'Новости',
		trainings: 'Обучение',
		media: 'СМИ и публикации',
		contacts: 'Контактные данные',
		address: '100180, Республика Узбекистан,<br>г. Ташкент, Юнусабадский район,<br>ул. Ахмада Дониша, 12 квартал, 20А',
		rights: 'Все права защищены.',
	},
	en: {
		description: 'Your trusted partner in contract engineering and dispute resolution. We build bridges between legal certainty and successful project delivery.',
		nav: 'Navigation',
		about: 'About Us',
		services: 'Services',
		projects: 'Projects',
		news: 'News',
		trainings: 'Training',
		media: 'Media & Publications',
		contacts: 'Contact Details',
		address: '100180, Republic of Uzbekistan,<br>Tashkent, Yunusabad district,<br>Ahmad Donish St., block 12, 20A',
		rights: 'All rights reserved.',
	},
	uz: {
		description: 'Shartnoma injiniringi va nizolarni hal qilishda ishonchli hamkoringiz. Huquqiy ishonchlilik va loyihalarni muvaffaqiyatli amalga oshirish o‘rtasida ko‘priklar quramiz.',
		nav: 'Navigatsiya',
		about: 'Kompaniya haqida',
		services: 'Xizmatlar',
		projects: 'Loyihalar',
		news: 'Yangiliklar',
		trainings: "Ta'lim",
		media: 'OAV va nashrlar',
		contacts: 'Aloqa ma’lumotlari',
		address: '100180, O‘zbekiston Respublikasi,<br>Toshkent shahri, Yunusobod tumani,<br>Ahmad Donish ko‘chasi, 12-kvartal, 20A',
		rights: 'Barcha huquqlar himoyalangan.',
	},
}[lang as 'ru' | 'en' | 'uz'] ?? null as never;
---

<footer class="bg-bridge-dark pt-16 md:pt-20 pb-8 border-t-4 border-bridge-taupe relative overflow-hidden font-sans">
	<div class="absolute top-0 right-0 w-64 md:w-96 h-64 md:h-96 bg-white/5 rounded-full blur-3xl -mr-32 md:-mr-48 -mt-32 md:-mt-48 pointer-events-none"></div>
	<div class="max-w-7xl mx-auto px-6 relative z-10">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 md:gap-12 mb-12 md:mb-16">
			<div class="lg:col-span-5">
				<a href={home} class="inline-flex flex-col mb-4 md:mb-6 w-max">
					<span class="text-3xl font-bold tracking-tight text-white leading-none">Bridge</span>
					<span class="text-[10px] md:text-xs tracking-widest text-bridge-taupe uppercase font-semibold">Consult</span>
				</a>
				<p class="text-gray-400 font-light leading-relaxed max-w-sm mb-6 md:mb-8 text-sm md:text-base">{t.description}</p>
			</div>

			<div class="lg:col-span-3">
				<h4 class="text-white font-bold uppercase tracking-widest text-xs md:text-sm mb-4 md:mb-6">{t.nav}</h4>
				<ul class="space-y-3 md:space-y-4 text-gray-400 font-light text-sm">
					<li><a href={`${home}#about`} class="hover:text-bridge-taupe transition-colors">{t.about}</a></li>
					<li><a href={`${home}#services`} class="hover:text-bridge-taupe transition-colors">{t.services}</a></li>
					<li><a href={projects} class="hover:text-bridge-taupe transition-colors">{t.projects}</a></li>
					<li><a href={news} class="hover:text-bridge-taupe transition-colors">{t.news}</a></li>
					<li><a href={`${home}#trainings`} class="hover:text-bridge-taupe transition-colors">{t.trainings}</a></li>
					<li><a href={`${home}#media`} class="hover:text-bridge-taupe transition-colors">{t.media}</a></li>
				</ul>
			</div>

			<div class="lg:col-span-4">
				<h4 class="text-white font-bold uppercase tracking-widest text-xs md:text-sm mb-4 md:mb-6">{t.contacts}</h4>
				<ul class="space-y-4 md:space-y-6 text-gray-400 font-light text-sm">
					<li class="flex items-start">
						<svg class="w-5 h-5 md:w-6 md:h-6 text-bridge-taupe mr-3 md:mr-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
						<span class="leading-relaxed" set:html={t.address}></span>
					</li>
					<li class="flex items-center">
						<svg class="w-5 h-5 md:w-6 md:h-6 text-bridge-taupe mr-3 md:mr-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
						<a href="tel:+998330001530" class="hover:text-bridge-taupe transition-colors text-base md:text-lg">+998 33 000 15 30</a>
					</li>
					<li class="flex items-center">
						<svg class="w-5 h-5 md:w-6 md:h-6 text-bridge-taupe mr-3 md:mr-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						<a href="mailto:info@bridgeconsult.uz" class="hover:text-bridge-taupe transition-colors break-all">info@bridgeconsult.uz</a>
					</li>
				</ul>
			</div>
		</div>
		<div class="pt-6 md:pt-8 border-t border-gray-800 flex flex-col items-center justify-center text-xs md:text-sm text-gray-500 font-light text-center">
			<p>&copy; 2016-2026 Bridge Consult. {t.rights}</p>
		</div>
	</div>
</footer>
