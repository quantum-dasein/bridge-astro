---
/**
 * Три направления работы — карточки со снимком-фоном.
 *
 * Тот же приём, что у потоков Академии: снимок и есть карточка. До lg —
 * горизонтальная лента со снапом, чтобы три высокие карточки не разворачивали
 * телефон в бесконечный столбик.
 */

interface Props {
	id?: string;
	mark: string;
	title: string;
	lead?: string;
	items: readonly {
		roman: string;
		title: string;
		text: string;
		image: string;
		imageAlt: string;
	}[];
}

const { id, mark, title, lead, items } = Astro.props;
---

<section id={id} class="relative bg-academy-carbon px-6 py-16 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-4 border-t border-academy-paper/20 pt-7 lg:gap-y-5 lg:pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{mark}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[20ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.1] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			{
				lead && (
					<p class="academy-reveal col-span-12 max-w-[44ch] text-[0.92rem] leading-relaxed font-light text-academy-paper/55 lg:col-span-4 lg:col-start-9">
						{lead}
					</p>
				)
			}
		</div>

		<p class="academy-mark mt-8 flex items-center gap-2.5 text-academy-paper/40 lg:hidden">
			Листайте вбок
			<svg class="h-3 w-6" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M0 6h21m0 0l-5-5m5 5l-5 5" />
			</svg>
		</p>

		<div
			class="academy-reveal -mx-6 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 [scrollbar-width:none] sm:-mx-10 sm:px-10 lg:mx-0 lg:mt-14 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden"
		>
			{
				items.map((item) => (
					<article class="group relative isolate flex w-[86%] shrink-0 snap-start flex-col overflow-hidden rounded-[1.75rem] border border-academy-paper/12 transition-transform duration-600 hover:-translate-y-1 sm:w-[62%] lg:w-auto lg:shrink">
						<picture>
							<source srcset={`/${item.image}.avif`} type="image/avif" />
							<source srcset={`/${item.image}.webp`} type="image/webp" />
							<img
								src={`/${item.image}.png`}
								alt={item.imageAlt}
								width="900"
								height="675"
								loading="lazy"
								class="absolute inset-0 -z-10 h-full w-full scale-105 object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-100"
							/>
						</picture>
						<span
							aria-hidden="true"
							class="absolute inset-0 -z-10 bg-[linear-gradient(155deg,rgb(17_17_17/.9),rgb(17_17_17/.84)_45%,rgb(17_17_17/.95))] transition-opacity duration-600 group-hover:opacity-90"
						/>

						<div class="flex flex-1 flex-col p-7 lg:p-8">
							<span class="font-serif text-[clamp(1.9rem,2.6vw,2.5rem)] leading-none font-normal text-academy-brass">
								{item.roman}
							</span>
							<h3 class="mt-4 font-serif text-[clamp(1.15rem,1.7vw,1.45rem)] leading-tight font-normal">
								{item.title}
							</h3>
							<p class="mt-4 border-t border-academy-paper/15 pt-4 text-[0.88rem] leading-relaxed font-light text-academy-paper/65">
								{item.text}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
