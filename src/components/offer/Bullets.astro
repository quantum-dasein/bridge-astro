---
/**
 * Простой нумерованный список без описаний: «что входит», «состав команды»,
 * «проблемы, которые мы решаем».
 *
 * Две колонки на широком экране — иначе десять коротких строк растягиваются
 * в узкую ленту через весь разворот.
 */

interface Props {
	id?: string;
	mark: string;
	title: string;
	lead?: string;
	dark?: boolean;
	items: readonly string[];
	moreLabel?: string;
	lessLabel?: string;
}

const {
	id,
	mark,
	title,
	lead,
	dark = false,
	items,
	moreLabel = 'Показать все',
	lessLabel = 'Свернуть',
} = Astro.props;

const section = dark
	? 'relative bg-academy-carbon text-academy-paper'
	: 'relative bg-academy-ground text-academy-ink';
const hair = dark ? 'border-academy-paper/20' : 'border-academy-ink/20';
const hairThin = dark ? 'border-academy-paper/12' : 'border-academy-ink/12';
const muted = dark ? 'text-academy-paper/55' : 'text-[#5F5B53]';
const bodyText = dark ? 'text-academy-paper/80' : 'text-[#4A453D]';
const numColor = dark ? 'text-academy-paper/35' : 'text-[#8E8A81]';
---

<section id={id} class={`${section} px-6 py-16 sm:px-10 lg:px-14 lg:py-28`}>
	<div class="mx-auto w-full max-w-[1400px]">
		<div class={`grid grid-cols-12 gap-y-4 border-t ${hair} pt-7 lg:gap-y-5 lg:pt-8`}>
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{mark}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[20ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.1] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			{
				lead && (
					<p
						class={`academy-reveal col-span-12 max-w-[44ch] text-[0.92rem] leading-relaxed font-light ${muted} lg:col-span-4 lg:col-start-9`}
					>
						{lead}
					</p>
				)
			}
		</div>

		<div data-collapse data-collapsed="330">
		<ul
			data-reveal-group
			data-collapse-body
			class="relative mt-8 grid overflow-hidden transition-[max-height] duration-700 ease-out lg:mt-14 lg:grid-cols-2 lg:gap-x-16"
		>
			{
				items.map((item, i) => (
					<li
						class={`group grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-x-4 border-t ${hairThin} py-3.5 text-[0.92rem] lg:py-4 lg:text-[0.95rem] leading-relaxed font-light ${bodyText}`}
					>
						<span class={`academy-mark ${numColor} transition-colors duration-300 group-hover:text-academy-brass`}>
							{String(i + 1).padStart(2, '0')}
						</span>
						<span>{item}</span>
					</li>
				))
			}
			<span
				data-collapse-fade
				aria-hidden="true"
				class={`pointer-events-none absolute inset-x-0 bottom-0 hidden h-16 ${dark ? 'bg-[linear-gradient(180deg,transparent,#111111)]' : 'bg-[linear-gradient(180deg,transparent,#F5F4F2)]'}`}
			></span>
		</ul>

		<button
			type="button"
			data-collapse-toggle
			data-more={moreLabel}
			data-less={lessLabel}
			aria-expanded="true"
			class={`academy-mark mt-4 hidden items-center gap-2.5 transition-colors duration-300 hover:text-academy-brass ${dark ? 'text-academy-paper/70' : 'text-academy-taupe-deep'}`}
		>
			<span data-collapse-label>{moreLabel}</span>
			<svg
				data-collapse-chevron
				class="h-3 w-3 transition-transform duration-500"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
			</svg>
		</button>
		</div>
	</div>
</section>
