---
/**
 * Границы ответственности — кто за что отвечает.
 *
 * В предложении это двухколоночная таблица. Здесь колонки разведены
 * вертикальной осью, как сравнение редакций в Академии: слева зона
 * BRIDGE Consult, справа зона Подрядчика. На телефоне колонки распадаются
 * в пары с подписями — иначе непонятно, где чья строка.
 */

interface Props {
	id?: string;
	mark: string;
	title: string;
	principle: string;
	colA: string;
	colB: string;
	rows: readonly { a: string; b: string }[];
	notes: readonly string[];
	moreLabel?: string;
	lessLabel?: string;
}

const {
	id,
	mark,
	title,
	principle,
	colA,
	colB,
	rows,
	notes,
	moreLabel = 'Читать дальше',
	lessLabel = 'Свернуть',
} = Astro.props;
---

<section id={id} class="relative bg-academy-ground px-6 py-16 sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-4 border-t border-academy-ink/20 pt-7 lg:gap-y-5 lg:pt-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{mark}</p>
			<h2
				class="academy-reveal-mask col-span-12 max-w-[18ch] font-serif text-[clamp(1.55rem,5.2vw,2.8rem)] leading-[1.1] font-normal tracking-[-0.025em] text-balance lg:col-span-5 lg:col-start-3"
			>
				{title}
			</h2>
			<p
				class="academy-reveal col-span-12 max-w-[46ch] border-l-2 border-academy-brass bg-academy-champagne/25 px-6 py-5 text-[0.92rem] leading-relaxed font-light text-[#4A453D] lg:col-span-4 lg:col-start-9"
			>
				{principle}
			</p>
		</div>

		<div class="relative mt-12">
			<span
				aria-hidden="true"
				class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-academy-ink/25 lg:block"
			></span>

			<div class="hidden grid-cols-[minmax(0,1fr)_2rem_minmax(0,1fr)] items-end gap-x-8 pb-5 lg:grid">
				<p class="text-right font-serif text-[clamp(1.15rem,1.7vw,1.5rem)] leading-tight font-normal text-academy-ink">
					{colA}
				</p>
				<span></span>
				<p class="font-serif text-[clamp(1.15rem,1.7vw,1.5rem)] leading-tight font-normal text-[#8B887F]">
					{colB}
				</p>
			</div>

			<div data-reveal-group>
				{
					rows.map((row) => (
						<div class="mb-3 grid gap-y-3 border-l-2 border-academy-brass/60 bg-academy-champagne/15 py-4 pr-4 pl-4 lg:mb-0 lg:grid-cols-[minmax(0,1fr)_2rem_minmax(0,1fr)] lg:gap-x-8 lg:border-l-0 lg:bg-transparent lg:p-0">
							<p class="max-w-[46ch] text-[0.88rem] leading-relaxed font-light text-academy-ink lg:justify-self-end lg:border-t lg:border-academy-ink/15 lg:py-6 lg:text-right lg:text-[0.9rem]">
								<span class="academy-mark mb-1 block text-academy-brass lg:hidden">{colA}</span>
								{row.a}
							</p>
							<span aria-hidden="true" class="hidden lg:block"></span>
							<p class="max-w-[46ch] border-t border-academy-ink/12 pt-3 text-[0.88rem] leading-relaxed font-light text-[#5F5B53] lg:border-academy-ink/15 lg:py-6 lg:pt-0 lg:text-[0.9rem]">
								<span class="academy-mark mb-1 block text-[#8E8A81] lg:hidden">{colB}</span>
								{row.b}
							</p>
						</div>
					))
				}
			</div>

			<div
				aria-hidden="true"
				class="hidden grid-cols-[minmax(0,1fr)_2rem_minmax(0,1fr)] gap-x-8 lg:grid"
			>
				<span class="border-t border-academy-ink/15"></span>
				<span></span>
				<span class="border-t border-academy-ink/15"></span>
			</div>
		</div>

		<div data-collapse data-collapsed="150" class="mt-10 lg:mt-12">
		<ul data-reveal-group data-collapse-body class="relative grid overflow-hidden transition-[max-height] duration-700 ease-out lg:grid-cols-2 lg:gap-x-16">
			{
				notes.map((n) => (
					<li class="grid grid-cols-[1.25rem_minmax(0,1fr)] items-baseline gap-x-3 border-t border-academy-ink/10 py-3.5 text-[0.82rem] leading-relaxed font-light text-[#5F5B53]">
						<span aria-hidden="true" class="text-academy-brass">
							—
						</span>
						<span>{n}</span>
					</li>
				))
			}
			<span
				data-collapse-fade
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-16 bg-[linear-gradient(180deg,transparent,#F5F4F2)]"
			></span>
		</ul>

		<button
			type="button"
			data-collapse-toggle
			data-more={moreLabel}
			data-less={lessLabel}
			aria-expanded="true"
			class="academy-mark mt-4 hidden items-center gap-2.5 text-academy-taupe-deep transition-colors duration-300 hover:text-academy-brass"
		>
			<span data-collapse-label>{moreLabel}</span>
			<svg
				data-collapse-chevron
				class="h-3 w-3 transition-transform duration-500"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
			</svg>
		</button>
		</div>
	</div>
</section>
