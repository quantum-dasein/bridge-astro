---
/**
 * Стоимость. Сумм здесь нет и быть не должно: предложение их не фиксирует,
 * а придумывать цифры на странице нельзя. Секция объясняет, от чего зависит
 * цена и какие три модели оплаты применяются.
 */

import { uiFor } from '../../data/ui';

interface Props {
	id?: string;
	mark: string;
	title: string;
	lead: string;
	models: readonly string[];
	/** Заголовок колонки. По умолчанию — подпись интерфейса на языке страницы. */
	modelsTitle?: string;
	modelsNote: string;
	note: string;
}

const { id, mark, title, lead, models, modelsTitle, modelsNote, note } = Astro.props;
const ui = uiFor(Astro.url.pathname);
---

<section id={id} class="relative bg-academy-carbon px-6 py-16 text-academy-paper sm:px-10 lg:px-14 lg:py-28">
	<div class="mx-auto w-full max-w-[1400px]">
		<div class="grid grid-cols-12 gap-y-8 border-t border-academy-paper/20 pt-8 lg:gap-x-8">
			<p class="academy-mark col-span-12 text-academy-brass lg:col-span-2">{mark}</p>

			<div class="col-span-12 lg:col-span-5 lg:col-start-3">
				<h2
					class="academy-reveal-mask max-w-[16ch] font-serif text-[clamp(1.6rem,5.4vw,3rem)] leading-[1.08] font-normal tracking-[-0.03em] text-balance"
				>
					{title}
				</h2>
				<p class="academy-reveal mt-6 max-w-[52ch] text-[0.92rem] leading-relaxed font-light text-academy-paper/60">
					{lead}
				</p>
			</div>

			<div class="col-span-12 lg:col-span-4 lg:col-start-9">
				<p class="academy-mark text-academy-paper/40">{modelsTitle ?? ui.paymentModels}</p>
				<ul data-reveal-group class="mt-4">
					{
						models.map((m, i) => (
							<li class="group grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-t border-academy-paper/12 py-4 text-[0.92rem] leading-relaxed font-light text-academy-paper/80">
								<span class="academy-mark text-academy-paper/35 transition-colors duration-300 group-hover:text-academy-brass">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span>{m}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-4 text-[0.86rem] font-light text-academy-brass">{modelsNote}</p>
			</div>
		</div>

		<p
			class="academy-reveal mt-12 max-w-[86ch] border-t border-academy-paper/15 pt-6 text-[0.9rem] leading-relaxed font-light text-academy-paper/55"
		>
			{note}
		</p>
	</div>
</section>
