---
// Telegram channel subscribe banner shown at the end of every news article.
interface Props { lang?: string }
const { lang = 'ru' } = Astro.props;

const t = {
	ru: {
		kicker: 'Telegram-канал',
		title: 'FIDIC Uzbekistan',
		sub: 'Экспертные материалы, кейсы и анонсы мероприятий по контрактам FIDIC в Центральной Азии — раньше, чем на сайте.',
		btn: 'Подписаться',
	},
	en: {
		kicker: 'Telegram channel',
		title: 'FIDIC Uzbekistan',
		sub: 'Expert materials, case studies and event announcements on FIDIC contracts in Central Asia — before they reach the site.',
		btn: 'Subscribe',
	},
	uz: {
		kicker: 'Telegram-kanal',
		title: 'FIDIC Uzbekistan',
		sub: "Markaziy Osiyoda FIDIC shartnomalari bo'yicha ekspert materiallari, keyslar va tadbirlar anonslari — saytdan ham oldin.",
		btn: 'Obuna bo‘lish',
	},
}[lang as 'ru' | 'en' | 'uz'] ?? { kicker: 'Telegram', title: 'FIDIC Uzbekistan', sub: '', btn: 'Подписаться' };
---

<a href="https://t.me/fidicuzb" target="_blank" rel="noopener noreferrer"
	class="group mt-10 flex flex-col items-start gap-5 overflow-hidden rounded-3xl border border-bridge-taupe/30 bg-bridge-taupe/10 p-7 transition-all duration-500 hover:border-bridge-taupe/70 hover:bg-bridge-taupe/20 hover:shadow-[0_0_40px_-12px_rgba(138,123,102,0.5)] sm:flex-row sm:items-center"
	data-aos="fade-up">
	<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-bridge-taupe/25">
		<svg class="h-7 w-7 text-bridge-taupe" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19s-.19-.02-.27 0c-.11.03-1.84 1.18-5.2 3.45-.49.33-.94.5-1.35.49-.45-.01-1.3-.25-1.94-.46-.78-.26-1.4-.4-1.34-.84.03-.23.36-.47.98-.72 3.85-1.68 6.42-2.78 7.71-3.32 3.67-1.53 4.43-1.8 4.93-1.81.11 0 .36.03.49.13.11.09.14.22.15.34.01.07.01.18 0 .22z"/></svg>
	</div>
	<div class="min-w-0 flex-1">
		<span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.28em] text-bridge-taupe">{t.kicker}</span>
		<p class="mb-1 text-lg font-bold text-bridge-dark">{t.title}</p>
		<p class="text-sm font-light leading-relaxed text-gray-500">{t.sub}</p>
	</div>
	<span class="inline-flex shrink-0 items-center gap-3 rounded-full bg-bridge-taupe px-7 py-3 text-[11px] font-bold uppercase tracking-[0.16em] text-white transition-all duration-300 group-hover:-translate-y-0.5 group-hover:bg-[#9c8d76]">
		{t.btn}
		<span class="h-px w-6 bg-white/70 transition-all duration-300 group-hover:w-10"></span>
	</span>
</a>
